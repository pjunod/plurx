{
  "schema_version": 3,
  "project": {
    "name": "plurx",
    "git_remote": "origin",
    "default_branch": "main",
    "branch_prefix": "agent",
    "quality_command": "make validate",
    "shared_prompt": "builtin:common",
    "project_prompt": "swarm/project.txt",
    "coordinator_role": "lead"
  },
  "requirements": {
    "executables": [
      "gh"
    ],
    "checks": [
      {
        "name": "gh auth",
        "command": [
          "gh",
          "auth",
          "status"
        ]
      }
    ]
  },
  "runtime": {
    "directory": ".swarm",
    "heartbeat_seconds": 30,
    "stuck_after_seconds": 900,
    "clone_root": ".."
  },
  "providers": {
    "codex": {
      "adapter": "command",
      "executable": "codex",
      "flags_env": "SWARM_CODEX_FLAGS",
      "default_flags": [],
      "arguments": [
        "exec",
        "-C",
        "{clone}",
        "--add-dir",
        "{control}/.swarm",
        "{prompt}"
      ],
      "model_arguments": [
        "exec",
        "-C",
        "{clone}",
        "--add-dir",
        "{control}/.swarm",
        "--model",
        "{model}",
        "{prompt}"
      ],
      "session_import_adapter": "codex-rollout"
    },
    "claude": {
      "adapter": "command",
      "executable": "claude",
      "unset_env": [
        "ANTHROPIC_API_KEY"
      ],
      "flags_env": "SWARM_CLAUDE_FLAGS",
      "default_flags": [],
      "arguments": [
        "-p",
        "--permission-mode",
        "auto",
        "{prompt}"
      ],
      "model_arguments": [
        "-p",
        "--permission-mode",
        "auto",
        "--model",
        "{model}",
        "{prompt}"
      ]
    },
    "local-ollama": {
      "adapter": "command",
      "executable": "codex",
      "flags_env": "SWARM_OLLAMA_FLAGS",
      "default_flags": [],
      "arguments": [
        "exec",
        "-C",
        "{clone}",
        "--add-dir",
        "{control}/.swarm",
        "--oss",
        "--local-provider",
        "ollama",
        "{prompt}"
      ],
      "model_arguments": [
        "exec",
        "-C",
        "{clone}",
        "--add-dir",
        "{control}/.swarm",
        "--oss",
        "--local-provider",
        "ollama",
        "--model",
        "{model}",
        "{prompt}"
      ],
      "session_import_adapter": null
    }
  },
  "queue": {
    "adapter": "github-issues",
    "require_merge_queue": false,
    "intake_label": "swarm:intake",
    "review_label": "swarm:review",
    "ready_label": "swarm:ready",
    "role_labels": {
      "lead": "swarm:lead",
      "builder": "swarm:builder",
      "reviewer": "swarm:reviewer"
    },
    "poll_seconds": 30,
    "retry_seconds": 120,
    "limit": 100,
    "pull_request_limit": 1000,
    "stagnant_after_seconds": 3600,
    "overdue_after_seconds": 14400,
    "reviewers": [
      {
        "provider": "claude",
        "model": "opus"
      },
      {
        "provider": "codex",
        "model": "gpt-5.6-sol"
      },
      {
        "provider": "codex",
        "model": "gpt-5.6-terra"
      }
    ],
    "reasoning_routes": {
      "deep": {
        "provider": "claude",
        "model": "fable"
      }
    }
  },
  "roles": {
    "lead": {
      "prompt": "swarm/lead.txt"
    },
    "builder": {
      "prompt": "swarm/builder.txt"
    },
    "reviewer": {
      "prompt": "swarm/reviewer.txt"
    }
  },
  "workers": {
    "lead": {
      "role": "lead",
      "provider": "claude",
      "model": "opus",
      "clone": "plurx-lead"
    },
    "builder-sol-1": {
      "role": "builder",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "clone": "plurx-builder-sol-1",
      "fallback_roles": [
        "reviewer"
      ]
    },
    "builder-sol-2": {
      "role": "builder",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "clone": "plurx-builder-sol-2",
      "fallback_roles": [
        "reviewer"
      ]
    },
    "builder-opus-1": {
      "role": "builder",
      "provider": "claude",
      "model": "opus",
      "clone": "plurx-builder-opus-1",
      "fallback_roles": [
        "reviewer"
      ]
    },
    "builder-opus-2": {
      "role": "builder",
      "provider": "claude",
      "model": "opus",
      "clone": "plurx-builder-opus-2",
      "fallback_roles": [
        "reviewer"
      ]
    },
    "reviewer-sol": {
      "role": "reviewer",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "clone": "plurx-reviewer-sol"
    },
    "reviewer-opus": {
      "role": "reviewer",
      "provider": "claude",
      "model": "opus",
      "clone": "plurx-reviewer-opus"
    },
    "core": {
      "role": "builder",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "clone": "plurx-core"
    }
  }
}
