[Unit]
Description=plurx media server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Create a dedicated user:  useradd --system --home /var/lib/plurx plurx
User=plurx
Group=plurx
ExecStart=/usr/local/bin/plurxd run
Environment=PLURX_DATA_DIR=/var/lib/plurx
Environment=PLURX_BIND=0.0.0.0:32400
# Point at a specific ffmpeg build if desired:
# Environment=PLURX_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg
# HLS master experiments for the copied-Dolby-Vision investigation
# (docs/APPLE-NATIVE-SUBTITLES-PLAN.md §5.4). Enable ONE per deploy, watch a
# real Apple TV, then decide — every master regression so far passed the unit
# tests and failed on the device, so the device is the only oracle.
# Environment=PLURX_HLS_CLOSED_CAPTIONS_NONE=1
# Environment=PLURX_HLS_FORCED_AUTOSELECT=1
Restart=on-failure
RestartSec=5
# Hardware transcode: give the service user the GPU render node. Uncomment and
# match your host's group (`stat -c '%G' /dev/dri/renderD128`, often `render`).
# SupplementaryGroups=render
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/plurx
ProtectHome=true
# Media usually lives under /home or /mnt; ProtectHome=true hides /home, so if
# your library is there, either move ReadOnlyPaths in or set ProtectHome=read-only.
# ReadOnlyPaths=/mnt/media

[Install]
WantedBy=multi-user.target
