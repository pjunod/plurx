#!/usr/bin/env node
/*
 * End-to-end playback matrix for plurx.
 *
 * Deliberately dependency-free: Node's built-in fetch + WebSocket drive the
 * real web player through Chrome/Edge DevTools or Safari/Firefox WebDriver.
 * See docs/PLAYBACK-TESTING.md for the contract and the limits.
 */
"use strict";

const fs = require("node:fs");
const fsp = fs.promises;
const crypto = require("node:crypto");
const http = require("node:http");
const net = require("node:net");
const os = require("node:os");
const path = require("node:path");
const { spawn, spawnSync } = require("node:child_process");

const ROOT = path.resolve(__dirname, "..");
const MANIFEST_PATH = path.join(ROOT, "tests", "playback", "cases.json");
const DEFAULT_FIXTURE_DIR = path.join(ROOT, "target", "playback-lab", "fixtures");
const DEFAULT_REPORT_DIR = path.join(ROOT, "target", "playback-lab", "reports");
const ELEMENT_KEY = "element-6066-11e4-a52e-4f735466cecf";

// How long the shaper waits, after the first presented frame, before it drops
// the link. Long enough that a healthy session has proven itself at the high
// rate, so a post-cliff failure is attributable to the cliff and not to a
// session that was never sustainable.
const DEFAULT_CLIFF_AFTER_SECONDS = 12;

// The named links. A profile is a descent: a rate that holds, then a lower
// rate that holds. Only what the plan's acceptance shape needs is named here;
// the parser below accepts the same grammar for one-off experiments.
const NETWORK_PROFILES = {
  "8mbps-to-1.5mbps": {
    description: "8 Mb/s holds, then a cliff to 1.5 Mb/s (PERF2-PLAN §7 acceptance)",
  },
};

function parseRate(text) {
  const match = /^(\d+(?:\.\d+)?)(kbps|mbps)$/.exec(String(text).trim().toLowerCase());
  if (!match) throw new Error(`rate "${text}" must look like 8mbps or 1500kbps`);
  const value = Number(match[1]);
  if (!Number.isFinite(value) || value <= 0) throw new Error(`rate "${text}" must be positive`);
  const kbps = match[2] === "mbps" ? value * 1000 : value;
  if (kbps < 1) throw new Error(`rate "${text}" is below the 1 kb/s floor`);
  return Math.round(kbps);
}

/**
 * `<high>-to-<lower>[-to-<lowest>...][@<seconds>]`, e.g.
 * `8mbps-to-1.5mbps` or `8mbps-to-1.1mbps-to-350kbps`.
 *
 * The descent is mandatory. A profile that rises, or holds flat, cannot make a
 * cliff, and silently accepting one would let a green stall-recovery run mean
 * nothing at all — the single most expensive failure this harness could have.
 */
function parseNetworkProfile(spec) {
  if (spec === undefined || spec === null || spec === false || spec === "" || spec === "none") {
    return null;
  }
  if (spec === true) throw new Error("--network-profile needs a value, e.g. 8mbps-to-1.5mbps");
  const raw = String(spec).trim().toLowerCase();
  const profileParts = raw.split("@");
  if (profileParts.length > 2) {
    throw new Error(`network profile "${spec}" has more than one cliff delay`);
  }
  const [shape, cliffText] = profileParts;
  const parts = shape.split("-to-");
  if (parts.length < 2) {
    const known = Object.keys(NETWORK_PROFILES).join(", ");
    throw new Error(`unknown network profile "${spec}"; known profiles: ${known}`);
  }
  const rates = parts.map(parseRate);
  for (let index = 1; index < rates.length; index += 1) {
    if (rates[index] >= rates[index - 1]) {
      throw new Error(
        `network profile "${spec}" must descend at every stage: `
        + `${rates[index]} kb/s is not below ${rates[index - 1]} kb/s`,
      );
    }
  }
  let cliffAfterSeconds = DEFAULT_CLIFF_AFTER_SECONDS;
  if (cliffText !== undefined) {
    cliffAfterSeconds = Number(cliffText);
    if (!Number.isFinite(cliffAfterSeconds) || cliffAfterSeconds <= 0) {
      throw new Error(`network profile "${spec}" needs a positive cliff delay in seconds`);
    }
  }
  const id = parts.join("-to-");
  return {
    id,
    spec: raw,
    description: NETWORK_PROFILES[id]?.description || `${rates.join(" → ")} kb/s`,
    cliff_after_seconds: cliffAfterSeconds,
    stages: rates.map((kbps, index) => ({
      index,
      label: index === 0 ? "before-cliff" : index === 1 ? "after-cliff" : `after-cliff-${index}`,
      kbps,
    })),
  };
}

function usage() {
  process.stdout.write(`plurx playback lab

Usage:
  scripts/playback-lab doctor [--browser chrome|safari|edge|firefox]
  scripts/playback-lab fixtures [--rebuild] [--fixtures DIR]
  scripts/playback-lab plan [--suite smoke|full|stall-recovery] [--case TEXT]
  scripts/playback-lab run [--suite smoke|full|stall-recovery]
                             [--browser chrome|safari|edge|firefox]
                             [--case TEXT] [--observe SECONDS]
                             [--network-profile NAME] [--json PATH] [--junit PATH]
                             [--fixtures DIR] [--server PATH]
                             [--chrome PATH] [--edge PATH]
                             [--firefox PATH] [--geckodriver PATH]
                             [--headed] [--keep-runtime]
  scripts/playback-lab normalize --json PATH [--out PATH]
  scripts/playback-lab device-proxy --target URL --listen HOST --public-host HOST
                              --network-profile PROFILE --control-file PATH
                              [--port PORT] [--auto-advance]
                              [--recovery-cliff-after SECONDS]
  scripts/playback-lab device-run --device UDID --target URL --public-host HOST
                              --file-id ID --network-profile PROFILE [--item-id ID]
                              [--height PIXELS] [--observe SECONDS] [--json PATH]

Commands:
  doctor     Verify the external programs and browser automation surface.
  fixtures   Generate and ffprobe-verify the deterministic media corpus.
  plan       Print the cases without starting a server or browser.
  run        Boot an isolated server, scan the corpus, and play every case.
  normalize  Scrub a report's run-local values so two runs can be compared.
  device-proxy  Shape a real server for remotely launched physical devices.
  device-run    Launch, shape, observe, and restore one physical Apple device.

The smoke suite covers each verdict plus the high-risk 4K transport forks and
seek/audio/subtitle restarts. The full suite adds every fixture x quality mode.
The stall-recovery suite drives a shaped link through a bandwidth cliff and
records how the session answers it.
Reports are written below target/playback-lab/reports/ as JSON and JUnit XML.

Network profiles (--network-profile), applied by a local loopback shaper:
${Object.keys(NETWORK_PROFILES).map((id) => `  ${id.padEnd(20)} ${NETWORK_PROFILES[id].description}`).join("\n")}
`);
}

function parseArgs(argv) {
  const command = argv[0] || "help";
  const options = {};
  for (let i = 1; i < argv.length; i += 1) {
    const raw = argv[i];
    if (!raw.startsWith("--")) throw new Error(`unexpected argument: ${raw}`);
    const eq = raw.indexOf("=");
    if (eq > 0) {
      options[raw.slice(2, eq).replaceAll("-", "_")] = raw.slice(eq + 1);
      continue;
    }
    const key = raw.slice(2).replaceAll("-", "_");
    const next = argv[i + 1];
    if (next !== undefined && !next.startsWith("--")) {
      options[key] = next;
      i += 1;
    } else {
      options[key] = true;
    }
  }
  return { command, options };
}

function loadManifest() {
  const manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, "utf8"));
  if (manifest.schema_version !== 1) {
    throw new Error(`unsupported playback manifest schema ${manifest.schema_version}`);
  }
  const ids = new Set();
  for (const fixture of manifest.fixtures || []) {
    if (!fixture.id || !fixture.filename || !fixture.builder) {
      throw new Error("each playback fixture needs id, filename, and builder");
    }
    if (ids.has(fixture.id)) throw new Error(`duplicate fixture id: ${fixture.id}`);
    ids.add(fixture.id);
  }
  return manifest;
}

function fixtureMap(manifest) {
  return new Map(manifest.fixtures.map((fixture) => [fixture.id, fixture]));
}

function caseName(testCase) {
  return `${testCase.fixture} :: ${testCase.quality} :: ${testCase.operation}`;
}

function expandCases(manifest, suiteName, filter) {
  const suite = manifest.suites[suiteName];
  if (!suite) throw new Error(`unknown suite ${suiteName}; choose smoke or full`);
  const fixtures = fixtureMap(manifest);
  const cases = [];
  if (suite.cross_product) {
    // "all" means the general corpus. An opt-in fixture exists for one named
    // suite and must not silently widen the full matrix.
    const fixtureIds = suite.cross_product.fixtures === "all"
      ? manifest.fixtures.filter((fixture) => !fixture.opt_in).map((fixture) => fixture.id)
      : suite.cross_product.fixtures;
    const qualities = suite.cross_product.qualities === "all"
      ? manifest.qualities
      : suite.cross_product.qualities;
    for (const fixture of fixtureIds) {
      for (const quality of qualities) {
        cases.push({ fixture, quality, operation: suite.cross_product.operation || "steady" });
      }
    }
  }
  cases.push(...(suite.cases || []));
  const seen = new Set();
  const selected = [];
  for (const testCase of cases) {
    if (!fixtures.has(testCase.fixture)) throw new Error(`case uses unknown fixture ${testCase.fixture}`);
    if (!manifest.qualities.includes(testCase.quality)) throw new Error(`case uses unknown quality ${testCase.quality}`);
    const name = caseName(testCase);
    if (seen.has(name)) continue;
    seen.add(name);
    if (filter && !name.toLowerCase().includes(String(filter).toLowerCase())) continue;
    selected.push({ ...testCase, name });
  }
  if (selected.length === 0) throw new Error(filter ? `no cases match ${filter}` : "suite has no cases");
  return selected;
}

function printPlan(manifest, suiteName, filter) {
  const fixtures = fixtureMap(manifest);
  const cases = expandCases(manifest, suiteName, filter);
  process.stdout.write(`Suite: ${suiteName} (${cases.length} cases)\n\n`);
  process.stdout.write(" #  fixture                          quality   operation\n");
  process.stdout.write("--  -------------------------------  --------  ---------------\n");
  cases.forEach((testCase, index) => {
    process.stdout.write(
      `${String(index + 1).padStart(2)}  ${testCase.fixture.padEnd(31)}  ` +
      `${testCase.quality.padEnd(8)}  ${testCase.operation}\n`,
    );
  });
  process.stdout.write("\nCorpus:\n");
  for (const fixture of manifest.fixtures) {
    process.stdout.write(`  ${fixture.id}: ${fixture.description}\n`);
  }
  process.stdout.write(`\nHow to read it: every case uses the shipped player. A verdict-path fallback,\n`);
  process.stdout.write(`media error, clock rate under ${manifest.thresholds.minimum_clock_rate.toFixed(2)}x, `);
  process.stdout.write(`more than ${manifest.thresholds.maximum_hitches} hitches, or any stall fails.\n`);
  return { fixtures, cases };
}

function commandExists(command, versionFlag = "--version") {
  const result = spawnSync(command, [versionFlag], { encoding: "utf8" });
  return result.status === 0;
}

function findOnPath(names) {
  for (const name of names) {
    const result = spawnSync("sh", ["-c", "command -v \"$1\"", "playback-lab", name], {
      encoding: "utf8",
    });
    if (result.status === 0 && result.stdout.trim()) return result.stdout.trim();
  }
  return null;
}

function findChrome(explicit) {
  if (explicit) {
    const candidate = path.resolve(explicit);
    return fs.existsSync(candidate) ? candidate : findOnPath([explicit]);
  }
  const candidates = [
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary",
    "/usr/bin/google-chrome",
    "/usr/bin/google-chrome-stable",
    "/usr/bin/chromium",
    "/usr/bin/chromium-browser",
  ];
  for (const candidate of candidates) if (fs.existsSync(candidate)) return candidate;
  return findOnPath(["google-chrome", "google-chrome-stable", "chromium", "chromium-browser"]);
}

function findEdge(explicit) {
  if (explicit) {
    const candidate = path.resolve(explicit);
    return fs.existsSync(candidate) ? candidate : findOnPath([explicit]);
  }
  const candidates = [
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
    "/Applications/Microsoft Edge Beta.app/Contents/MacOS/Microsoft Edge Beta",
    "/Applications/Microsoft Edge Dev.app/Contents/MacOS/Microsoft Edge Dev",
    "/Applications/Microsoft Edge Canary.app/Contents/MacOS/Microsoft Edge Canary",
    "/usr/bin/microsoft-edge",
    "/usr/bin/microsoft-edge-stable",
    "/usr/bin/microsoft-edge-beta",
    "/usr/bin/microsoft-edge-dev",
  ];
  for (const candidate of candidates) if (fs.existsSync(candidate)) return candidate;
  return findOnPath(["microsoft-edge", "microsoft-edge-stable", "microsoft-edge-beta", "microsoft-edge-dev"]);
}

function findFirefox(explicit) {
  if (explicit) {
    const candidate = path.resolve(explicit);
    return fs.existsSync(candidate) ? candidate : findOnPath([explicit]);
  }
  const candidates = [
    "/Applications/Firefox.app/Contents/MacOS/firefox",
    "/Applications/Firefox Developer Edition.app/Contents/MacOS/firefox",
    "/Applications/Firefox Nightly.app/Contents/MacOS/firefox",
    "/usr/bin/firefox",
    "/usr/bin/firefox-esr",
  ];
  for (const candidate of candidates) if (fs.existsSync(candidate)) return candidate;
  return findOnPath(["firefox", "firefox-esr"]);
}

function findGeckodriver(explicit) {
  if (explicit) {
    const candidate = path.resolve(explicit);
    return fs.existsSync(candidate) ? candidate : findOnPath([explicit]);
  }
  return findOnPath(["geckodriver"]);
}

function doctor(options) {
  const browser = options.browser || "chrome";
  const checks = [];
  const add = (name, ok, detail) => checks.push({ name, ok, detail });
  add("Node >= 22", Number(process.versions.node.split(".")[0]) >= 22, process.version);
  add("Node WebSocket", typeof WebSocket === "function", typeof WebSocket);
  add("ffmpeg", commandExists("ffmpeg", "-version"), findOnPath(["ffmpeg"]) || "not found");
  add("ffprobe", commandExists("ffprobe", "-version"), findOnPath(["ffprobe"]) || "not found");
  const encoders = spawnSync("ffmpeg", ["-hide_banner", "-encoders"], { encoding: "utf8" });
  const encoderText = `${encoders.stdout || ""}\n${encoders.stderr || ""}`;
  for (const encoder of ["libx264", "libx265", "libvpx-vp9", "aac", "ac3", "libopus", "libmp3lame"]) {
    add(`ffmpeg ${encoder}`, encoderText.includes(encoder), encoderText.includes(encoder) ? "available" : "missing");
  }
  const filters = spawnSync("ffmpeg", ["-hide_banner", "-filters"], { encoding: "utf8" });
  const filterText = `${filters.stdout || ""}\n${filters.stderr || ""}`;
  add("ffmpeg zscale", /\bzscale\b/.test(filterText), /\bzscale\b/.test(filterText) ? "available" : "missing (HDR tone-map cases will fail)");
  const server = path.resolve(options.server || path.join(ROOT, "target", "debug", "plurxd"));
  add("plurxd debug binary", fs.existsSync(server), fs.existsSync(server) ? server : `${server} (run cargo build -p plurxd)`);
  if (browser === "chrome") {
    const chrome = findChrome(options.chrome);
    add("Chrome", Boolean(chrome && fs.existsSync(chrome)), chrome || "not found");
  } else if (browser === "safari") {
    add("Safari WebDriver", fs.existsSync("/usr/bin/safaridriver"), "/usr/bin/safaridriver");
  } else if (browser === "edge") {
    const edge = findEdge(options.edge);
    add("Microsoft Edge", Boolean(edge && fs.existsSync(edge)), edge || "not found");
  } else if (browser === "firefox") {
    const firefox = findFirefox(options.firefox);
    const geckodriver = findGeckodriver(options.geckodriver);
    add("Firefox", Boolean(firefox && fs.existsSync(firefox)), firefox || "not found");
    add("Firefox WebDriver", Boolean(geckodriver && fs.existsSync(geckodriver)), geckodriver || "geckodriver not found on PATH");
  } else {
    add("browser", false, `unknown browser ${browser}`);
  }
  for (const check of checks) {
    process.stdout.write(`${check.ok ? "PASS" : "FAIL"}  ${check.name.padEnd(24)} ${check.detail}\n`);
  }
  if (browser === "safari") {
    process.stdout.write("\nSafari must have Develop > Allow Remote Automation enabled. If macOS has\n");
    process.stdout.write("not authorized it yet, run `safaridriver --enable` once yourself.\n");
  }
  if (checks.some((check) => !check.ok)) process.exitCode = 1;
}

function ffmpegPrefix() {
  return ["-hide_banner", "-loglevel", "error", "-nostdin", "-y"];
}

function fixtureCommand(fixture, output, directory, fixtures) {
  const seconds = fixture.builder === "hevc_hdr_open_gop_mkv" ? "18" : "24";
  switch (fixture.builder) {
    case "h264_aac_mp4":
      return [
        ...ffmpegPrefix(),
        "-f", "lavfi", "-i", `testsrc2=size=1920x1080:rate=24:duration=${seconds}`,
        "-f", "lavfi", "-i", `sine=frequency=440:sample_rate=48000:duration=${seconds}`,
        "-map", "0:v:0", "-map", "1:a:0",
        "-c:v", "libx264", "-preset", "veryfast", "-pix_fmt", "yuv420p",
        "-g", "48", "-keyint_min", "48", "-sc_threshold", "0", "-b:v", "8M",
        "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", "-shortest", output,
      ];
    case "h264_multitrack_mkv": { // video is copied so this case differs only where intended
      const source = path.join(directory, fixtures.get(fixture.depends_on).filename);
      const subtitle = path.join(directory, "playback-lab.srt");
      fs.writeFileSync(subtitle, "1\n00:00:01,000 --> 00:00:05,000\nplurx playback lab\n\n2\n00:00:08,000 --> 00:00:22,000\nsubtitle continuity check\n", "utf8");
      return [
        ...ffmpegPrefix(), "-i", source,
        "-f", "lavfi", "-i", `sine=frequency=440:sample_rate=48000:duration=${seconds}`,
        "-f", "lavfi", "-i", `sine=frequency=660:sample_rate=48000:duration=${seconds}`,
        "-f", "srt", "-i", subtitle,
        "-map", "0:v:0", "-map", "1:a:0", "-map", "2:a:0", "-map", "3:s:0",
        "-c:v", "copy", "-c:a:0", "aac", "-b:a:0", "192k",
        "-c:a:1", "ac3", "-b:a:1", "384k", "-c:s", "srt",
        "-metadata:s:a:0", "language=eng", "-metadata:s:a:0", "title=AAC baseline",
        "-metadata:s:a:1", "language=spa", "-metadata:s:a:1", "title=AC-3 alternate",
        "-metadata:s:s:0", "language=eng", "-metadata:s:s:0", "title=Text subtitles",
        "-disposition:a:0", "default", "-disposition:a:1", "0", "-shortest", output,
      ];
    }
    case "mpeg4_mp3_avi":
      return [
        ...ffmpegPrefix(),
        "-f", "lavfi", "-i", `testsrc2=size=1280x720:rate=30:duration=${seconds}`,
        "-f", "lavfi", "-i", `sine=frequency=330:sample_rate=48000:duration=${seconds}`,
        "-map", "0:v:0", "-map", "1:a:0", "-c:v", "mpeg4", "-q:v", "3",
        "-c:a", "libmp3lame", "-b:a", "192k", "-shortest", output,
      ];
    // Same forced-transcode shape as above, but long enough that a cliff at
    // 12 s still leaves a full recovery window — and rate-capped rather than
    // quality-capped so its size stays predictable.
    case "mpeg4_mp3_avi_long":
      return [
        ...ffmpegPrefix(),
        "-f", "lavfi", "-i", "testsrc2=size=1280x720:rate=30:duration=120",
        "-f", "lavfi", "-i", "sine=frequency=330:sample_rate=48000:duration=120",
        "-map", "0:v:0", "-map", "1:a:0", "-c:v", "mpeg4", "-b:v", "3M",
        "-c:a", "libmp3lame", "-b:a", "192k", "-shortest", output,
      ];
    case "vp9_opus_webm":
      return [
        ...ffmpegPrefix(),
        "-f", "lavfi", "-i", `testsrc2=size=1280x720:rate=24:duration=${seconds}`,
        "-f", "lavfi", "-i", `sine=frequency=550:sample_rate=48000:duration=${seconds}`,
        "-map", "0:v:0", "-map", "1:a:0", "-c:v", "libvpx-vp9",
        "-deadline", "realtime", "-cpu-used", "8", "-row-mt", "1", "-b:v", "3M",
        "-g", "96", "-c:a", "libopus", "-b:a", "160k", "-shortest", output,
      ];
    case "hevc_hdr_open_gop_mkv":
      return [
        ...ffmpegPrefix(),
        "-f", "lavfi", "-i", `testsrc2=size=3840x2160:rate=24000/1001:duration=${seconds}`,
        "-f", "lavfi", "-i", `sine=frequency=220:sample_rate=48000:duration=${seconds}`,
        "-map", "0:v:0", "-map", "1:a:0", "-c:v", "libx265", "-preset", "ultrafast",
        "-vf", "setparams=color_primaries=bt2020:color_trc=smpte2084:colorspace=bt2020nc",
        "-pix_fmt", "yuv420p10le", "-b:v", "48M", "-maxrate", "48M", "-bufsize", "96M",
        "-x265-params", "log-level=error:keyint=144:min-keyint=144:open-gop=1:scenecut=0:vbv-maxrate=48000:vbv-bufsize=96000:strict-cbr=1:filler=1:hrd=1:repeat-headers=1:hdr10=1:colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc",
        "-color_primaries", "bt2020", "-color_trc", "smpte2084", "-colorspace", "bt2020nc",
        "-c:a", "aac", "-b:a", "256k", "-shortest", output,
      ];
    default:
      throw new Error(`unknown fixture builder ${fixture.builder}`);
  }
}

function runProcess(command, args, options = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(command, args, {
      cwd: options.cwd || ROOT,
      env: options.env || process.env,
      stdio: ["ignore", options.quiet ? "pipe" : "inherit", "pipe"],
    });
    let stderr = "";
    let stdout = "";
    if (child.stderr) child.stderr.on("data", (chunk) => { stderr += chunk.toString(); if (!options.quiet) process.stderr.write(chunk); });
    if (options.quiet && child.stdout) child.stdout.on("data", (chunk) => { stdout += chunk.toString(); });
    child.on("error", reject);
    child.on("exit", (code, signal) => {
      if (code === 0) resolve({ code, stdout, stderr });
      else reject(new Error(`${command} exited ${code ?? signal}${stderr ? `: ${stderr.trim()}` : ""}`));
    });
  });
}

function ffprobe(file) {
  const result = spawnSync("ffprobe", [
    "-v", "error", "-show_format", "-show_streams", "-of", "json", file,
  ], { encoding: "utf8", maxBuffer: 16 * 1024 * 1024 });
  if (result.status !== 0) throw new Error(`ffprobe failed for ${file}: ${result.stderr.trim()}`);
  return JSON.parse(result.stdout);
}

function verifyFixture(fixture, file) {
  const probe = ffprobe(file);
  const video = probe.streams.find((stream) => stream.codec_type === "video");
  const audio = probe.streams.filter((stream) => stream.codec_type === "audio");
  const subtitles = probe.streams.filter((stream) => stream.codec_type === "subtitle");
  const failures = [];
  if (!video) failures.push("no video stream");
  const want = {
    h264_aac_mp4: { video: "h264", audio: ["aac"], width: 1920, height: 1080, minDuration: 20 },
    h264_multitrack_mkv: { video: "h264", audio: ["aac", "ac3"], subtitles: 1, width: 1920, height: 1080, minDuration: 20 },
    mpeg4_mp3_avi: { video: "mpeg4", audio: ["mp3"], width: 1280, height: 720, minDuration: 20 },
    mpeg4_mp3_avi_long: { video: "mpeg4", audio: ["mp3"], width: 1280, height: 720, minDuration: 110 },
    vp9_opus_webm: { video: "vp9", audio: ["opus"], width: 1280, height: 720, minDuration: 20 },
    hevc_hdr_open_gop_mkv: { video: "hevc", audio: ["aac"], width: 3840, height: 2160, hdr: true, minBitrate: 40_000_000, minDuration: 16 },
  }[fixture.builder];
  if (video && video.codec_name !== want.video) failures.push(`video codec ${video.codec_name}, want ${want.video}`);
  if (video && (video.width !== want.width || video.height !== want.height)) {
    failures.push(`dimensions ${video.width}x${video.height}, want ${want.width}x${want.height}`);
  }
  for (const codec of want.audio) if (!audio.some((stream) => stream.codec_name === codec)) failures.push(`missing ${codec} audio`);
  if (want.subtitles && subtitles.length < want.subtitles) failures.push(`subtitle streams ${subtitles.length}, want ${want.subtitles}`);
  if (want.hdr && video && video.color_transfer !== "smpte2084") failures.push(`transfer ${video.color_transfer || "none"}, want smpte2084`);
  const bitrate = Number(probe.format.bit_rate || video?.bit_rate || 0);
  const duration = Number(probe.format.duration || 0);
  if (want.minDuration && duration < want.minDuration) failures.push(`duration ${duration.toFixed(1)}s, want >= ${want.minDuration}s`);
  if (want.minBitrate && bitrate < want.minBitrate) failures.push(`bitrate ${(bitrate / 1e6).toFixed(1)} Mb/s, want >= ${(want.minBitrate / 1e6).toFixed(0)} Mb/s`);
  if (failures.length) throw new Error(`${fixture.id}: ${failures.join("; ")}`);
  return {
    codec: video.codec_name,
    dimensions: `${video.width}x${video.height}`,
    audio: audio.map((stream) => stream.codec_name),
    subtitles: subtitles.map((stream) => stream.codec_name),
    duration_seconds: duration,
    bitrate_mbps: Number((bitrate / 1e6).toFixed(1)),
    size_mb: Number((Number(probe.format.size || 0) / 1e6).toFixed(1)),
  };
}

/**
 * `wanted` restricts the build to the fixtures a plan actually uses, so an
 * opt-in corpus member costs nothing to the suites that never play it.
 */
async function buildFixtures(manifest, options, wanted) {
  const directory = path.resolve(options.fixtures || DEFAULT_FIXTURE_DIR);
  await fsp.mkdir(directory, { recursive: true });
  const fixtures = fixtureMap(manifest);
  const metadata = {};
  const selected = fixturesForBuild(manifest, wanted);
  for (const fixture of selected) {
    const output = path.join(directory, fixture.filename);
    let valid = false;
    if (!options.rebuild && fs.existsSync(output)) {
      try {
        metadata[fixture.id] = verifyFixture(fixture, output);
        valid = true;
      } catch (error) {
        process.stdout.write(`REBUILD ${fixture.id}: ${error.message}\n`);
      }
    }
    if (!valid) {
      process.stdout.write(`BUILD   ${fixture.id} — ${fixture.description}\n`);
      const args = fixtureCommand(fixture, output, directory, fixtures);
      await runProcess("ffmpeg", args, { quiet: true });
      metadata[fixture.id] = verifyFixture(fixture, output);
    }
    const item = metadata[fixture.id];
    process.stdout.write(
      `PASS    ${fixture.id}: ${item.codec} ${item.dimensions} · ` +
      `${item.bitrate_mbps} Mb/s · ${item.size_mb} MB\n`,
    );
  }
  return { directory, metadata };
}

function fixturesForBuild(manifest, wanted) {
  const needed = wanted ? new Set(wanted) : null;
  if (needed) {
    // A fixture built by copying another's video needs that other one present.
    for (const fixture of manifest.fixtures) {
      if (needed.has(fixture.id) && fixture.depends_on) needed.add(fixture.depends_on);
    }
  }
  return manifest.fixtures.filter((fixture) => needed ? needed.has(fixture.id) : !fixture.opt_in);
}

async function freePort() {
  return new Promise((resolve, reject) => {
    const server = net.createServer();
    server.unref();
    server.on("error", reject);
    server.listen(0, "127.0.0.1", () => {
      const port = server.address().port;
      server.close(() => resolve(port));
    });
  });
}

// A bucket wide enough to keep TCP moving, narrow enough that it cannot fund a
// post-cliff burst out of pre-cliff credit.
const SHAPER_BURST_MS = 250;
const SHAPER_SLICE_BYTES = 16 * 1024;
const SHAPER_TELEMETRY_WINDOW_MS = 1_000;

/**
 * The rate limiter, kept free of sockets and wall-clock so it can be tested
 * directly: every method takes the current millisecond from its caller.
 */
class TokenBucket {
  constructor(kbps, nowMs = 0) {
    this.tokens = 0;
    this.updatedAt = nowMs;
    this.bytesPerMs = 0;
    this.capacity = 0;
    this.setRate(kbps, nowMs);
  }

  setRate(kbps, nowMs) {
    if (!Number.isFinite(kbps) || kbps <= 0) throw new Error(`shaper rate must be positive, got ${kbps}`);
    this.refill(nowMs);
    this.kbps = kbps;
    this.bytesPerMs = kbps / 8; // kb/s ÷ 8 = bytes per millisecond
    this.capacity = this.bytesPerMs * SHAPER_BURST_MS;
    // Drop pre-cliff credit that the new, lower rate never earned.
    if (this.tokens > this.capacity) this.tokens = this.capacity;
  }

  refill(nowMs) {
    const elapsed = Math.max(0, nowMs - this.updatedAt);
    this.updatedAt = nowMs;
    this.tokens = Math.min(this.capacity, this.tokens + elapsed * this.bytesPerMs);
  }

  /**
   * Give back a claim the browser never received, and report the credit the
   * bucket actually took. A balance already at capacity absorbs less than the
   * full slice — or none of it — and the ledger that scores this bucket has to
   * record the mutation that happened rather than the one that was asked for.
   */
  refund(bytes, nowMs) {
    this.refill(nowMs);
    const credited = Math.max(0, Math.min(bytes, this.capacity - this.tokens));
    this.tokens += credited;
    return credited;
  }

  /**
   * Claim `bytes` now and return how long the caller must wait first. Debt is
   * allowed to go negative and is repaid by time, which is what makes the
   * long-run average exactly the configured rate instead of merely near it.
   */
  reserve(bytes, nowMs) {
    this.refill(nowMs);
    this.tokens -= bytes;
    return this.delay(nowMs);
  }

  delay(nowMs) {
    this.refill(nowMs);
    return this.tokens < 0 ? -this.tokens / this.bytesPerMs : 0;
  }
}

// Bytes that are the stream itself, as opposed to the app shell and control
// plane. Recorded separately so a report can say whether the shaped budget was
// actually spent on media supply.
function isMediaPath(urlPath) {
  const route = String(urlPath || "").split("?")[0];
  return /\/hls\//.test(route)
    || /\/stream\.mp4$/.test(route)
    || /\/files\/\d+\/direct$/.test(route)
    || /\/offline\/media\//.test(route)
    || /\.(m3u8|ts|m4s|mp4)$/.test(route);
}

// Proxy diagnostics name the route, never its query. Media requests carry the
// isolated lab bearer token in `?token=...`; even an ephemeral credential has
// no place in a retained artifact.
function diagnosticPath(urlPath) {
  return String(urlPath || "").split(/[?#]/)[0] || "/";
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

/** A byte count over a millisecond window, in kb/s, at the reporting quantum. */
function spanRateKbps(bytes, spanMs) {
  if (bytes === null || !Number.isFinite(spanMs) || spanMs <= 0) return null;
  return Number(((bytes * 8) / spanMs).toFixed(1));
}

/**
 * The widest `SHAPER_TELEMETRY_WINDOW_MS` rate over a byte series ordered by
 * time. Entries may be negative — the admission ledger withdraws a refunded
 * slice — so the running sum is signed and the peak floors at zero.
 */
function rollingPeakKbps(samples, mediaOnly) {
  if (!samples.length) return null;
  let first = 0;
  let bytes = 0;
  let peak = 0;
  for (let last = 0; last < samples.length; last += 1) {
    if (!mediaOnly || samples[last].media) bytes += samples[last].bytes;
    const cutoff = samples[last].at_ms - SHAPER_TELEMETRY_WINDOW_MS;
    while (samples[first]?.at_ms < cutoff) {
      if (!mediaOnly || samples[first].media) bytes -= samples[first].bytes;
      first += 1;
    }
    peak = Math.max(peak, bytes * 8 / SHAPER_TELEMETRY_WINDOW_MS);
  }
  return Number(peak.toFixed(1));
}

/**
 * A loopback reverse proxy that meters everything the browser pulls through one
 * shared bucket. It is deliberately not an OS-level shaper: no root, no
 * kernel state to leak into the next run, no machine-wide blast radius, and the
 * cliff is a function call the report can timestamp.
 */
class ShapingProxy {
  constructor(profile, targetOrigin, options = {}) {
    this.profile = profile;
    this.target = new URL(targetOrigin);
    this.listenHost = options.listenHost || "127.0.0.1";
    this.listenPort = options.listenPort === undefined ? 0 : Number(options.listenPort);
    this.publicHost = options.publicHost || this.listenHost;
    this.controlToken = options.controlToken || null;
    this.autoAdvance = Boolean(options.autoAdvance);
    this.recoveryCliffAfterSeconds = Number(options.recoveryCliffAfterSeconds || 8);
    if (!Number.isInteger(this.listenPort) || this.listenPort < 0 || this.listenPort > 65535) {
      throw new Error(`shaper listen port must be an integer from 0 to 65535, got ${options.listenPort}`);
    }
    if ((this.listenHost === "0.0.0.0" || this.listenHost === "::")
        && (!options.publicHost || options.publicHost === true)) {
      throw new Error("a wildcard shaper bind requires --public-host for physical-device URLs");
    }
    if (!Number.isFinite(this.recoveryCliffAfterSeconds) || this.recoveryCliffAfterSeconds <= 0) {
      throw new Error("--recovery-cliff-after must be a positive number of seconds");
    }
    this.stageIndex = 0;
    this.bucket = new TokenBucket(profile.stages[0].kbps, performance.now());
    this.agent = new http.Agent({ keepAlive: true, maxSockets: 32 });
    this.errors = [];
    this.closed = false;
    this.limiterTail = Promise.resolve();
    this.limiterWaiters = new Set();
    this.frozenTelemetry = null;
    this.clientEvents = [];
    this.transitions = [];
    this.advanceTimer = null;
    this.scheduledAdvance = null;
    this.deliverySamples = profile.stages.map(() => []);
    this.admissionSamples = profile.stages.map(() => []);
    // Claims priced by the bucket but not yet delivered or refunded. Held by
    // identity, not as a count, so the evidence seam below can exempt exactly
    // the slices that crossed it instead of a blanket per-socket allowance.
    this.pendingClaims = new Set();
    this.evidencePendingBytes = 0;
    this.carriedOverBytes = 0;
    this.evidenceRefundedClaimBytes = 0;
    // Admission the bucket still retains for claims canceled after the evidence
    // reset. It remains part of the bucket-conservation proof, but it cannot
    // authorize delivery because the named claim never reached the browser.
    this.undeliveredAdmittedBytes = 0;
    this.stages = profile.stages.map((stage) => ({
      index: stage.index,
      label: stage.label,
      kbps: stage.kbps,
      entered_at_ms: null,
      left_at_ms: null,
      first_byte_at_ms: null,
      last_byte_at_ms: null,
      bytes: 0,
      media_bytes: 0,
    }));
  }

  now() {
    return performance.now();
  }

  async start(binder) {
    const bind = binder || ((server) => new Promise((resolve, reject) => {
      server.once("error", reject);
      server.listen(this.listenPort, this.listenHost, () => resolve(server.address().port));
    }));
    this.server = http.createServer((request, response) => this.handle(request, response));
    this.server.keepAliveTimeout = 30_000;
    try {
      this.port = await bind(this.server);
    } catch (error) {
      throw new Error(`network shaping is unavailable: ${error.message}`);
    }
    if (!this.port) throw new Error("network shaping is unavailable: the shaper bound no port");
    this.startedAt = this.now();
    this.stages[0].entered_at_ms = 0;
    const publicHost = this.publicHost.includes(":") && !this.publicHost.startsWith("[")
      ? `[${this.publicHost}]`
      : this.publicHost;
    this.baseUrl = `http://${publicHost}:${this.port}`;
    return this.baseUrl;
  }

  /** Start stage-zero evidence after the browser has presented its first frame. */
  beginEvidence() {
    const stage = this.stages[this.stageIndex];
    const at = this.now() - this.startedAt;
    stage.entered_at_ms = at;
    stage.left_at_ms = null;
    stage.first_byte_at_ms = null;
    stage.last_byte_at_ms = null;
    stage.bytes = 0;
    stage.media_bytes = 0;
    this.deliverySamples[this.stageIndex] = [];
    this.admissionSamples[this.stageIndex] = [];
    // Clearing the ledger opens a seam: a slice the bucket already priced can
    // be delivered after the reset with its claim left in the discarded series.
    // Snapshot exactly which claims are outstanding at this instant so the
    // delivery gate can exempt those completions and nothing else. Marking the
    // claims themselves — rather than trusting a `max_sockets x slice_bytes`
    // ceiling — keeps an unclaimed byte unexempt even when it is the only one.
    this.evidencePendingBytes = 0;
    this.carriedOverBytes = 0;
    this.evidenceRefundedClaimBytes = 0;
    this.undeliveredAdmittedBytes = 0;
    for (const claim of this.pendingClaims) {
      claim.crossedEvidenceSeam = true;
      this.evidencePendingBytes += claim.bytes;
    }
  }

  /** Drop the link to the next stage. Called once, at a point the report keeps. */
  applyCliff(reason = "manual") {
    if (this.stageIndex + 1 >= this.stages.length) return null;
    const at = this.now() - this.startedAt;
    this.stages[this.stageIndex].left_at_ms = at;
    this.stageIndex += 1;
    const stage = this.stages[this.stageIndex];
    stage.entered_at_ms = at;
    this.bucket.setRate(stage.kbps, this.now());
    this.wakeLimiter();
    this.transitions.push({
      at_ms: Number(at.toFixed(3)),
      reason,
      stage_index: stage.index,
      kbps: stage.kbps,
    });
    this.scheduledAdvance = null;
    if (this.advanceTimer) clearTimeout(this.advanceTimer);
    this.advanceTimer = null;
    return at;
  }

  scheduleAdvance(delaySeconds, reason) {
    if (this.stageIndex + 1 >= this.stages.length || this.advanceTimer) return false;
    const delayMs = Math.round(delaySeconds * 1000);
    this.scheduledAdvance = {
      reason,
      stage_index: this.stageIndex + 1,
      kbps: this.stages[this.stageIndex + 1].kbps,
      due_at: new Date(Date.now() + delayMs).toISOString(),
    };
    this.advanceTimer = setTimeout(() => {
      this.advanceTimer = null;
      this.applyCliff(reason);
    }, delayMs);
    return true;
  }

  captureClientLog(payload) {
    if (!payload || typeof payload !== "object" || Array.isArray(payload)) return;
    const allowed = [
      "level", "event", "message", "method", "title", "file_id", "vcodec", "detail", "ms",
      "height", "encoder", "session_id", "attempt", "reason", "snapshot", "ua",
    ];
    const captured = { captured_at: new Date().toISOString() };
    for (const key of allowed) {
      if (payload[key] !== undefined) captured[key] = payload[key];
    }
    this.clientEvents.push(captured);
    if (this.clientEvents.length > 500) this.clientEvents.splice(0, this.clientEvents.length - 500);
    if (!this.autoAdvance || payload.event !== "ttff") return;
    if (this.stageIndex === 0) {
      this.scheduleAdvance(this.profile.cliff_after_seconds, "initial-ttff");
    } else if (String(payload.reason || "").startsWith("stall-")) {
      this.scheduleAdvance(this.recoveryCliffAfterSeconds, "recovery-ttff");
    }
  }

  controlSnapshot() {
    return {
      schema_version: 1,
      generated_at: new Date().toISOString(),
      target: this.target.origin,
      proxy: this.baseUrl,
      current_stage: this.stageIndex,
      current_kbps: this.stages[this.stageIndex].kbps,
      scheduled_advance: this.scheduledAdvance,
      transitions: this.transitions,
      shaping: this.telemetry(),
      client_events: this.clientEvents,
    };
  }

  writeJson(response, status, value) {
    const body = `${JSON.stringify(value, null, 2)}\n`;
    response.writeHead(status, {
      "content-type": "application/json",
      "content-length": Buffer.byteLength(body),
      "cache-control": "no-store",
    });
    response.end(body);
  }

  handleControl(request, response, route) {
    if (!this.controlToken || request.headers["x-playback-lab-control"] !== this.controlToken) {
      this.writeJson(response, 403, { error: "valid playback-lab control token required" });
      return;
    }
    if (request.method === "GET" && route === "/__playback_lab/status") {
      this.writeJson(response, 200, this.controlSnapshot());
      return;
    }
    if (request.method === "POST" && route === "/__playback_lab/cliff") {
      const appliedAt = this.applyCliff("control-api");
      this.writeJson(response, appliedAt === null ? 409 : 200, {
        applied_at_ms: appliedAt,
        current_stage: this.stageIndex,
        current_kbps: this.stages[this.stageIndex].kbps,
      });
      return;
    }
    if (request.method === "POST" && route === "/__playback_lab/evidence") {
      this.writeJson(response, 200, this.controlSnapshot());
      return;
    }
    this.writeJson(response, 404, { error: "unknown playback-lab control route" });
  }

  observeClientLog(request) {
    let bytes = 0;
    const chunks = [];
    request.on("data", (chunk) => {
      bytes += chunk.length;
      if (bytes <= 256 * 1024) chunks.push(chunk);
    });
    request.on("end", () => {
      if (bytes > 256 * 1024) return;
      try {
        this.captureClientLog(JSON.parse(Buffer.concat(chunks).toString("utf8")));
      } catch (_) {
        // The upstream remains authoritative for malformed client logs. The
        // evidence tap is deliberately observational and never changes them.
      }
    });
  }

  /**
   * The bucket's own outflow ledger: `+bytes` at the instant a reservation
   * claims them, `-bytes` when a canceled write refunds them. Signed, because
   * the rolling bound this feeds is the bucket's token-conservation identity —
   * the net bytes taken out of a bucket over a window cannot exceed the credit
   * it held when the window opened plus what the window earned. Refunds cancel
   * out of that identity only if the ledger records them the same way the
   * bucket does.
   *
   * Delivery timestamps cannot carry that proof. A slice is priced when it is
   * claimed but recorded only after its own connection drains, and drains are
   * deliberately per-connection, so any number of separately priced slices can
   * land together. Metering the claim keeps the measured event and the bound
   * describing the same thing.
   *
   * `at` is the clock reading the bucket itself used, not a later sample of it,
   * and the entry is filed against the stage current at that instant. Both keep
   * the ledger and the bucket from disagreeing across a cliff.
   */
  meterAdmission(bytes, media, at = this.now()) {
    this.admissionSamples[this.stageIndex].push({ at_ms: at - this.startedAt, bytes, media });
    // The claim stays outstanding until its slice is delivered or refunded. It
    // is the provenance the delivery gate needs: an exemption is granted to a
    // completion only when it can name the claim it belongs to.
    const claim = { media, bytes, crossedEvidenceSeam: false };
    this.pendingClaims.add(claim);
    return claim;
  }

  /**
   * Retire a claim without delivering it. The bytes never reach the exemption,
   * so a canceled pre-seam reservation cannot widen the delivery allowance.
   */
  settleClaim(claim) {
    if (claim) this.pendingClaims.delete(claim);
  }

  /**
   * Withdraw credit the bucket gave back, against the stage that received it.
   *
   * There is one bucket, so a refund always credits whichever stage is live
   * when it happens — never the stage that made the original claim. Filing the
   * withdrawal against the claiming stage would hand the post-cliff bucket
   * spendable credit that the post-cliff ledger never saw, and the later claims
   * that credit funds would then look like bytes the bucket could not have
   * released. `bytes` is what the bucket actually took back, which is less than
   * the slice whenever the balance was already near capacity.
   */
  meterRefund(bytes, media, at = this.now(), claim = null) {
    const credited = claim ? Math.max(0, Math.min(bytes, claim.bytes)) : 0;
    // `beginEvidence` discards the positive entry for an outstanding claim. If
    // that exact claim is canceled afterwards, its negative refund survives in
    // the new ledger and needs the same measured seam reconciliation as a
    // completion. Record only the credit the bucket actually accepted; this is
    // neither the claim's nominal size nor a blanket delivery allowance.
    if (claim?.crossedEvidenceSeam && this.pendingClaims.has(claim)) {
      this.evidenceRefundedClaimBytes += credited;
    } else if (claim && this.pendingClaims.has(claim)) {
      // A post-reset claim is present in the retained admission ledger. If the
      // bucket is already full, some or all of its canceled reservation cannot
      // be credited back and therefore stays in that conservation series. Name
      // exactly that remainder so it cannot authorize unrelated delivery.
      this.undeliveredAdmittedBytes += claim.bytes - credited;
    }
    if (bytes <= 0) return;
    this.admissionSamples[this.stageIndex].push({ at_ms: at - this.startedAt, bytes: -bytes, media });
  }

  record(bytes, media, claim = null) {
    // A completion is exempt from the delivery gate only when it carries the
    // identity of a claim that was already outstanding when `beginEvidence`
    // discarded the ledger holding it. Crediting the claim's own bytes — once,
    // and only on delivery — bounds the allowance by what actually crossed the
    // seam instead of by how many sockets the proxy may open.
    if (claim?.crossedEvidenceSeam && this.pendingClaims.has(claim)) {
      this.carriedOverBytes += Math.min(bytes, claim.bytes);
    }
    this.settleClaim(claim);
    // What the browser received, billed to the stage current at completion.
    // Reservations are priced when they are claimed and recorded only once
    // their own connection drains, so this series says when bytes landed, not
    // when the link released them: at a cliff every still-draining slice
    // crosses into the next stage, and slices held by separate connections can
    // land together in any order. Byte totals survive that regrouping and rates
    // do not, so delivery is scored only as a total, against the ledger below.
    const stage = this.stages[this.stageIndex];
    const at = this.now() - this.startedAt;
    if (stage.first_byte_at_ms === null) stage.first_byte_at_ms = at;
    stage.last_byte_at_ms = at;
    stage.bytes += bytes;
    if (media) stage.media_bytes += bytes;
    this.deliverySamples[this.stageIndex].push({ at_ms: at, bytes, media });
  }

  handle(request, response) {
    const route = diagnosticPath(request.url);
    if (route.startsWith("/__playback_lab/")) {
      this.handleControl(request, response, route);
      return;
    }
    if (request.method === "POST" && route === "/api/v1/client-log" && this.controlToken) {
      this.observeClientLog(request);
    }
    const media = isMediaPath(request.url);
    const transfer = { cancelled: false, upstreamResponse: null };
    const cancel = () => {
      // `close` also fires after a successful response. Only an unfinished
      // downstream is a browser cancellation, which is normal when the player
      // replaces a rung/session during recovery.
      if (response.writableFinished || transfer.cancelled) return;
      transfer.cancelled = true;
      this.wakeLimiter();
      transfer.upstreamResponse?.destroy();
      upstream.destroy();
    };
    const upstream = http.request({
      agent: this.agent,
      host: this.target.hostname,
      port: this.target.port,
      path: request.url,
      method: request.method,
      headers: { ...request.headers, host: this.target.host },
    }, (upstreamResponse) => {
      transfer.upstreamResponse = upstreamResponse;
      if (transfer.cancelled) {
        upstreamResponse.destroy();
        return;
      }
      response.writeHead(upstreamResponse.statusCode, upstreamResponse.headers);
      this.pump(upstreamResponse, response, media, () => transfer.cancelled).catch((error) => {
        if (!this.closed && !transfer.cancelled) {
          this.errors.push(`${request.method} ${route}: ${error.message}`);
        }
        upstreamResponse.destroy();
        response.destroy();
      }).finally(() => {
        request.off("aborted", cancel);
        response.off("close", cancel);
      });
    });
    upstream.on("error", (error) => {
      if (transfer.cancelled || this.closed) return;
      this.errors.push(`${request.method} ${route}: ${error.message}`);
      if (!response.headersSent) response.writeHead(502, { "content-type": "text/plain" });
      response.end("playback-lab shaper: upstream error");
    });
    request.once("aborted", cancel);
    response.once("close", cancel);
    request.on("error", cancel);
    request.pipe(upstream);
  }

  /**
   * Serialize reservations across every connection. A token bucket is shared
   * state, but independent sleeps are not a shared scheduler: requests queued
   * before the cliff would otherwise retain their high-rate timers and burst
   * through the low-rate stage. `applyCliff` wakes the one active reservation,
   * which recomputes its remaining debt at the new rate.
   */
  async writeShaped(slice, sink, media, cancelled) {
    let admission = null;
    let committed = false;
    const reservation = this.limiterTail.then(() => this.reserveSlice(slice.length, media, cancelled));
    this.limiterTail = reservation.catch(() => {});
    try {
      admission = await reservation;
      if (this.closed) throw new Error("shaper closed");
      if (cancelled() || sink.destroyed || !sink.writable) {
        throw new Error("client cancelled the transfer");
      }
      if (!sink.write(slice)) await this.waitForDrain(sink, cancelled);
      // The downstream has taken the slice: either the write was accepted
      // outright or `drain` reported the buffer emptied behind it. That is the
      // commit point, and it is deliberately reached before the cancellation
      // check below. A close landing between `drain` and this continuation
      // resuming used to refund the reservation and drop the delivery, so the
      // bucket got back credit it had already spent on bytes the socket
      // accepted and the artifact showed neither — the limiter could then
      // release the same bytes a second time and still score clean. A
      // reservation the client abandons *before* the downstream takes it is
      // the genuinely refundable case, and `waitForDrain` still rejects there.
      committed = true;
      this.record(slice.length, media, admission);
      if (cancelled() || sink.destroyed) throw new Error("client cancelled the transfer");
    } finally {
      // A restart canceled *before* the downstream write must not leave debt in
      // the shared link or meter a slice the browser never received. The next
      // rendition gets only the credit genuinely earned while the canceled
      // reservation was waiting. `committed` is set at the write, so this path
      // can only be reached by a reservation that never reached the socket.
      if (admission && !committed) {
        if (!this.closed) {
          const at = this.now();
          this.meterRefund(this.bucket.refund(slice.length, at), admission.media, at, admission);
          this.wakeLimiter();
        }
        this.settleClaim(admission);
      }
    }
  }

  async reserveSlice(bytes, media, cancelled) {
    let admission = null;
    try {
      if (this.closed) throw new Error("shaper closed");
      if (cancelled()) throw new Error("client cancelled the transfer");
      const at = this.now();
      let delay = this.bucket.reserve(bytes, at);
      // Meter the claim at the instant the bucket loses the bytes, using the
      // clock reading the bucket itself used and the stage current at that
      // instant. Metering the later grant instead would file a slice priced at
      // the pre-cliff rate against the post-cliff stage.
      admission = this.meterAdmission(bytes, media, at);
      while (delay > 0) {
        await this.waitForLimiter(delay);
        if (this.closed) throw new Error("shaper closed");
        if (cancelled()) throw new Error("client cancelled the transfer");
        delay = this.bucket.delay(this.now());
      }
      return admission;
    } catch (error) {
      if (admission) {
        if (!this.closed) {
          const at = this.now();
          this.meterRefund(this.bucket.refund(bytes, at), admission.media, at, admission);
          this.wakeLimiter();
        }
        this.settleClaim(admission);
      }
      throw error;
    }
  }

  waitForDrain(sink, cancelled) {
    return new Promise((resolve, reject) => {
      const done = (error) => {
        sink.off("drain", onDrain);
        sink.off("close", onClose);
        error ? reject(error) : resolve();
      };
      const onDrain = () => done();
      const onClose = () => done(new Error("client cancelled the transfer"));
      if (cancelled() || sink.destroyed) return done(new Error("client cancelled the transfer"));
      sink.once("drain", onDrain);
      sink.once("close", onClose);
    });
  }

  waitForLimiter(delay) {
    return new Promise((resolve) => {
      let timer;
      const wake = () => {
        clearTimeout(timer);
        this.limiterWaiters.delete(wake);
        resolve();
      };
      timer = setTimeout(wake, delay);
      this.limiterWaiters.add(wake);
    });
  }

  wakeLimiter() {
    for (const wake of [...this.limiterWaiters]) wake();
  }

  async pump(source, sink, media, cancelled) {
    try {
      for await (const chunk of source) {
        for (let offset = 0; offset < chunk.length; offset += SHAPER_SLICE_BYTES) {
          const slice = chunk.subarray(offset, offset + SHAPER_SLICE_BYTES);
          await this.writeShaped(slice, sink, media, cancelled);
        }
      }
      if (!cancelled()) sink.end();
    } catch (error) {
      if (cancelled()) return;
      sink.destroy();
      throw error;
    }
  }

  /**
   * What the link released and what it delivered, per stage. The scored
   * quantities are the ledger's — `admitted_bytes` over `admitted_span_ms`, and
   * the rolling `admitted_peak_kbps` — because only those have a bound the
   * bucket's design can prove. The delivered rates are reported beside them
   * because they are what a viewer would have felt.
   */
  telemetrySnapshot() {
    const endedAt = this.now() - this.startedAt;
    return {
      profile: this.profile.id,
      spec: this.profile.spec,
      cliff_after_seconds: this.profile.cliff_after_seconds,
      cliff_applied_at_ms: this.stages[1] ? this.stages[1].entered_at_ms : null,
      // The constants the scored bounds are built from, so an artifact can be
      // rechecked without the script that produced it. `max_sockets` is
      // reported for context only; no scored bound is derived from it any more.
      slice_bytes: SHAPER_SLICE_BYTES,
      max_sockets: this.agent.maxSockets,
      // The measured evidence seam. `evidence_pending_claim_bytes` is what the
      // bucket had priced but not yet delivered when `beginEvidence` discarded
      // the ledger; `carried_over_bytes` is how much of that was actually
      // delivered afterwards. A marked claim refunded after the reset instead
      // contributes the actual credit accepted by the bucket to
      // `evidence_refunded_claim_bytes`, reconciling the retained negative
      // ledger entry with its discarded positive entry. The two settlements
      // are mutually exclusive and retain the provenance of every adjustment.
      evidence_pending_claim_bytes: this.evidencePendingBytes,
      carried_over_bytes: this.carriedOverBytes,
      evidence_refunded_claim_bytes: this.evidenceRefundedClaimBytes,
      // A canceled post-evidence claim may receive only a partial refund (or no
      // refund) when the bucket has refilled to capacity. Its uncredited bytes
      // correctly remain in the conservation ledger, but this separate total
      // removes them from the delivery authorization because they never landed.
      undelivered_admitted_bytes: this.undeliveredAdmittedBytes,
      transport_errors: this.errors.slice(-10),
      stages: this.stages.map((stage) => {
        const left = stage.left_at_ms === null ? endedAt : stage.left_at_ms;
        // Browser preparation before the first byte and player idle after the
        // last byte are not transfer time. Keeping both out of the rate window
        // prevents either dead interval from hiding a shaper leak.
        const activeStart = stage.first_byte_at_ms;
        const activeEnd = stage.last_byte_at_ms === null ? null : Math.min(left, stage.last_byte_at_ms);
        const activeSeconds = activeStart === null || activeEnd === null
          ? 0
          : Math.max(0, activeEnd - activeStart) / 1000;
        const samples = this.deliverySamples[stage.index];
        // `record` runs after a reserved slice reaches the downstream socket.
        // The first-to-last sample interval therefore contains N - 1 slice
        // waits while the byte count contains N slices. Add the first slice's
        // cap-time to keep the estimate unbiased without admitting browser
        // preparation or trailing player idle into the window. That correction
        // is exact when delivery holds the configured cap; it cannot make this
        // an unbiased estimate when drains group, which is why the rate below
        // is reported and the ledger is what gets scored.
        const firstSliceSeconds = samples.length
          ? (samples[0].bytes * 8) / (stage.kbps * 1000)
          : 0;
        const measuredSeconds = samples.length ? activeSeconds + firstSliceSeconds : 0;
        const ledger = this.admissionSamples[stage.index];
        // The window the ledger's own identity is stated over: it opens on the
        // first mutation of the bucket inside this stage and closes on the last.
        const admittedSpanMs = ledger.length
          ? Number((ledger[ledger.length - 1].at_ms - ledger[0].at_ms).toFixed(3))
          : null;
        const admittedBytes = ledger.length
          ? ledger.reduce((total, entry) => total + entry.bytes, 0)
          : null;
        return {
          ...stage,
          held_seconds: Number(activeSeconds.toFixed(3)),
          measured_kbps: measuredSeconds > 0
            ? Number(((stage.bytes * 8) / 1000 / measuredSeconds).toFixed(1))
            : null,
          measured_media_kbps: measuredSeconds > 0
            ? Number(((stage.media_bytes * 8) / 1000 / measuredSeconds).toFixed(1))
            : null,
          // What the browser received. Reported because it is what a viewer
          // would have felt, but deliberately not scored: per-connection drains
          // can group separately-priced slices, so neither of these rates has a
          // bound the shaper's design can prove.
          peak_kbps: rollingPeakKbps(samples, false),
          peak_media_kbps: rollingPeakKbps(samples, true),
          // What the bucket let out, net of refunds. These are the scored
          // quantities, and the window each is scored over travels with it.
          admitted_bytes: admittedBytes,
          admitted_span_ms: admittedSpanMs,
          admitted_kbps: spanRateKbps(admittedBytes, admittedSpanMs),
          admitted_peak_kbps: rollingPeakKbps(ledger, false),
        };
      }),
    };
  }

  telemetry() {
    return this.frozenTelemetry || this.telemetrySnapshot();
  }

  freezeTelemetry() {
    if (!this.frozenTelemetry) this.frozenTelemetry = this.telemetrySnapshot();
    return this.frozenTelemetry;
  }

  async close() {
    this.freezeTelemetry();
    this.closed = true;
    if (this.advanceTimer) clearTimeout(this.advanceTimer);
    this.advanceTimer = null;
    this.scheduledAdvance = null;
    this.wakeLimiter();
    this.agent.destroy();
    if (!this.server) return;
    const closed = new Promise((resolve) => this.server.close(resolve));
    this.server.closeAllConnections?.();
    await closed;
  }
}

async function stopChild(child, graceMs = 5_000) {
  if (!child || child.exitCode !== null || child.signalCode !== null) return;
  const exited = new Promise((resolve) => child.once("exit", resolve));
  child.kill("SIGTERM");
  const graceful = await Promise.race([
    exited.then(() => true),
    new Promise((resolve) => setTimeout(() => resolve(false), graceMs)),
  ]);
  if (graceful || child.exitCode !== null || child.signalCode !== null) return;
  child.kill("SIGKILL");
  await Promise.race([exited, new Promise((resolve) => setTimeout(resolve, 2_000))]);
}

function tomlString(value) {
  return JSON.stringify(String(value));
}

async function waitFor(check, timeoutMs, label, intervalMs = 250) {
  const deadline = Date.now() + timeoutMs;
  let lastError = null;
  while (Date.now() < deadline) {
    try {
      const value = await check();
      if (value) return value;
    } catch (error) {
      lastError = error;
    }
    await new Promise((resolve) => setTimeout(resolve, intervalMs));
  }
  throw new Error(`timed out waiting for ${label}${lastError ? `: ${lastError.message}` : ""}`);
}

async function api(baseUrl, route, { token, method = "GET", body, timeout = 30_000 } = {}) {
  const headers = {};
  if (token) headers.authorization = `Bearer ${token}`;
  if (body !== undefined) headers["content-type"] = "application/json";
  const response = await fetch(`${baseUrl}/api/v1${route}`, {
    method,
    headers,
    body: body === undefined ? undefined : JSON.stringify(body),
    signal: AbortSignal.timeout(timeout),
  });
  const text = await response.text();
  let value = null;
  if (text) {
    try { value = JSON.parse(text); } catch (_) { value = text; }
  }
  if (!response.ok) {
    const message = value && typeof value === "object" ? value.error : text;
    throw new Error(`${method} ${route} -> ${response.status}${message ? `: ${message}` : ""}`);
  }
  return value;
}

async function startServer(options, fixtureDirectory) {
  const port = await freePort();
  const runtime = await fsp.mkdtemp(path.join(os.tmpdir(), "plurx-playback-lab-"));
  const logFile = path.join(runtime, "plurxd.log");
  let log = null;
  let child = null;
  try {
  const dataDir = path.join(runtime, "data");
  await fsp.mkdir(dataDir, { recursive: true });
  const baseUrl = `http://127.0.0.1:${port}`;
  const config = path.join(runtime, "plurx.toml");
  await fsp.writeFile(config,
    `[server]\nname = "plurx playback lab"\nbind = "127.0.0.1:${port}"\n\n` +
    `[storage]\ndata_dir = ${tomlString(dataDir)}\n`, "utf8");
  const serverBin = path.resolve(options.server || path.join(ROOT, "target", "debug", "plurxd"));
  if (!fs.existsSync(serverBin)) {
    if (options.server) throw new Error(`server binary does not exist: ${serverBin}`);
    process.stdout.write("BUILD   plurxd debug binary\n");
    await runProcess("cargo", ["build", "-p", "plurxd"], { quiet: false });
  }
  log = fs.createWriteStream(logFile, { flags: "a" });
  child = spawn(serverBin, ["--config", config, "run"], {
    cwd: ROOT,
    env: { ...process.env, PLURX_LOG: options.server_log || "info" },
    stdio: ["ignore", "pipe", "pipe"],
  });
  child.stdout.pipe(log);
  child.stderr.pipe(log);
  let exited = null;
  child.on("exit", (code, signal) => { exited = { code, signal }; });
  child.on("error", (error) => { exited = { error }; });
  await waitFor(async () => {
    if (exited) throw exited.error || new Error(`plurxd exited ${exited.code ?? exited.signal}`);
    const response = await fetch(`${baseUrl}/healthz`, { signal: AbortSignal.timeout(1000) });
    return response.ok;
  }, 60_000, "plurxd health");
  const setup = await api(baseUrl, "/setup", {
    method: "POST",
    body: { username: "playback-lab", password: "playback-lab" },
  });
  const token = setup.token;
  const library = await api(baseUrl, "/libraries", {
    token,
    method: "POST",
    body: { name: "Playback lab", kind: "home", paths: [fixtureDirectory], anime: false },
  });
  await waitFor(async () => {
    const statuses = await api(baseUrl, "/scan/status", { token });
    const status = statuses[String(library.id)];
    return status && !status.running && status.last_scan ? status : null;
  }, 180_000, "fixture scan", 500);
  const items = await api(baseUrl, `/libraries/${library.id}/items?limit=200&sort=title`, { token });
  const files = new Map();
  for (const item of items.items) {
    const detail = await api(baseUrl, `/items/${item.id}`, { token });
    for (const file of detail.files || []) files.set(file.filename, { ...file, item_id: item.id, title: item.title });
  }
  return {
    runtime, dataDir, baseUrl, token, library, files, child, log, logFile,
    async close(keep) {
      await stopChild(child, 12_000);
      log.end();
      if (keep) process.stdout.write(`KEEP    runtime ${runtime}\n`);
      else await fsp.rm(runtime, { recursive: true, force: true });
    },
  };
  } catch (error) {
    await stopChild(child, 2_000);
    if (log) log.end();
    const tail = fs.existsSync(logFile) ? fs.readFileSync(logFile, "utf8").slice(-4000) : "";
    if (options.keep_runtime) process.stdout.write(`KEEP    failed runtime ${runtime}\n`);
    else await fsp.rm(runtime, { recursive: true, force: true });
    throw new Error(`${error.message}${tail ? `\n${tail}` : ""}`);
  }
}

class CdpDriver {
  constructor(options, baseUrl, runtime, browserName) {
    this.options = options;
    this.baseUrl = baseUrl;
    this.runtime = runtime;
    this.browserName = browserName;
    this.pending = new Map();
    this.nextId = 1;
  }

  async start() {
    const executable = this.browserName === "edge"
      ? findEdge(this.options.edge)
      : findChrome(this.options.chrome);
    if (!executable) {
      const label = this.browserName === "edge" ? "Microsoft Edge" : "Chrome";
      throw new Error(`${label} not found; run doctor or pass --${this.browserName} PATH`);
    }
    const profile = path.join(this.runtime, `${this.browserName}-profile`);
    await fsp.mkdir(profile, { recursive: true });
    const args = [
      this.options.headed ? "" : "--headless=new",
      "--remote-debugging-port=0",
      `--user-data-dir=${profile}`,
      "--no-first-run",
      "--no-default-browser-check",
      "--autoplay-policy=no-user-gesture-required",
      "--disable-background-timer-throttling",
      "--disable-backgrounding-occluded-windows",
      "--disable-renderer-backgrounding",
      "--disable-features=Translate,MediaRouter",
      this.baseUrl,
    ].filter(Boolean);
    const logPath = path.join(this.runtime, "browser.log");
    this.log = fs.createWriteStream(logPath, { flags: "a" });
    this.child = spawn(executable, args, { stdio: ["ignore", "pipe", "pipe"] });
    this.child.stdout.pipe(this.log);
    let stderr = "";
    this.child.stderr.on("data", (chunk) => {
      stderr += chunk.toString();
      this.log.write(chunk);
    });
    let exited = null;
    this.child.on("exit", (code, signal) => { exited = { code, signal }; });
    this.child.on("error", (error) => { exited = { error }; });
    const devtools = await waitFor(async () => {
      if (exited) throw exited.error || new Error(`browser exited ${exited.code ?? exited.signal}`);
      const match = stderr.match(/DevTools listening on (ws:\/\/[^\s]+)/);
      return match ? match[1] : null;
    }, 30_000, `${this.browserName} DevTools`, 100);
    const parsed = new URL(devtools);
    const jsonBase = `http://${parsed.host}`;
    const target = await waitFor(async () => {
      const response = await fetch(`${jsonBase}/json/list`, { signal: AbortSignal.timeout(1000) });
      const targets = await response.json();
      return targets.find((candidate) => candidate.type === "page") || null;
    }, 10_000, `${this.browserName} page target`);
    this.ws = new WebSocket(target.webSocketDebuggerUrl);
    await new Promise((resolve, reject) => {
      this.ws.addEventListener("open", resolve, { once: true });
      this.ws.addEventListener("error", reject, { once: true });
    });
    this.ws.addEventListener("message", (event) => {
      const message = JSON.parse(event.data);
      if (!message.id || !this.pending.has(message.id)) return;
      const pending = this.pending.get(message.id);
      this.pending.delete(message.id);
      if (message.error) pending.reject(new Error(message.error.message));
      else pending.resolve(message.result);
    });
    await this.send("Runtime.enable");
    await this.send("Page.enable");
    await this.send("Page.navigate", { url: this.baseUrl });
    await waitFor(() => this.eval("document.readyState === 'complete'"), 20_000, "web app load");
  }

  send(method, params = {}) {
    return new Promise((resolve, reject) => {
      const id = this.nextId++;
      const timer = setTimeout(() => {
        this.pending.delete(id);
        reject(new Error(`CDP ${method} timed out`));
      }, 60_000);
      this.pending.set(id, {
        resolve: (value) => { clearTimeout(timer); resolve(value); },
        reject: (error) => { clearTimeout(timer); reject(error); },
      });
      this.ws.send(JSON.stringify({ id, method, params }));
    });
  }

  async eval(expression) {
    const result = await this.send("Runtime.evaluate", {
      expression,
      awaitPromise: true,
      returnByValue: true,
    });
    if (result.exceptionDetails) {
      const detail = result.exceptionDetails.exception?.description || result.exceptionDetails.text;
      throw new Error(`browser evaluation failed: ${detail}`);
    }
    return result.result.value;
  }

  exec(script) {
    return this.eval(`(async()=>{${script}})()`);
  }

  async reload() {
    await this.send("Page.reload", { ignoreCache: true });
    await waitFor(() => this.eval("document.readyState === 'complete'"), 20_000, "web app reload");
  }

  async startPlayback(fileId, title, durationMs) {
    await this.exec(`play(${Number(fileId)}, ${JSON.stringify(title)}, 0, ${Number(durationMs || 0)}, null); return true;`);
  }

  async close() {
    try {
      if (this.ws && this.ws.readyState === WebSocket.OPEN) {
        this.ws.send(JSON.stringify({ id: this.nextId++, method: "Browser.close", params: {} }));
        await new Promise((resolve) => setTimeout(resolve, 250));
      }
    } catch (_) {}
    try { if (this.ws) this.ws.close(); } catch (_) {}
    await stopChild(this.child);
    if (this.log) this.log.end();
  }
}

class SafariDriver {
  constructor(options, baseUrl, runtime) {
    this.options = options;
    this.baseUrl = baseUrl;
    this.runtime = runtime;
  }

  async wd(method, route, body) {
    const response = await fetch(`http://127.0.0.1:${this.port}${route}`, {
      method,
      headers: body === undefined ? {} : { "content-type": "application/json" },
      body: body === undefined ? undefined : JSON.stringify(body),
      signal: AbortSignal.timeout(70_000),
    });
    const value = await response.json().catch(() => ({}));
    if (!response.ok || value.value?.error) {
      const error = value.value?.message || value.value?.error || `HTTP ${response.status}`;
      throw new Error(`Safari WebDriver ${method} ${route}: ${error}`);
    }
    return value.value;
  }

  async start() {
    if (!fs.existsSync("/usr/bin/safaridriver")) throw new Error("/usr/bin/safaridriver not found");
    this.port = await freePort();
    const logPath = path.join(this.runtime, "browser.log");
    this.log = fs.createWriteStream(logPath, { flags: "a" });
    this.child = spawn("/usr/bin/safaridriver", ["--port", String(this.port)], { stdio: ["ignore", "pipe", "pipe"] });
    this.child.stdout.pipe(this.log);
    this.child.stderr.pipe(this.log);
    await waitFor(async () => {
      try { await this.wd("GET", "/status"); return true; } catch (_) { return false; }
    }, 15_000, "Safari WebDriver");
    const session = await this.wd("POST", "/session", {
      capabilities: { alwaysMatch: { browserName: "safari", acceptInsecureCerts: true } },
    });
    this.sessionId = session.sessionId || session.capabilities?.sessionId;
    if (!this.sessionId) throw new Error("Safari WebDriver returned no session id");
    await this.wd("POST", `/session/${this.sessionId}/timeouts`, { script: 60_000, pageLoad: 60_000 });
    await this.wd("POST", `/session/${this.sessionId}/url`, { url: this.baseUrl });
    await waitFor(() => this.eval("document.readyState === 'complete'"), 20_000, "Safari web app load");
  }

  exec(script, args = []) {
    return this.wd("POST", `/session/${this.sessionId}/execute/sync`, { script, args });
  }

  eval(expression) {
    return this.exec(`return (${expression});`);
  }

  async reload() {
    await this.wd("POST", `/session/${this.sessionId}/refresh`, {});
    await waitFor(() => this.eval("document.readyState === 'complete'"), 20_000, "Safari web app reload");
  }

  async startPlayback(fileId, title, durationMs) {
    await this.exec(`
      var old=document.getElementById('plurx-lab-start'); if(old) old.remove();
      var button=document.createElement('button'); button.id='plurx-lab-start';
      button.textContent='Start playback test';
      button.style='position:fixed;z-index:99999;left:20px;top:20px;width:220px;height:80px';
      button.onclick=function(){ play(arguments[0], arguments[1], 0, arguments[2], null); button.remove(); }.bind(null, arguments[0], arguments[1], arguments[2]);
      document.body.appendChild(button); return true;
    `, [Number(fileId), String(title), Number(durationMs || 0)]);
    const element = await this.wd("POST", `/session/${this.sessionId}/element`, { using: "css selector", value: "#plurx-lab-start" });
    const elementId = element[ELEMENT_KEY] || element.ELEMENT;
    await this.wd("POST", `/session/${this.sessionId}/element/${elementId}/click`, {});
  }

  async close() {
    try { if (this.sessionId) await this.wd("DELETE", `/session/${this.sessionId}`); } catch (_) {}
    await stopChild(this.child);
    if (this.log) this.log.end();
  }
}

class FirefoxDriver {
  constructor(options, baseUrl, runtime) {
    this.options = options;
    this.baseUrl = baseUrl;
    this.runtime = runtime;
  }

  async wd(method, route, body) {
    const response = await fetch(`http://127.0.0.1:${this.port}${route}`, {
      method,
      headers: body === undefined ? {} : { "content-type": "application/json" },
      body: body === undefined ? undefined : JSON.stringify(body),
      signal: AbortSignal.timeout(70_000),
    });
    const value = await response.json().catch(() => ({}));
    if (!response.ok || value.value?.error) {
      const error = value.value?.message || value.value?.error || `HTTP ${response.status}`;
      throw new Error(`Firefox WebDriver ${method} ${route}: ${error}`);
    }
    return value.value;
  }

  async start() {
    const firefox = findFirefox(this.options.firefox);
    const geckodriver = findGeckodriver(this.options.geckodriver);
    if (!firefox) throw new Error("Firefox not found; run doctor or pass --firefox PATH");
    if (!geckodriver) throw new Error("geckodriver not found; install it on PATH or pass --geckodriver PATH");
    this.port = await freePort();
    const logPath = path.join(this.runtime, "browser.log");
    this.log = fs.createWriteStream(logPath, { flags: "a" });
    this.child = spawn(geckodriver, ["--port", String(this.port)], { stdio: ["ignore", "pipe", "pipe"] });
    this.child.stdout.pipe(this.log);
    this.child.stderr.pipe(this.log);
    await waitFor(async () => {
      try { await this.wd("GET", "/status"); return true; } catch (_) { return false; }
    }, 15_000, "Firefox WebDriver");
    const firefoxOptions = { binary: firefox };
    if (!this.options.headed) firefoxOptions.args = ["-headless"];
    const session = await this.wd("POST", "/session", {
      capabilities: {
        alwaysMatch: {
          browserName: "firefox",
          acceptInsecureCerts: true,
          "moz:firefoxOptions": firefoxOptions,
        },
      },
    });
    this.sessionId = session.sessionId || session.capabilities?.sessionId;
    if (!this.sessionId) throw new Error("Firefox WebDriver returned no session id");
    await this.wd("POST", `/session/${this.sessionId}/timeouts`, { script: 60_000, pageLoad: 60_000 });
    await this.wd("POST", `/session/${this.sessionId}/url`, { url: this.baseUrl });
    await waitFor(() => this.eval("document.readyState === 'complete'"), 20_000, "Firefox web app load");
  }

  exec(script, args = []) {
    return this.wd("POST", `/session/${this.sessionId}/execute/sync`, { script, args });
  }

  eval(expression) {
    return this.exec(`return (${expression});`);
  }

  async reload() {
    await this.wd("POST", `/session/${this.sessionId}/refresh`, {});
    await waitFor(() => this.eval("document.readyState === 'complete'"), 20_000, "Firefox web app reload");
  }

  async startPlayback(fileId, title, durationMs) {
    await this.exec(`
      var old=document.getElementById('plurx-lab-start'); if(old) old.remove();
      var button=document.createElement('button'); button.id='plurx-lab-start';
      button.textContent='Start playback test';
      button.style='position:fixed;z-index:99999;left:20px;top:20px;width:220px;height:80px';
      button.onclick=function(){ play(arguments[0], arguments[1], 0, arguments[2], null); button.remove(); }.bind(null, arguments[0], arguments[1], arguments[2]);
      document.body.appendChild(button); return true;
    `, [Number(fileId), String(title), Number(durationMs || 0)]);
    const element = await this.wd("POST", `/session/${this.sessionId}/element`, { using: "css selector", value: "#plurx-lab-start" });
    const elementId = element[ELEMENT_KEY] || element.ELEMENT;
    await this.wd("POST", `/session/${this.sessionId}/element/${elementId}/click`, {});
  }

  async close() {
    try { if (this.sessionId) await this.wd("DELETE", `/session/${this.sessionId}`); } catch (_) {}
    await stopChild(this.child);
    if (this.log) this.log.end();
  }
}

function qualityForce(quality) {
  if (quality === "auto") return "auto";
  if (quality === "original" || quality === "nomse") return "original";
  return "transcode";
}

function playerSnapshotExpression() {
  return `(()=>{
    const p=(typeof PLAYER!=='undefined'&&PLAYER)||{};
    const playerObject=(typeof PLAYER!=='undefined'&&PLAYER)||null;
    const labPlayers=globalThis.__plurxLabPlayerObjects||
      (globalThis.__plurxLabPlayerObjects={next:0,ids:new WeakMap()});
    let playerGeneration=null;
    if(playerObject){
      if(!labPlayers.ids.has(playerObject)) labPlayers.ids.set(playerObject,++labPlayers.next);
      playerGeneration=labPlayers.ids.get(playerObject);
    }
    const v=document.getElementById('video');
    const h=p.hitches||{};
    const q=(()=>{try{return v&&v.getVideoPlaybackQuality?v.getVideoPlaybackQuality():null}catch(e){return null}})();
    const mediaError=v&&v.error?{code:v.error.code,message:v.error.message||null}:null;
    return {
      file_id:p.fileId||null, started:!!p.started, decided_method:p.decidedMethod||null,
      method:p.method||null, copy_hls:!!p.copyHls, tried_fallback:!!p.triedFallback,
      encoder:p.encoder||null, vod:!!p.vod, attempt_id:p.attemptId||null,
      attempt_reason:p.attemptReason||null, player_generation:playerGeneration,
      play_started_at:p.playStartedAt==null?null:p.playStartedAt,
      offset:Number(p.offset||0),
      ttff_ms:p.ttffMs==null?null:p.ttffMs, stalls:p.stalls||0,
      stalls_by_kind:p.stallsByKind||{supply:0,decode:0}, buffer_limits:p.bufferLimits||{},
      stall_recoveries:p.stallRecoveries||0, recovering_stall:p.recoveringStall||null,
      hitches:{back:h.back||0,held:h.held||0,late:h.late||0,drop:h.drop||0,gap:h.gap||0,slow:h.slow||0,rate:h.rate==null?null:h.rate},
      decode:p.decodeInfo||null, health:p.health||null,
      source:p.source||null, audio_count:(p.audio||[]).length, subtitle_count:(p.subs||[]).length,
      current_audio:p.curAudio==null?null:p.curAudio, current_subtitle:p.curSub==null?null:p.curSub,
      media_events:(globalThis.__plurxLabMediaEvents||[]).slice(-30),
      video:{current_time:v?Number((v.currentTime||0).toFixed(3)):0,
        absolute_time:v?Number(((p.offset||0)+(v.currentTime||0)).toFixed(3)):Number(p.offset||0),
        duration:v&&isFinite(v.duration)?v.duration:null,
        paused:v?!!v.paused:true,seeking:v?!!v.seeking:false,ended:v?!!v.ended:false,ready_state:v?v.readyState:0,
        width:v?v.videoWidth:0,height:v?v.videoHeight:0,playback_rate:v?v.playbackRate:0,
        runway:v&&typeof bufferRunway==='function'?bufferRunway(v):0,error:mediaError,
        dropped:q?q.droppedVideoFrames:null,total:q?q.totalVideoFrames:null}
    };
  })()`;
}

async function prepareBrowser(driver, token) {
  await driver.exec(`
    localStorage.setItem('plurx_token', ${JSON.stringify(token)});
    localStorage.setItem('plurx_autonext', '0');
    localStorage.setItem('plurx_autoskip', '0');
    localStorage.removeItem('plurx_decode_limits');
    return true;
  `);
  await driver.reload();
  await waitFor(() => driver.eval("typeof play === 'function' && typeof CAPS_Q === 'string'"), 30_000, "player code");
  return driver.eval(`({browser:browserLabel(),user_agent:navigator.userAgent,caps:PLAY_CAPS,caps_q:CAPS_Q,
    native_hls:useNativeHls(document.getElementById('video')),mse:!!(window.MediaSource&&window.Hls&&Hls.isSupported())})`);
}

async function setCasePreferences(driver, quality) {
  await driver.exec(`
    try{closePlayer()}catch(e){}
    globalThis.__plurxLabMediaEvents=[];
    { const v=document.getElementById('video');
      if(v&&!v.__plurxLabEvents){
        v.__plurxLabEvents=true;
        for(const event of ['play','playing','pause','waiting','stalled','suspend','ended','abort','emptied'])
          v.addEventListener(event,()=>{
            const p=(typeof PLAYER!=='undefined'&&PLAYER)||{};
            globalThis.__plurxLabMediaEvents.push({event,at_ms:Math.round(performance.now()),
              attempt:p.attemptReason||null,attempt_id:p.attemptId||null,
              current_time:Number((v.currentTime||0).toFixed(3)),
              paused:!!v.paused,ended:!!v.ended,seeking:!!v.seeking,
              ready_state:v.readyState,network_state:v.networkState});
          });
      }
    }
    localStorage.setItem('plurx_quality', ${JSON.stringify(quality)});
    localStorage.setItem('plurx_autonext', '0');
    localStorage.setItem('plurx_autoskip', '0');
    localStorage.removeItem('plurx_decode_limits');
    return true;
  `);
}

async function performOperation(driver, testCase, start) {
  if (testCase.operation === "steady") return null;
  if (testCase.operation === "seek") {
    const duration = Number(start.source?.duration_ms || 0) / 1000;
    const target = Math.max(5, Math.min(duration > 0 ? duration - 5 : 10, duration > 0 ? duration * 0.45 : 10));
    await driver.exec(`seekTo(${target}); return true;`);
    await waitFor(async () => {
      const state = await driver.eval(playerSnapshotExpression());
      return state.video.error || (state.started && !state.video.seeking && state.video.ready_state >= 2 &&
        state.video.current_time > 0.1 && state.video.absolute_time >= target - 0.25) ? state : null;
    }, 30_000, `seek to ${target.toFixed(1)}s`);
    return { target_seconds: target };
  }
  if (testCase.operation === "audio-switch") {
    if (start.audio_count < 2) throw new Error("fixture has fewer than two audio tracks");
    await driver.exec("switchAudio(1); return true;");
    await waitFor(async () => {
      const state = await driver.eval(playerSnapshotExpression());
      return state.video.error || (state.current_audio === 1 && state.attempt_reason === "audio" &&
        state.started && state.video.ready_state >= 2 && state.video.current_time > 0.1) ? state : null;
    }, 30_000, "alternate audio playback");
    return { audio_index: 1 };
  }
  if (testCase.operation === "subtitle-toggle") {
    if (start.subtitle_count < 1) throw new Error("fixture has no subtitle track");
    await driver.exec("setSub(0); return true;");
    await waitFor(async () => {
      const state = await driver.eval(playerSnapshotExpression());
      const showing = await driver.eval(`(()=>{const v=document.getElementById('video');return [...(v?v.textTracks:[])].some(t=>t.mode==='showing')})()`);
      return state.current_subtitle === 0 && showing ? state : null;
    }, 15_000, "text subtitle display");
    return { subtitle_index: 0 };
  }
  throw new Error(`unknown operation ${testCase.operation}`);
}

function hitchTotal(snapshot) {
  const h = snapshot.hitches || {};
  return (h.back || 0) + (h.held || 0) + (h.late || 0) + (h.drop || 0) + (h.gap || 0);
}

/** One row of the timeline: everything a later rung decision could need. */
function sampleFrom(snapshot, atMs) {
  return {
    at_ms: Math.round(atMs),
    absolute_time: snapshot.video.absolute_time,
    current_time: snapshot.video.current_time,
    width: snapshot.video.width,
    height: snapshot.video.height,
    ready_state: snapshot.video.ready_state,
    paused: snapshot.video.paused,
    seeking: snapshot.video.seeking,
    runway_seconds: snapshot.video.runway,
    dropped_frames: snapshot.video.dropped,
    media_error: snapshot.video.error ? snapshot.video.error.code : null,
    stalls: snapshot.stalls || 0,
    stalls_by_kind: snapshot.stalls_by_kind || null,
    stall_recoveries: snapshot.stall_recoveries || 0,
    hitches: hitchTotal(snapshot),
    ttff_ms: snapshot.ttff_ms ?? null,
    method: snapshot.method || null,
    decided_method: snapshot.decided_method || null,
    attempt_id: snapshot.attempt_id || null,
    attempt_reason: snapshot.attempt_reason || null,
    player_generation: snapshot.player_generation ?? null,
    play_started_at: snapshot.play_started_at ?? null,
    server_health: snapshot.health || null,
  };
}

async function sampleWindow(driver, seconds, intervalMs, originMs, sink) {
  const deadline = performance.now() + seconds * 1000;
  let last = null;
  while (performance.now() < deadline) {
    last = await driver.eval(playerSnapshotExpression());
    sink.push(sampleFrom(last, performance.now() - originMs));
    await sleep(Math.max(0, Math.min(intervalMs, deadline - performance.now())));
  }
  last = await driver.eval(playerSnapshotExpression());
  sink.push(sampleFrom(last, performance.now() - originMs));
  return last;
}

/**
 * Hold the link high until the session has proven itself, drop it, then watch.
 * The harness applies the cliff and records the timeline; it deliberately makes
 * no attempt to steer the player, which is N4's job and not this slice's.
 */
async function observeShapedCliff(driver, shaper, testCase, start) {
  const criteria = testCase.recovery || {};
  const intervalMs = (criteria.sample_interval_seconds ?? 1) * 1000;
  const baseline = [];
  // Both windows are timestamped from their own start, and the recovery window
  // from the cliff itself, so every `at_ms` in the artifact reads as "since the
  // cliff" without the reader having to subtract anything.
  // Reset stage-zero measurement only after the first frame. Browser launch,
  // page assets, and player preparation are not part of the shaped baseline and
  // must not dilute a pre-cliff leak below the ceiling check.
  shaper.beginEvidence();
  const baselineStart = performance.now();
  const beforeCliff = await sampleWindow(
    driver, shaper.profile.cliff_after_seconds, intervalMs, baselineStart, baseline,
  );
  const baselineElapsed = (performance.now() - baselineStart) / 1000;
  const baselineAdvanced = beforeCliff.video.absolute_time - start.video.absolute_time;
  const cliffAtMs = shaper.applyCliff();
  const cliffOrigin = performance.now();
  const timeline = [];
  const afterCliff = await sampleWindow(
    driver, criteria.recovery_observe_seconds ?? 45, intervalMs, cliffOrigin, timeline,
  );
  const observation = {
    // End the evidence window with the sampled observation. The same immutable
    // snapshot is reused at the report top level after cleanup, so one artifact
    // cannot contain two throughput accounts for the same stage.
    shaping: shaper.freezeTelemetry(),
    baseline_clock_rate: baselineElapsed > 0 ? baselineAdvanced / baselineElapsed : 0,
    pre_cliff_runway_seconds: Number(beforeCliff.video.runway || 0),
    baseline_error: beforeCliff.video.error
      ? `media error ${beforeCliff.video.error.code}: ${beforeCliff.video.error.message || "unknown"}`
      : !beforeCliff.started ? "the player never reached a presented frame" : null,
    baseline,
    timeline,
  };
  const score = scoreRecovery(criteria, observation);
  return { observation, score, cliffAtMs, end: afterCliff };
}

function scoreCase(manifest, testCase, decision, start, end, elapsedSeconds) {
  const thresholds = manifest.thresholds;
  const errors = [];
  const warnings = [];
  if (end.video.error) errors.push(`media error ${end.video.error.code}: ${end.video.error.message || "unknown"}`);
  if (!end.started) errors.push("player never reached a presented frame");
  if (start.decided_method !== decision.method) {
    errors.push(`player recorded decision ${start.decided_method}, API returned ${decision.method}`);
  }
  if (end.tried_fallback) errors.push("the selected direct/remux path was rejected and fell back to transcode");
  const advanced = end.video.current_time - start.video.current_time;
  const clockRate = elapsedSeconds > 0 ? advanced / elapsedSeconds : 0;
  if (clockRate < thresholds.minimum_clock_rate) {
    errors.push(`media clock advanced at ${clockRate.toFixed(3)}x, want >= ${thresholds.minimum_clock_rate.toFixed(2)}x`);
  }
  const hitches = Math.max(0, hitchTotal(end) - hitchTotal(start));
  if (hitches > thresholds.maximum_hitches) errors.push(`${hitches} visible frame hitches, want <= ${thresholds.maximum_hitches}`);
  const stalls = Math.max(0, (end.stalls || 0) - (start.stalls || 0));
  if (stalls > thresholds.maximum_stalls) errors.push(`${stalls} stalls, want <= ${thresholds.maximum_stalls}`);
  if (testCase.quality === "nomse" && end.copy_hls) errors.push("Original · one stream unexpectedly used copy-HLS");
  if (["1080", "720", "480"].includes(testCase.quality)) {
    const rung = Number(testCase.quality);
    if (end.decided_method !== "transcode") errors.push(`${rung}p quality did not select a transcode verdict`);
    if (end.video.height > rung) errors.push(`decoded height ${end.video.height} exceeds requested ${rung}p rung`);
  }
  if (end.ttff_ms === null) warnings.push("TTFF beacon was not populated");
  if (end.decode && end.decode.supported === false) warnings.push("browser MediaCapabilities reports the decoded stream unsupported");
  return {
    status: errors.length ? "failed" : "passed",
    errors,
    warnings,
    metrics: {
      decision_method: decision.method,
      delivery_mode: decision.delivery?.mode || null,
      actual_method: end.method,
      copy_hls: end.copy_hls,
      encoder: end.encoder,
      ttff_ms: end.ttff_ms,
      observed_seconds: Number(elapsedSeconds.toFixed(3)),
      clock_advanced_seconds: Number(advanced.toFixed(3)),
      clock_rate: Number(clockRate.toFixed(3)),
      hitches,
      stalls,
      stalls_by_kind: end.stalls_by_kind,
      buffer_limits: end.buffer_limits,
      decoded_dimensions: `${end.video.width}x${end.video.height}`,
      runway_seconds: end.video.runway,
      dropped_frames: end.video.dropped,
      total_frames: end.video.total,
      decode: end.decode,
      server_health: end.health,
    },
  };
}

function attemptTransitions(previous, sample) {
  if (!previous.attempt_id || !sample.attempt_id || previous.attempt_id === sample.attempt_id) return 0;
  const before = /^a(\d+)$/.exec(String(previous.attempt_id));
  const after = /^a(\d+)$/.exec(String(sample.attempt_id));
  if (before && after) {
    const delta = Number(after[1]) - Number(before[1]);
    if (delta > 0) return delta;
  }
  return 1;
}

function playerCounterRebased(previous, sample) {
  if (previous.player_generation !== null && previous.player_generation !== undefined
      && sample.player_generation !== null && sample.player_generation !== undefined) {
    return previous.player_generation !== sample.player_generation;
  }
  return previous.play_started_at !== null && previous.play_started_at !== undefined
    && sample.play_started_at !== null && sample.play_started_at !== undefined
    && previous.play_started_at !== sample.play_started_at;
}

/**
 * Compress a sampled timeline into the rung history N4 will judge. Every
 * player attempt has a globally monotonic identity, so two same-reason
 * reconnects remain two restarts even when height and TTFF are unchanged.
 */
function rungHistory(timeline) {
  const events = [];
  for (let index = 1; index < timeline.length; index += 1) {
    const previous = timeline[index - 1];
    const sample = timeline[index];
    const heightChanged = sample.height > 0 && previous.height > 0 && sample.height !== previous.height;
    const attempts = attemptTransitions(previous, sample);
    if (!heightChanged && attempts === 0) continue;
    events.push({
      at_ms: sample.at_ms,
      from_height: previous.height,
      to_height: sample.height,
      direction: !heightChanged ? "restart" : sample.height > previous.height ? "up" : "down",
      restart_count: Math.max(1, attempts),
      attempt_id: sample.attempt_id || null,
      attempt_reason: sample.attempt_reason || null,
      counter_rebase: playerCounterRebased(previous, sample),
    });
  }
  return events;
}

/** The widest count of upgrades inside any 60-second window. */
function peakUpgradeRate(events, windowMs = 60_000) {
  const upgrades = events.filter((event) => event.direction === "up");
  let peak = 0;
  for (const anchor of upgrades) {
    const inWindow = upgrades.filter((event) => event.at_ms >= anchor.at_ms && event.at_ms < anchor.at_ms + windowMs);
    peak = Math.max(peak, inWindow.length);
  }
  return peak;
}

/**
 * The first moment from which playback held at `minimumRate` with no new stall
 * *for the rest of the observation*. Null means it never did.
 *
 * Holding to the end is the load-bearing part. A player that keeps presenting
 * for ten seconds on buffer it filled before the cliff looks identical, over
 * that window, to one that genuinely found a sustainable rung — and then
 * starves. Requiring the window to reach the end of the observation is what
 * separates recovery from drainage, and the observation must therefore be
 * longer than the runway the pre-cliff rate could bank.
 */
function timeToSustained(timeline, sustainedSeconds, minimumRate) {
  if (timeline.length < 2) return null;
  const last = timeline[timeline.length - 1];
  if (last.media_error !== null && last.media_error !== undefined) return null;
  if (last.paused === true || last.seeking === true) return null;
  if (last.ready_state !== null && last.ready_state !== undefined && last.ready_state < 2) return null;
  // In-place newAttempt() calls carry PLAYER.stalls; only play() replaces the
  // PLAYER object and resets it. The harness-owned object generation makes
  // that reset explicit, while attempt_id independently marks every restart.
  const cumulativeStalls = [0];
  let previousStalls = Number(timeline[0].stalls || 0);
  for (let index = 1; index < timeline.length; index += 1) {
    const stalls = Number(timeline[index].stalls || 0);
    const delta = playerCounterRebased(timeline[index - 1], timeline[index])
      ? stalls
      : stalls >= previousStalls ? stalls - previousStalls : stalls;
    cumulativeStalls.push(cumulativeStalls[index - 1] + Math.max(0, delta));
    previousStalls = stalls;
  }
  const windowMs = sustainedSeconds * 1000;
  for (let index = 0; index < timeline.length; index += 1) {
    const from = timeline[index];
    // Too little left to prove anything; every later start is shorter still.
    if (last.at_ms - from.at_ms < windowMs) break;
    if (cumulativeStalls[cumulativeStalls.length - 1] > cumulativeStalls[index]) continue;
    const elapsed = (last.at_ms - from.at_ms) / 1000;
    if (elapsed > 0 && (last.absolute_time - from.absolute_time) / elapsed >= minimumRate) return from.at_ms;
  }
  return null;
}

/**
 * Judge a shaped run. The order of the checks is the diagnosis: a leaked or
 * unapplied cliff invalidates everything after it, and a baseline that was
 * never healthy makes a post-cliff failure meaningless. Only once the link and
 * the baseline are trustworthy does a verdict about recovery mean anything.
 */
function sustainedSecondsOf(criteria) {
  return criteria.sustained_seconds ?? 10;
}

/**
 * The most a bucket at `capKbps` can let out over a window of `windowMs`.
 *
 * This is the bucket's token-conservation identity, not an estimate. Over any
 * window that opens on one claim and closes on another, tokens can only fall by
 * the net bytes claimed and rise by what the window earned:
 *
 *   tokens(end) <= tokens(start) + window * rate - claimed
 *
 * `refill` caps every balance at `SHAPER_BURST_MS` of rate, and `setRate`
 * clamps it again when the cliff shrinks the bucket, so
 * `tokens(start) <= burst * rate` at the head of any stage. Reservation attempts
 * are serialized: a later attempt cannot begin until the preceding attempt has
 * repaid its debt to a non-negative balance and returned. The next claim can
 * therefore drive the balance no further than one slice into debt, giving
 * `tokens(end) >= -SHAPER_SLICE_BYTES`. Multiple granted claims may still wait
 * on separate downstream drains; that does not deepen the bucket debt because
 * their pricing waits completed sequentially. Rearranged, the bytes claimed
 * inside a window cannot exceed `(burst + window) * rate` plus one slice.
 *
 * That one slice is the whole in-flight term, and serialization is what proves
 * it. The same identity scores both shaping gates, at the two window lengths
 * that matter: one second for the rolling burst, and the stage's own ledger
 * span for the sustained rate — where the fixed burst and slice terms are
 * amortized, so a long stage is held far closer to its cap than a short one.
 *
 * Metering completions instead of claims would need one in-flight term for
 * every slice separate connections may hold undrained, which the proxy does not
 * bound below `max_sockets`, and per-connection drain is deliberate.
 */
function shaperClaimBoundBytes(capKbps, windowMs) {
  const bytesPerMs = capKbps / 8;
  return bytesPerMs * (SHAPER_BURST_MS + Math.max(0, windowMs || 0)) + SHAPER_SLICE_BYTES;
}

/** The same identity at the telemetry window, as a rate. */
function shaperBurstBoundKbps(capKbps) {
  return (shaperClaimBoundBytes(capKbps, SHAPER_TELEMETRY_WINDOW_MS) * 8) / SHAPER_TELEMETRY_WINDOW_MS;
}

/**
 * The scored shaping gates for one stage: the same conservation identity read
 * over the stage's own ledger span and over the one-second telemetry window.
 *
 * Both are proofs about the bucket, so neither takes a tolerance multiplier. A
 * multiplier would be an unproved band in which a real leak scores as healthy,
 * and the identity leaves nothing for one to cover: the sustained gate compares
 * exact byte counts, and the burst gate compares its bound at the same 0.1 kb/s
 * quantum the peak is reported in, so the only slack is the half-quantum that
 * rounding can add.
 */
function shapingGates(stage) {
  const gates = [];
  if (Number.isFinite(stage.admitted_bytes) && Number.isFinite(stage.admitted_span_ms)) {
    const boundBytes = shaperClaimBoundBytes(stage.kbps, stage.admitted_span_ms);
    const rate = spanRateKbps(stage.admitted_bytes, stage.admitted_span_ms);
    const boundRate = spanRateKbps(boundBytes, stage.admitted_span_ms);
    gates.push({
      kind: "sustained",
      over: stage.admitted_bytes > boundBytes,
      message: `${stage.label} admitted ${stage.admitted_bytes} B in ${stage.admitted_span_ms} ms`
        + `${rate === null ? "" : ` (${rate} kb/s)`}, past the ${Math.floor(boundBytes)} B`
        + `${boundRate === null ? "" : ` (${boundRate} kb/s)`}`
        + ` its ${stage.kbps} kb/s bucket can release over that window`,
    });
  }
  if (Number.isFinite(stage.admitted_peak_kbps)) {
    const bound = Number(shaperBurstBoundKbps(stage.kbps).toFixed(1));
    gates.push({
      kind: "1s burst",
      over: stage.admitted_peak_kbps > bound,
      message: `${stage.label} admitted a 1s burst rate of ${stage.admitted_peak_kbps} kb/s`
        + ` over a ${stage.kbps} kb/s cap, past its ${bound} kb/s bound`,
    });
  }
  return gates;
}

function scoreRecovery(criteria, observation) {
  const errors = [];
  const shaping = observation.shaping;
  const after = shaping.stages[1];
  const before = shaping.stages[0];

  if (shaping.cliff_applied_at_ms === null || shaping.cliff_applied_at_ms === undefined) {
    return { outcome: "shaping", errors: ["the shaper never applied the cliff"], metrics: { shaping } };
  }
  if (shaping.transport_errors?.length) {
    return {
      outcome: "shaping",
      errors: [`the shaping proxy reported ${shaping.transport_errors.length} transport error(s)`],
      metrics: { shaping },
    };
  }
  for (const stage of [before, after]) {
    const gates = shapingGates(stage);
    if (gates.length < 2) {
      return {
        outcome: "shaping",
        errors: [`the shaper recorded no admission ledger for ${stage.label}`],
        metrics: { shaping },
      };
    }
    const leak = gates.find((gate) => gate.over);
    if (leak) {
      return { outcome: "shaping", errors: [`the shaper leaked: ${leak.message}`], metrics: { shaping } };
    }
  }

  // Delivery is scored once, as a total. Byte counts survive drain regrouping
  // and the rates computed from them do not, so this is the only shape a
  // delivered quantity can be gated in. It proves the one thing the ledger
  // cannot prove about itself: that nothing reached the browser without being
  // claimed from the bucket first.
  //
  // The allowance is the evidence window's own seam, measured rather than
  // assumed. `beginEvidence` clears both series mid-stage, so a slice the
  // bucket priced before the first frame can be delivered after it with its
  // claim in the discarded ledger. The shaper marks exactly those outstanding
  // claims and counts a byte here only when the completion names one of them.
  // If one of those claims is canceled, the surviving ledger contains its
  // negative refund but not the discarded positive claim. The actual credit
  // the bucket accepted is therefore a separate seam adjustment; otherwise a
  // healthy replacement delivery appears unclaimed by exactly that refund.
  // Conversely, a claim created after the reset can be canceled after the
  // bucket has refilled and accepts no refund. Its positive admission correctly
  // remains in the conservation ledger, but `undelivered_admitted_bytes`
  // removes that stranded amount from delivery authorization: a claim that
  // settled without delivery cannot fund unrelated bytes later in the run.
  // A blanket `max_sockets x slice_bytes` ceiling would instead excuse that
  // many unclaimed bytes from anywhere in the run — at 1.5 Mb/s, seconds of
  // link capacity with no provenance at all.
  const delivered = shaping.stages.reduce((total, stage) => total + (stage.bytes || 0), 0);
  const admitted = shaping.stages.reduce((total, stage) => total + (stage.admitted_bytes || 0), 0);
  const evidencePending = shaping.evidence_pending_claim_bytes ?? 0;
  const carriedOver = shaping.carried_over_bytes ?? 0;
  const evidenceRefunded = shaping.evidence_refunded_claim_bytes ?? 0;
  const undeliveredAdmitted = shaping.undelivered_admitted_bytes ?? 0;
  const seamAdjustment = carriedOver + evidenceRefunded;
  if (![evidencePending, carriedOver, evidenceRefunded, undeliveredAdmitted]
    .every((value) => Number.isFinite(value) && value >= 0)
      || seamAdjustment > evidencePending) {
    return {
      outcome: "shaping",
      errors: [
        `the shaper recorded invalid evidence-seam provenance: ${carriedOver} B delivered and `
        + `${evidenceRefunded} B refunded from ${evidencePending} B pending`,
      ],
      metrics: { shaping },
    };
  }
  const deliveryAuthorization = admitted - undeliveredAdmitted + seamAdjustment;
  if (delivered > deliveryAuthorization) {
    return {
      outcome: "shaping",
      errors: [
        `the shaper leaked: the browser received ${delivered} B while the bucket released ${admitted} B`
        + `; canceled claims left ${undeliveredAdmitted} B of admission without delivery`
        + ` (reconciling ${carriedOver} B delivered and ${evidenceRefunded} B refunded from claims`
        + ` pending before the evidence window)`,
      ],
      metrics: { shaping },
    };
  }

  const baselineRate = observation.baseline_clock_rate;
  if (observation.baseline_error) {
    return {
      outcome: "browser_playback",
      errors: [`the session failed before the cliff: ${observation.baseline_error}`],
      metrics: { shaping, baseline_clock_rate: baselineRate },
    };
  }
  if (baselineRate < (criteria.baseline_minimum_clock_rate ?? 0.9)) {
    return {
      outcome: "browser_playback",
      errors: [
        `the pre-cliff baseline was not sustainable (${baselineRate.toFixed(3)}x at ${before.kbps} kb/s), ` +
        "so the cliff cannot prove anything about recovery",
      ],
      metrics: { shaping, baseline_clock_rate: baselineRate },
    };
  }

  // The runway banked at the high rate is exactly how long a doomed session can
  // impersonate a recovered one. If the observation cannot outlast it, the run
  // is not evidence about recovery no matter how it scores.
  const runway = observation.pre_cliff_runway_seconds ?? 0;
  const observeSeconds = criteria.recovery_observe_seconds ?? 45;
  if (observeSeconds < runway + sustainedSecondsOf(criteria)) {
    return {
      outcome: "harness",
      errors: [
        `the ${observeSeconds}s recovery window cannot outlast the ${runway.toFixed(1)}s of runway ` +
        `banked before the cliff plus a ${sustainedSecondsOf(criteria)}s sustained window`,
      ],
      metrics: { shaping, baseline_clock_rate: baselineRate, pre_cliff_runway_seconds: runway },
    };
  }

  const timeline = observation.timeline || [];
  if (!timeline.length) {
    return {
      outcome: "harness",
      errors: ["the post-cliff observation contains no player samples"],
      metrics: { shaping, baseline_clock_rate: baselineRate },
    };
  }
  const incompleteSample = timeline.find((sample) => !sample.attempt_id
    || sample.player_generation === null || sample.player_generation === undefined);
  if (incompleteSample) {
    return {
      outcome: "harness",
      errors: ["the post-cliff timeline is missing player attempt or object identity"],
      metrics: { shaping, baseline_clock_rate: baselineRate },
    };
  }
  const invalidCounter = timeline.find((sample, index) => index > 0
    && Number(sample.stalls || 0) < Number(timeline[index - 1].stalls || 0)
    && !playerCounterRebased(timeline[index - 1], sample));
  if (invalidCounter) {
    return {
      outcome: "harness",
      errors: [`the player stall counter decreased without an object rebase at ${invalidCounter.at_ms} ms`],
      metrics: { shaping, baseline_clock_rate: baselineRate },
    };
  }
  const mediaFailure = timeline.find((sample) =>
    sample.media_error !== null && sample.media_error !== undefined);
  if (mediaFailure) {
    return {
      outcome: "browser_playback",
      errors: [`the player reported media error ${mediaFailure.media_error} after the cliff`],
      metrics: {
        shaping,
        baseline_clock_rate: baselineRate,
        media_error_at_ms: mediaFailure.at_ms,
      },
    };
  }
  const events = rungHistory(timeline);
  const restarts = events.reduce((total, event) => total + (event.restart_count || 1), 0);
  const upgrades = peakUpgradeRate(events);
  const sustainedSeconds = sustainedSecondsOf(criteria);
  const sustainedRate = criteria.sustained_minimum_clock_rate ?? 0.9;
  const recoveredAt = timeToSustained(timeline, sustainedSeconds, sustainedRate);
  const deadlineMs = (criteria.recovery_deadline_seconds ?? 45) * 1000;
  const headroom = after.measured_media_kbps !== null && after.measured_media_kbps < after.kbps * 0.6;

  if (recoveredAt === null) {
    errors.push(
      `playback never held ${sustainedSeconds}s at ${sustainedRate}x after the cliff ` +
      `(${after.kbps} kb/s link, ${restarts} restarts)`,
    );
  } else if (recoveredAt > deadlineMs) {
    errors.push(`recovery took ${(recoveredAt / 1000).toFixed(1)}s, want <= ${(deadlineMs / 1000).toFixed(0)}s`);
  }
  if (restarts > (criteria.maximum_automatic_restarts ?? 1)) {
    errors.push(`${restarts} automatic restarts, want <= ${criteria.maximum_automatic_restarts ?? 1}`);
  }
  if (upgrades > (criteria.maximum_upgrades_per_60s ?? 1)) {
    errors.push(`${upgrades} upgrades inside one 60s window, want <= ${criteria.maximum_upgrades_per_60s ?? 1}`);
  }

  // A starved player on a link that still had room is a supply problem, not an
  // adaptation problem. Saying so is the difference between a useful artifact
  // and one that blames the controller for the producer.
  const outcome = errors.length === 0 ? "passed" : headroom && recoveredAt === null ? "server_supply" : "recovery";
  return {
    outcome,
    errors,
    metrics: {
      shaping,
      baseline_clock_rate: baselineRate,
      pre_cliff_runway_seconds: runway,
      restarts,
      peak_upgrades_per_60s: upgrades,
      recovered_after_ms: recoveredAt,
      rung_events: events,
      counter_rebases: events.filter((event) => event.counter_rebase).length,
      samples: timeline.length,
    },
  };
}

const NORMALIZE_RULES = [
  [/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/gi, "<uuid>"],
  [/\d{4}-\d{2}-\d{2}T[\d:.]+Z/g, "<timestamp>"],
  [/127\.0\.0\.1:\d+/g, "127.0.0.1:<port>"],
  [/(\/var\/folders\/|\/tmp\/)[^\s"']*plurx-playback-lab-[^\s"',)]*/g, "<runtime>"],
  [/\b\d+(\.\d+)?\s?ms\b/g, "<duration>"],
];

function normalizeText(value) {
  return NORMALIZE_RULES.reduce((text, [pattern, replacement]) => text.replace(pattern, replacement), String(value));
}

/**
 * The behavioral shape of a run with every run-local value removed: no UUIDs,
 * ports, wall-clock, temp paths, or timings. Two runs of the same suite on the
 * same machine must produce identical output, which is what lets "the
 * controller is off" be proven rather than asserted.
 */
function normalizeTrace(report) {
  return {
    schema_version: report.schema_version,
    suite: report.suite,
    browser: report.browser?.browser || null,
    network_profile: report.network_profile?.id || null,
    summary: report.summary,
    results: (report.results || []).map((result) => ({
      name: result.name,
      status: result.status,
      operation: result.operation,
      decision_method: result.decision?.method ?? null,
      delivery_mode: result.decision?.delivery?.mode ?? null,
      actual_method: result.metrics?.actual_method ?? null,
      copy_hls: result.metrics?.copy_hls ?? null,
      encoder: result.metrics?.encoder ?? null,
      decoded_dimensions: result.metrics?.decoded_dimensions ?? null,
      tried_fallback: result.end?.tried_fallback ?? null,
      errors: (result.errors || []).map(normalizeText),
      warnings: (result.warnings || []).map(normalizeText),
    })),
  };
}

async function runOneCase(driver, server, manifest, fixture, testCase, browserInfo, observeOverride, shaper) {
  const file = server.files.get(fixture.filename);
  if (!file) throw new Error(`scanner did not return ${fixture.filename}`);
  await setCasePreferences(driver, testCase.quality);
  const decision = await api(server.baseUrl,
    `/files/${file.id}/decision?${browserInfo.caps_q}&force=${qualityForce(testCase.quality)}`,
    { token: server.token });
  const startedAt = Date.now();
  await driver.startPlayback(file.id, file.title || fixture.id, file.duration_ms || 0);
  let start;
  try {
    start = await waitFor(async () => {
      const state = await driver.eval(playerSnapshotExpression());
      if (state.video.error) return state;
      return state.file_id === file.id && state.started && state.video.ready_state >= 2 && state.video.current_time > 0
        ? state : null;
    }, manifest.thresholds.start_timeout_seconds * 1000, "first presented frame", 250);
  } catch (error) {
    const end = await driver.eval(playerSnapshotExpression()).catch(() => null);
    return {
      name: testCase.name, fixture: fixture.id, quality: testCase.quality, operation: testCase.operation,
      status: "failed", duration_ms: Date.now() - startedAt,
      errors: [error.message], warnings: [], decision, start: null, end,
    };
  }
  if (start.video.error) {
    return {
      name: testCase.name, fixture: fixture.id, quality: testCase.quality, operation: testCase.operation,
      status: "failed", duration_ms: Date.now() - startedAt,
      errors: [`media error ${start.video.error.code}: ${start.video.error.message || "unknown"}`], warnings: [], decision, start, end: start,
    };
  }
  if (testCase.operation === "shaped-cliff") {
    if (!shaper) throw new Error("a shaped-cliff case needs --network-profile");
    const shaped = await observeShapedCliff(driver, shaper, testCase, start);
    return {
      name: testCase.name, fixture: fixture.id, quality: testCase.quality, operation: testCase.operation,
      status: shaped.score.errors.length ? "failed" : "passed",
      outcome: shaped.score.outcome,
      duration_ms: Date.now() - startedAt,
      errors: shaped.score.errors,
      warnings: shaped.observation.shaping.transport_errors.length
        ? [`shaper reported ${shaped.observation.shaping.transport_errors.length} transport errors`] : [],
      metrics: shaped.score.metrics,
      operation_detail: { cliff_applied_at_ms: shaped.cliffAtMs },
      shaping: shaped.observation.shaping,
      baseline: shaped.observation.baseline,
      timeline: shaped.observation.timeline,
      decision,
      start,
      end: shaped.end,
    };
  }
  let operation = null;
  try {
    operation = await performOperation(driver, testCase, start);
    if (operation) start = await driver.eval(playerSnapshotExpression());
  } catch (error) {
    const end = await driver.eval(playerSnapshotExpression()).catch(() => start);
    return {
      name: testCase.name, fixture: fixture.id, quality: testCase.quality, operation: testCase.operation,
      status: "failed", duration_ms: Date.now() - startedAt,
      errors: [`${testCase.operation}: ${error.message}`], warnings: [], decision, start, end,
    };
  }
  const observeSeconds = Number(observeOverride || manifest.thresholds.observe_seconds);
  const wallStart = performance.now();
  await new Promise((resolve) => setTimeout(resolve, observeSeconds * 1000));
  const elapsedSeconds = (performance.now() - wallStart) / 1000;
  const end = await driver.eval(playerSnapshotExpression());
  const score = scoreCase(manifest, testCase, decision, start, end, elapsedSeconds);
  return {
    name: testCase.name,
    fixture: fixture.id,
    quality: testCase.quality,
    operation: testCase.operation,
    status: score.status,
    duration_ms: Date.now() - startedAt,
    errors: score.errors,
    warnings: score.warnings,
    metrics: score.metrics,
    operation_detail: operation,
    decision,
    start,
    end,
  };
}

function xmlEscape(value) {
  return String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&apos;");
}

function junit(report) {
  const failures = report.results.filter((result) => result.status !== "passed").length;
  const totalSeconds = report.results.reduce((sum, result) => sum + result.duration_ms, 0) / 1000;
  const cases = report.results.map((result) => {
    const failure = result.status === "passed" ? "" :
      `<failure message="${xmlEscape(result.errors.join("; "))}">${xmlEscape(JSON.stringify(result, null, 2))}</failure>`;
    const output = xmlEscape(JSON.stringify({ metrics: result.metrics, warnings: result.warnings }, null, 2));
    return `  <testcase classname="playback.${xmlEscape(report.browser?.browser || "unknown")}" name="${xmlEscape(result.name)}" time="${(result.duration_ms / 1000).toFixed(3)}">${failure}<system-out>${output}</system-out></testcase>`;
  }).join("\n");
  return `<?xml version="1.0" encoding="UTF-8"?>\n<testsuite name="plurx playback ${xmlEscape(report.suite)}" tests="${report.results.length}" failures="${failures}" time="${totalSeconds.toFixed(3)}">\n${cases}\n</testsuite>\n`;
}

async function writeReport(report, options) {
  await fsp.mkdir(DEFAULT_REPORT_DIR, { recursive: true });
  const stamp = new Date().toISOString().replaceAll(":", "-").replace(/\.\d{3}Z$/, "Z");
  const label = (report.browser?.browser || "unknown").toLowerCase();
  const stem = path.join(DEFAULT_REPORT_DIR, `${stamp}-${label}-${report.suite}`);
  const jsonPath = path.resolve(options.json || `${stem}.json`);
  const junitPath = path.resolve(options.junit || `${stem}.xml`);
  await fsp.mkdir(path.dirname(jsonPath), { recursive: true });
  await fsp.mkdir(path.dirname(junitPath), { recursive: true });
  await fsp.writeFile(jsonPath, `${JSON.stringify(report, null, 2)}\n`, "utf8");
  await fsp.writeFile(junitPath, junit(report), "utf8");
  return { jsonPath, junitPath };
}

function sanitizedText(value) {
  return String(value)
    .replace(/([?&](?:token|x-plex-token)=)[^&\s"']+/gi, "$1<redacted>")
    .replace(/\bBearer\s+[^\s"']+/gi, "Bearer <redacted>");
}

function sanitizedError(error) {
  return sanitizedText(error?.message || error || "unknown harness failure");
}

function harnessFailureResult(error) {
  const message = sanitizedError(error);
  return {
    name: "playback-lab harness",
    fixture: null,
    quality: null,
    operation: "harness",
    status: "failed",
    outcome: "harness",
    duration_ms: 0,
    errors: [message],
    warnings: [],
    metrics: {},
  };
}

async function writeFatalRunReport(options, error) {
  const result = harnessFailureResult(error);
  let profile = null;
  try {
    profile = parseNetworkProfile(options.network_profile);
  } catch (_) {
    // The parse error is already the retained failure; an invalid profile is
    // not represented as though it were an applied link.
  }
  const report = {
    schema_version: 1,
    generated_at: new Date().toISOString(),
    suite: options.suite || "smoke",
    browser: { browser: options.browser || "chrome" },
    network_profile: profile,
    shaping: null,
    server: null,
    corpus: {},
    outcome: "harness",
    fatal_error: result.errors[0],
    summary: { total: 1, passed: 0, failed: 1 },
    results: [result],
  };
  const paths = await writeReport(report, options);
  process.stdout.write(`\nRESULT  0/1 passed · outcome harness\n`);
  process.stdout.write(`JSON    ${paths.jsonPath}\n`);
  process.stdout.write(`JUNIT   ${paths.junitPath}\n`);
  error.reportWritten = true;
}

async function runSuite(manifest, options, dependencies = {}) {
  const suite = options.suite || "smoke";
  const browserName = options.browser || "chrome";
  if (!new Set(["chrome", "safari", "edge", "firefox"]).has(browserName)) {
    throw new Error(`unknown browser ${browserName}; choose chrome, safari, edge, or firefox`);
  }
  if (options.observe !== undefined && !(Number(options.observe) > 0)) {
    throw new Error("--observe must be a positive number of seconds");
  }
  // Parsed before the corpus is built: a typo in the profile should cost a
  // second, not the 195 MB fixture build and a server boot.
  const profile = parseNetworkProfile(options.network_profile);
  const plan = printPlan(manifest, suite, options.case);
  const shapedCases = plan.cases.filter((testCase) => testCase.operation === "shaped-cliff");
  if ((shapedCases.length || manifest.suites[suite]?.requires_network_profile) && !profile) {
    throw new Error(`suite ${suite} has shaped-cliff cases; pass --network-profile, e.g. 8mbps-to-1.5mbps`);
  }
  process.stdout.write("\n");
  const wanted = new Set(plan.cases.map((testCase) => testCase.fixture));
  const corpus = await (dependencies.buildFixtures || buildFixtures)(manifest, options, wanted);
  process.stdout.write("\nSTART   isolated plurx server\n");
  const server = await (dependencies.startServer || startServer)(options, corpus.directory);
  const missing = manifest.fixtures
    .filter((fixture) => wanted.has(fixture.id))
    .filter((fixture) => !server.files.has(fixture.filename));
  if (missing.length) {
    await server.close(options.keep_runtime);
    throw new Error(`scan missed fixtures: ${missing.map((fixture) => fixture.filename).join(", ")}`);
  }
  // The browser pulls through the shaper; this process keeps talking to the
  // server directly, so the control plane never competes with the shaped
  // budget and never distorts the throughput the report attributes to media.
  let shaper = null;
  let playerBaseUrl = server.baseUrl;
  if (profile) {
    try {
      shaper = dependencies.createShaper
        ? dependencies.createShaper(profile, server.baseUrl)
        : new ShapingProxy(profile, server.baseUrl);
      playerBaseUrl = await shaper.start(options.shaper_binder);
    } catch (error) {
      if (shaper) await shaper.close().catch(() => {});
      await server.close(options.keep_runtime);
      throw error;
    }
    process.stdout.write(
      `SHAPE   ${profile.spec}: ${profile.stages[0].kbps} kb/s, cliff to ` +
      `${profile.stages[1].kbps} kb/s ${profile.cliff_after_seconds}s after the first frame\n`,
    );
  }
  let driver = null;
  let browserInfo = null;
  let system = null;
  let fatal = null;
  const results = [];
  try {
    if (dependencies.createDriver) {
      driver = dependencies.createDriver(options, playerBaseUrl, server.runtime, browserName);
    } else if (browserName === "safari") {
      driver = new SafariDriver(options, playerBaseUrl, server.runtime);
    } else if (browserName === "firefox") {
      driver = new FirefoxDriver(options, playerBaseUrl, server.runtime);
    } else {
      driver = new CdpDriver(options, playerBaseUrl, server.runtime, browserName);
    }
    process.stdout.write(`START   ${browserName} player\n`);
    await driver.start();
    browserInfo = await (dependencies.prepareBrowser || prepareBrowser)(driver, server.token);
    system = await (dependencies.api || api)(server.baseUrl, "/system", { token: server.token });
    process.stdout.write(`CAPS    ${browserInfo.browser}: video=${browserInfo.caps.vcodec} · audio=${browserInfo.caps.acodec} · hdr=${browserInfo.caps.hdr} · native_hls=${browserInfo.native_hls}\n\n`);
    for (let index = 0; index < plan.cases.length; index += 1) {
      const testCase = plan.cases[index];
      const fixture = plan.fixtures.get(testCase.fixture);
      process.stdout.write(`CASE    ${String(index + 1).padStart(2)}/${plan.cases.length} ${testCase.name}\n`);
      const caseLogStart = Date.now();
      let result;
      try {
        result = await (dependencies.runOneCase || runOneCase)(
          driver, server, manifest, fixture, testCase, browserInfo, options.observe, shaper,
        );
      } catch (error) {
        result = {
          name: testCase.name, fixture: fixture.id, quality: testCase.quality, operation: testCase.operation,
          status: "failed", duration_ms: 0, errors: [error.message], warnings: [],
        };
      } finally {
        // A timeout can leave native HLS or a transcode session attached to the
        // video element. Close it, then make a fresh page the case boundary so
        // WebKit media state cannot turn one real failure into a false cascade.
        await driver.exec("try{closePlayer()}catch(e){} return true;").catch(() => {});
        if (index + 1 < plan.cases.length) {
          await driver.reload();
          await waitFor(
            () => driver.eval("typeof play === 'function' && typeof CAPS_Q === 'string'"),
            30_000,
            `${browserName} player reset`,
          );
        }
      }
      try {
        const logs = await (dependencies.api || api)(
          server.baseUrl, "/system/logs?level=trace&limit=500", { token: server.token },
        );
        result.server_logs = logs.filter((entry) => entry.ts_ms >= caseLogStart - 100);
        result.diagnostics = result.server_logs
          .filter((entry) => entry.level === "ERROR" || entry.level === "WARN")
          .filter((entry) => !(entry.target === "plurxd::client" && entry.message.includes("] ttff ")))
          .slice(-8);
      } catch (_) {
        result.server_logs = [];
        result.diagnostics = [];
      }
      results.push(result);
      if (result.status === "passed" && result.operation === "shaped-cliff") {
        const m = result.metrics;
        process.stdout.write(
          `PASS         cliff held · recovered in ${(m.recovered_after_ms / 1000).toFixed(1)}s · ` +
          `${m.restarts} restarts · ${m.peak_upgrades_per_60s} upgrades/60s\n`,
        );
      } else if (result.status === "passed") {
        const m = result.metrics;
        process.stdout.write(`PASS         ${m.decision_method} -> ${m.actual_method}${m.copy_hls ? " / copy-HLS" : ""} · TTFF ${m.ttff_ms ?? "?"} ms · clock ${m.clock_rate.toFixed(3)}x · hitches ${m.hitches} · stalls ${m.stalls}\n`);
      } else {
        process.stdout.write(`FAIL    ${result.outcome ? `[${result.outcome}] ` : ""}     ${result.errors.join("; ")}\n`);
        for (const diagnostic of (result.diagnostics || []).slice(-5)) {
          process.stdout.write(`SERVER       ${diagnostic.level} ${diagnostic.target}: ${diagnostic.message}\n`);
        }
      }
    }
  } catch (error) {
    // Keep the artifact. A run that dies mid-suite is exactly when the reader
    // needs to know which layer died, and a missing file answers nothing.
    fatal = error;
  } finally {
    if (driver) await driver.close().catch(() => {});
    if (shaper) await shaper.close().catch(() => {});
    await server.close(options.keep_runtime);
  }
  if (fatal) results.push(harnessFailureResult(fatal));
  const passed = results.filter((result) => result.status === "passed").length;
  const report = {
    schema_version: 1,
    generated_at: new Date().toISOString(),
    suite,
    browser: browserInfo,
    network_profile: profile,
    shaping: shaper ? shaper.telemetry() : null,
    server: {
      base_url: server.baseUrl,
      player_base_url: playerBaseUrl,
      version: system?.version ?? null,
      build: system?.build ?? null,
      ffmpeg_version: system?.ffmpeg_version ?? null,
      encoder_selected: system?.encoder_selected ?? null,
      tone_map: system?.tone_map ?? null,
    },
    corpus: corpus.metadata,
    outcome: fatal ? "harness" : results.find((result) => result.outcome && result.status !== "passed")?.outcome
      || (passed === results.length ? "passed" : "browser_playback"),
    fatal_error: fatal ? sanitizedError(fatal) : null,
    summary: { total: results.length, passed, failed: results.length - passed },
    results,
  };
  const paths = await writeReport(report, options);
  process.stdout.write(`\nRESULT  ${passed}/${results.length} passed · outcome ${report.outcome}\n`);
  process.stdout.write(`JSON    ${paths.jsonPath}\n`);
  process.stdout.write(`JUNIT   ${paths.junitPath}\n`);
  if (fatal) {
    fatal.reportWritten = true;
    throw fatal;
  }
  return passed === results.length ? 0 : 1;
}

async function executeRun(manifest, options, dependencies = {}) {
  try {
    return { code: await runSuite(manifest, options, dependencies), error: null };
  } catch (error) {
    if (!error.reportWritten) await writeFatalRunReport(options, error);
    return { code: 1, error };
  }
}

/**
 * Read a report back. Every rejection here is a real failure mode of an
 * evidence artifact — absent, truncated, or something else entirely — and each
 * one must be loud, because a silently-empty comparison would "pass".
 */
async function loadArtifact(file) {
  if (!file || file === true) throw new Error("--json PATH is required");
  const resolved = path.resolve(file);
  let text;
  try {
    text = await fsp.readFile(resolved, "utf8");
  } catch (error) {
    throw new Error(`artifact ${resolved} could not be read: ${error.code || error.message}`);
  }
  let report;
  try {
    report = JSON.parse(text);
  } catch (error) {
    throw new Error(`artifact ${resolved} is not valid JSON: ${error.message}`);
  }
  if (report === null || typeof report !== "object" || report.schema_version !== 1 || !Array.isArray(report.results)) {
    throw new Error(`artifact ${resolved} is not a playback-lab report`);
  }
  return report;
}

async function normalizeCommand(options) {
  const report = await loadArtifact(options.json);
  const text = `${JSON.stringify(normalizeTrace(report), null, 2)}\n`;
  if (options.out && options.out !== true) {
    const target = path.resolve(options.out);
    await fsp.mkdir(path.dirname(target), { recursive: true });
    await fsp.writeFile(target, text, "utf8");
    process.stdout.write(`NORMAL  ${target}\n`);
  } else {
    process.stdout.write(text);
  }
}

function requireTextOption(options, key, flag) {
  const value = options[key];
  if (!value || value === true) throw new Error(`${flag} needs a value`);
  return String(value);
}

function enabledOption(value) {
  if (value === undefined || value === false) return false;
  if (value === true) return true;
  if (/^(1|true|yes|on)$/i.test(String(value))) return true;
  if (/^(0|false|no|off)$/i.test(String(value))) return false;
  throw new Error(`boolean option value must be true or false, got ${value}`);
}

async function writeDeviceProxyControlFile(file, document) {
  const resolved = path.resolve(file);
  await fsp.mkdir(path.dirname(resolved), { recursive: true });
  await fsp.writeFile(resolved, `${JSON.stringify(document, null, 2)}\n`, {
    encoding: "utf8",
    mode: 0o600,
    flag: "wx",
  });
  return resolved;
}

async function deviceProxyCommand(options, dependencies = {}) {
  const targetText = requireTextOption(options, "target", "--target");
  const target = new URL(targetText);
  if (target.protocol !== "http:") {
    throw new Error("device-proxy currently requires an http:// target");
  }
  if (target.username || target.password) {
    throw new Error("put credentials in the device's stored session, not in --target");
  }
  const profile = parseNetworkProfile(requireTextOption(
    options, "network_profile", "--network-profile",
  ));
  const listenHost = requireTextOption(options, "listen", "--listen");
  const publicHost = requireTextOption(options, "public_host", "--public-host");
  const controlFile = requireTextOption(options, "control_file", "--control-file");
  const controlToken = crypto.randomBytes(32).toString("hex");
  const shaper = dependencies.createShaper
    ? dependencies.createShaper(profile, target.origin, {
      listenHost,
      listenPort: options.port,
      publicHost,
      controlToken,
      autoAdvance: enabledOption(options.auto_advance),
      recoveryCliffAfterSeconds: options.recovery_cliff_after,
    })
    : new ShapingProxy(profile, target.origin, {
      listenHost,
      listenPort: options.port,
      publicHost,
      controlToken,
      autoAdvance: enabledOption(options.auto_advance),
      recoveryCliffAfterSeconds: options.recovery_cliff_after,
    });
  let resolvedControlFile = null;
  let baseUrl = null;
  try {
    baseUrl = await shaper.start(options.shaper_binder);
    resolvedControlFile = await writeDeviceProxyControlFile(controlFile, {
      schema_version: 1,
      pid: process.pid,
      proxy: baseUrl,
      target: target.origin,
      profile: profile.spec,
      status_path: "/__playback_lab/status",
      cliff_path: "/__playback_lab/cliff",
      evidence_path: "/__playback_lab/evidence",
      control_header: "x-playback-lab-control",
      control_token: controlToken,
    });
    process.stdout.write(`DEVICE  ${baseUrl} -> ${target.origin}\n`);
    process.stdout.write(`PROFILE ${profile.stages.map((stage) => `${stage.kbps} kb/s`).join(" -> ")}\n`);
    process.stdout.write(`CONTROL ${resolvedControlFile} (mode 0600; token is stored only there)\n`);
    const waitForShutdown = dependencies.waitForShutdown || (() => new Promise((resolve) => {
      const stop = () => resolve();
      process.once("SIGINT", stop);
      process.once("SIGTERM", stop);
    }));
    await waitForShutdown();
    const evidenceFile = path.resolve(options.evidence || `${resolvedControlFile}.evidence.json`);
    await fsp.writeFile(evidenceFile, `${JSON.stringify(shaper.controlSnapshot(), null, 2)}\n`, {
      encoding: "utf8",
      mode: 0o600,
    });
    process.stdout.write(`EVIDENCE ${evidenceFile}\n`);
  } finally {
    await shaper.close().catch(() => {});
    if (resolvedControlFile) await fsp.unlink(resolvedControlFile).catch(() => {});
  }
  return { baseUrl, shaper };
}

function positiveNumberOption(options, key, flag, fallback) {
  if (options[key] === undefined) return fallback;
  const value = Number(options[key]);
  if (!Number.isFinite(value) || value <= 0) throw new Error(`${flag} must be positive`);
  return value;
}

function launchPhysicalAppleDevice(args) {
  const result = spawnSync("xcrun", ["devicectl", "device", "process", "launch", ...args], {
    encoding: "utf8",
  });
  if (result.error) throw new Error(`xcrun devicectl could not launch the device app: ${result.error.message}`);
  if (result.status !== 0) {
    throw new Error(`xcrun devicectl launch failed: ${sanitizedText(result.stderr || result.stdout)}`);
  }
}

function acceptanceTerminalEvent(events) {
  return [...events].reverse().find((event) =>
    (event.event === "stall" && /outcome=(stop|terminal)/.test(String(event.detail || "")))
      || event.event === "avplayer_item_failed"
      || event.event === "avplayer_early_end");
}

async function waitForDeviceAcceptance(shaper, timeoutMs, interval = sleep) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    const terminal = acceptanceTerminalEvent(shaper.clientEvents);
    if (terminal) return { reason: "terminal-client-event", event: terminal };
    await interval(Math.min(1_000, Math.max(1, deadline - Date.now())));
  }
  return {
    reason: "observation-window-ended",
    event: acceptanceTerminalEvent(shaper.clientEvents) || null,
  };
}

async function deviceRunCommand(options, dependencies = {}) {
  const targetText = requireTextOption(options, "target", "--target");
  const target = new URL(targetText);
  if (target.protocol !== "http:" || target.username || target.password) {
    throw new Error("--target must be a credential-free http:// server origin");
  }
  const device = requireTextOption(options, "device", "--device");
  const publicHost = requireTextOption(options, "public_host", "--public-host");
  const fileId = Number(requireTextOption(options, "file_id", "--file-id"));
  if (!Number.isInteger(fileId) || fileId <= 0) throw new Error("--file-id must be a positive integer");
  const itemId = options.item_id === undefined ? 0 : Math.max(0, Number(options.item_id));
  if (!Number.isInteger(itemId)) throw new Error("--item-id must be a non-negative integer");
  const height = options.height === undefined
    ? undefined
    : positiveNumberOption(options, "height", "--height");
  if (height !== undefined && !Number.isInteger(height)) {
    throw new Error("--height must be a positive integer");
  }
  const observeSeconds = positiveNumberOption(options, "observe", "--observe", 180);
  const profile = parseNetworkProfile(requireTextOption(
    options, "network_profile", "--network-profile",
  ));
  const bundleId = options.bundle_id && options.bundle_id !== true
    ? String(options.bundle_id)
    : "tv.plurx.app";
  const token = crypto.randomBytes(32).toString("hex");
  const shaper = dependencies.createShaper
    ? dependencies.createShaper(profile, target.origin, {
      listenHost: "0.0.0.0",
      listenPort: options.port,
      publicHost,
      controlToken: token,
      autoAdvance: options.auto_advance === undefined ? true : enabledOption(options.auto_advance),
      recoveryCliffAfterSeconds: options.recovery_cliff_after,
    })
    : new ShapingProxy(profile, target.origin, {
      listenHost: "0.0.0.0",
      listenPort: options.port,
      publicHost,
      controlToken: token,
      autoAdvance: options.auto_advance === undefined ? true : enabledOption(options.auto_advance),
      recoveryCliffAfterSeconds: options.recovery_cliff_after,
    });
  const launch = dependencies.launchDevice || launchPhysicalAppleDevice;
  const restore = dependencies.restoreDevice || launchPhysicalAppleDevice;
  let baseUrl;
  let evidence;
  let launched = false;
  try {
    baseUrl = await shaper.start(options.shaper_binder);
    process.stdout.write(`DEVICE  ${device}\n`);
    process.stdout.write(`SHAPE   ${profile.stages.map((stage) => `${stage.kbps} kb/s`).join(" -> ")}\n`);
    const launchArguments = [
      "--device", device,
      "--terminate-existing",
      "--activate",
      bundleId,
      "-plurx.origin", baseUrl,
      "-plurx.acceptance.fileId", String(fileId),
      "-plurx.acceptance.itemId", String(itemId),
      "-plurx.acceptance.title", String(options.title || "Playback acceptance"),
      "-plurx.acceptance.probe", "YES",
    ];
    // Omitted means the player's quality selection remains Auto. Supplying a
    // height is deliberately an explicit manual-quality acceptance case.
    if (height !== undefined) {
      launchArguments.push("-plurx.acceptance.height", String(height));
    }
    launch(launchArguments);
    launched = true;
    const completion = await (dependencies.waitForAcceptance || waitForDeviceAcceptance)(
      shaper, observeSeconds * 1_000,
    );
    evidence = { ...shaper.controlSnapshot(), device, bundle_id: bundleId, completion };
    const stamp = new Date().toISOString().replaceAll(":", "-").replace(/\.\d{3}Z$/, "Z");
    const jsonPath = path.resolve(options.json || path.join(
      DEFAULT_REPORT_DIR, `${stamp}-apple-device-acceptance.json`,
    ));
    await fsp.mkdir(path.dirname(jsonPath), { recursive: true });
    await fsp.writeFile(jsonPath, `${JSON.stringify(evidence, null, 2)}\n`, {
      encoding: "utf8",
      mode: 0o600,
    });
    process.stdout.write(`RESULT  ${completion.reason}\n`);
    process.stdout.write(`JSON    ${jsonPath}\n`);
  } finally {
    await shaper.close().catch(() => {});
    if (launched && !enabledOption(options.leave_running)) {
      try {
        restore(["--device", device, "--terminate-existing", "--activate", bundleId]);
      } catch (error) {
        process.stderr.write(`playback-lab: device restore failed: ${sanitizedError(error)}\n`);
      }
    }
  }
  return evidence;
}

async function main() {
  const { command, options } = parseArgs(process.argv.slice(2));
  if (command === "help" || command === "--help" || command === "-h") {
    usage();
    return;
  }
  if (command === "normalize") return normalizeCommand(options);
  if (command === "device-proxy") return deviceProxyCommand(options);
  if (command === "device-run") return deviceRunCommand(options);
  if (command === "run") {
    const outcome = await executeRun(loadManifest(), options);
    if (outcome.error) throw outcome.error;
    if (outcome.code !== 0) process.exitCode = outcome.code;
    return;
  }
  const manifest = loadManifest();
  if (command === "doctor") doctor(options);
  else if (command === "fixtures") await buildFixtures(manifest, options);
  else if (command === "plan") printPlan(manifest, options.suite || "smoke", options.case);
  else throw new Error(`unknown command ${command}`);
}

// Required as a module by tests/playback/network-shaping.test.js, which drives
// the shaping, scoring, and normalization logic without a browser.
module.exports = {
  NETWORK_PROFILES,
  SHAPER_SLICE_BYTES,
  ShapingProxy,
  TokenBucket,
  diagnosticPath,
  deviceRunCommand,
  deviceProxyCommand,
  executeRun,
  expandCases,
  fixturesForBuild,
  isMediaPath,
  loadArtifact,
  loadManifest,
  normalizeTrace,
  parseNetworkProfile,
  peakUpgradeRate,
  rungHistory,
  scoreRecovery,
  shaperBurstBoundKbps,
  shaperClaimBoundBytes,
  timeToSustained,
  waitForDeviceAcceptance,
  writeFatalRunReport,
  writeDeviceProxyControlFile,
};

if (require.main === module) {
  main().catch((error) => {
    process.stderr.write(`playback-lab: ${sanitizedText(error.stack || error.message)}\n`);
    process.exitCode = 1;
  });
}
