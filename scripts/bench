#!/usr/bin/env python3
"""plurx playback benchmark — the fixture matrix, run against a real server.

Why this exists: every performance claim in docs/PERF-PLAN.md is a claim about
numbers, and until now the only way to check one was to watch a film and form
an impression. An impression cannot tell 0.9x from 1.1x, and that difference is
the whole question — below realtime a session drains the viewer's reserve until
it stalls, above it the reserve grows. It also cannot produce a distribution,
and a mean hides exactly the starts people remember.

    scripts/bench fixtures                 # build the corpus (once, ~2 min)
    scripts/bench run --token TOKEN        # play everything, print the table
    scripts/bench run --only 4k-hdr10      # one fixture, while iterating
    scripts/bench rate-control --base http://nynuc:32400 --token TOKEN \
      --corpus scripts/perf2-rate-control-smoke-corpus.json --modes vbr \
      --vmaf-ffmpeg ffmpeg --vmaf-model vmaf_v0.6.1 \
      --json out/rate-control.json

Needs: python3 (stdlib only), ffmpeg for fixture generation, an explicit
libvmaf-capable scoring FFmpeg for `rate-control`, and a running plurxd with a
library pointed at the fixture directory. `rate-control` never consults the
server's `PLURX_FFMPEG` environment setting.

`rate-control` captures bytes from real plurxd HLS sessions, so production
encoding always uses the server's own configured Jellyfin FFmpeg and hardware.
A separate `--vmaf-ffmpeg` process is behavior-probed and used for scoring only:
it decodes the captured bytes and the reference into the `libvmaf` filter, and
never creates production playback media. No pixel analysis runs on plurx's play
path. Client-side runway comes from the player's own beacons; read those in
Settings -> Logs alongside the server-playback report.
"""

import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import socket
import statistics
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sleep = time.sleep

# --- the corpus -------------------------------------------------------------
# Each entry is a shape that has bitten this pipeline, not a resolution ladder.
# The comment on each says which failure it is here to catch.
FIXTURES = {
    # The baseline everything else is compared against: direct-playable.
    "1080p-h264": dict(
        size="1920x1080", codec="libx264", extra=["-g", "48"], hdr=None,
        why="direct play / cheap remux baseline",
    ),
    # 4K HEVC SDR — heavy decode, no tone-map. Isolates decode cost from
    # tone-map cost, which the plan's central claim depends on separating.
    "4k-hevc-sdr": dict(
        size="3840x2160", codec="libx265", extra=["-g", "48", "-x265-params", "log-level=none"],
        hdr=None, why="4K decode cost without tone-mapping",
    ),
    # 4K HDR10 — the one the whole GPU tone-map milestone is about. Tagged
    # properly (bt2020/PQ) so the decision engine and the filter chain both see
    # HDR rather than a mislabelled SDR file.
    "4k-hdr10": dict(
        size="3840x2160", codec="libx265",
        extra=["-g", "48", "-pix_fmt", "yuv420p10le", "-x265-params",
               "log-level=none:hdr-opt=1:colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc"],
        hdr="pq", why="THE 4K case: decode + CPU float tone-map",
    ),
    # HLG differs from PQ only in transfer, and routes to a different pipeline
    # on purpose (PERF-PLAN S5) — so it needs its own row.
    "4k-hlg": dict(
        size="3840x2160", codec="libx265",
        extra=["-g", "48", "-pix_fmt", "yuv420p10le", "-x265-params",
               "log-level=none:colorprim=bt2020:transfer=arib-std-b67:colormatrix=bt2020nc"],
        hdr="hlg", why="HLG takes a different tone-map path",
    ),
    # Sparse keyframes: the copy path cannot force them, so segments run to the
    # source GOP. This is the fixture that proves segment bounds come from
    # EXTINF rather than from index arithmetic.
    "sparse-gop": dict(
        size="1920x1080", codec="libx264", extra=["-g", "600"], hdr=None,
        why="variable/long segments on the copy path",
    ),
    # Grain defeats rate control; this is where a 'bounded' rung stops being
    # bounded (PERF-PLAN S4.6).
    "grainy": dict(
        size="1920x1080", codec="libx264", extra=["-g", "48"], hdr=None,
        grain=True, why="rate-control overshoot",
    ),
}

# Long enough for a session to settle past its burst, short enough that
# building the corpus is not itself an afternoon: 4K HEVC encodes slower than
# realtime on most machines, and this runs once per machine.
DURATION = 45

RATE_CONTROL_SCHEMA_VERSION = 1
RATE_CONTROL_SMOKE_MODES = ("vbr",)
RATE_CONTROL_FULL_MODES = ("vbr", "qvbr")
RATE_CONTROL_ACCEPTANCE_MODEL = "vmaf_v0.6.1"
RATE_CONTROL_ACCEPTANCE_VMAF_SUBSAMPLE = 1
RATE_CONTROL_ACCEPTANCE_RATE_WINDOW = 10.0
RATE_CONTROL_ACCEPTANCE_POLL = 0.25
RATE_CONTROL_ACCEPTANCE_SETTINGS_SETTLE = 3.0
RATE_CONTROL_PEAK_CONTRACT_STATUS = "owner_ratified_2026-08-12"
LADDER_IDENTITY_FIELDS = (
    "requested_height",
    "advertised_height",
    "advertised_total_kbps",
    "advertised_peak_kbps",
    "derived_nominal_video_kbps",
    "derived_audio_kbps",
    "video_maxrate_kbps",
    "video_bufsize_kbits",
)
VMAF_SCORE = re.compile(r"VMAF score:\s*([^\s]+)")
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
SAFE_SEGMENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
SHA256SUM_LINE = re.compile(r"^([0-9a-f]{64}) [ *](.+)$")
RATE_MODE_FIELD = "transcode_rate_mode"
QUALITY_FIELD = "transcode_quality"
ORIGIN_TOLERANCE_MS = 50
MIN_CAPTURE_FREE_BYTES = 512 * 1024 * 1024


class BenchError(RuntimeError):
    """A benchmark contract or tool failure that belongs in the JSON result."""


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def scoring_executable(requested):
    """Resolve only the explicitly selected offline scorer.

    In particular, do not inspect PLURX_FFMPEG: that variable belongs to the
    deployed server and must never redirect this controller-side scorer.
    """
    found = shutil.which(requested)
    if found is None:
        raise BenchError(f"VMAF scoring executable not found: {requested}")
    return str(Path(found).resolve())


def tool_build(tool):
    result = sh([tool, "-version"])
    if result.returncode != 0:
        raise BenchError(f"{tool} -version failed: {last_error(result)}")
    return result.stdout.splitlines()[0] if result.stdout.splitlines() else tool


def scorer_build_configuration(tool):
    result = sh([tool, "-buildconf"])
    if result.returncode != 0:
        raise BenchError(f"{tool} -buildconf failed: {last_error(result)}")
    lines = result.stdout.splitlines()
    for index, line in enumerate(lines):
        if line.strip().startswith("configuration:"):
            value = line.strip()
            if value == "configuration:" and index + 1 < len(lines):
                value += " " + lines[index + 1].strip()
            return value
    return "unreported"


def libvmaf_fingerprint(tool, probe_diagnostics):
    result = sh([tool, "-hide_banner", "-h", "filter=libvmaf"])
    if result.returncode != 0:
        raise BenchError(f"cannot fingerprint scorer libvmaf filter: {last_error(result)}")
    help_text = result.stdout or result.stderr
    return {
        "filter_help_sha256": hashlib.sha256(help_text.encode()).hexdigest(),
        "probe_diagnostics": probe_diagnostics,
    }


def sha256_file(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as source:
        while chunk := source.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def last_error(result, lines=12):
    text = (result.stderr or result.stdout or "no diagnostic output").strip()
    return "\n".join(text.splitlines()[-lines:])


def positive_number(value, field_name):
    if (
        isinstance(value, bool)
        or not isinstance(value, (int, float))
        or not math.isfinite(value)
        or value <= 0
    ):
        raise BenchError(f"{field_name} must be a positive number")
    return float(value)


def load_rate_control_corpus(path):
    """Load fixture identity and trim only; production owns all encoder args."""
    corpus_path = Path(path)
    try:
        manifest_bytes = corpus_path.read_bytes()
        document = json.loads(manifest_bytes)
    except (OSError, json.JSONDecodeError) as error:
        raise BenchError(f"cannot read corpus {path}: {error}") from error
    if not isinstance(document, dict) or document.get("version") != RATE_CONTROL_SCHEMA_VERSION:
        raise BenchError(
            f"corpus version must be {RATE_CONTROL_SCHEMA_VERSION}"
        )
    purpose = document.get("purpose")
    if purpose not in ("vbr_smoke", "n1_acceptance"):
        raise BenchError("corpus purpose must be 'vbr_smoke' or 'n1_acceptance'")

    fixtures = document.get("fixtures")
    if not isinstance(fixtures, list) or not fixtures:
        raise BenchError("corpus fixtures must be a non-empty array")
    seen = set()
    normalized_fixtures = []
    for index, fixture in enumerate(fixtures):
        where = f"fixtures[{index}]"
        if not isinstance(fixture, dict):
            raise BenchError(f"{where} must be an object")
        identity = fixture.get("identity")
        if not isinstance(identity, str) or not NAME.fullmatch(identity):
            raise BenchError(f"{where}.identity must be filename-safe")
        if identity in seen:
            raise BenchError(f"duplicate fixture identity {identity!r}")
        seen.add(identity)
        content_class = fixture.get("class")
        if content_class not in ("easy", "hard"):
            raise BenchError(f"{where}.class must be 'easy' or 'hard'")
        if fixture.get("dynamic_range") != "sdr":
            raise BenchError(f"{where}.dynamic_range must explicitly be 'sdr'")
        filename = fixture.get("filename")
        if not isinstance(filename, str) or Path(filename).name != filename:
            raise BenchError(f"{where}.filename must be one server-visible filename")
        reference = fixture.get("reference")
        if not isinstance(reference, str) or not reference:
            raise BenchError(f"{where}.reference must be a path")
        resolved = (corpus_path.parent / reference).resolve()
        if not resolved.is_file():
            raise BenchError(f"{where}.reference does not exist: {resolved}")
        trim = fixture.get("trim")
        if not isinstance(trim, dict):
            raise BenchError(f"{where}.trim must be an object")
        start = trim.get("start_seconds")
        if (
            isinstance(start, bool)
            or not isinstance(start, (int, float))
            or not math.isfinite(start)
            or start < 0
        ):
            raise BenchError(f"{where}.trim.start_seconds must be zero or positive")
        duration = positive_number(trim.get("duration_seconds"), f"{where}.trim.duration_seconds")
        rung = fixture.get("rung")
        if isinstance(rung, bool) or not isinstance(rung, int) or rung <= 0:
            raise BenchError(f"{where}.rung must be a positive integer height")
        stat = resolved.stat()
        expected_sha256 = fixture.get("reference_sha256")
        if expected_sha256 is not None:
            if (
                not isinstance(expected_sha256, str)
                or not re.fullmatch(r"[0-9a-f]{64}", expected_sha256)
            ):
                raise BenchError(f"{where}.reference_sha256 must be lowercase SHA-256 or null")
        actual_sha256 = sha256_file(resolved)
        if expected_sha256 is not None and actual_sha256 != expected_sha256:
            raise BenchError(
                f"{where}.reference_sha256 mismatch: expected {expected_sha256}, "
                f"got {actual_sha256}"
            )
        normalized_fixtures.append({
            "identity": identity,
            "class": content_class,
            "dynamic_range": "sdr",
            "filename": filename,
            "reference": reference,
            "reference_path": resolved,
            "reference_size": stat.st_size,
            "reference_sha256": actual_sha256,
            "reference_sha256_pinned": expected_sha256 is not None,
            "start_seconds": float(start),
            "duration_seconds": duration,
            "rung": rung,
        })
    if purpose == "n1_acceptance":
        unpinned = [
            fixture["identity"]
            for fixture in normalized_fixtures
            if not fixture["reference_sha256_pinned"]
        ]
        if unpinned:
            raise BenchError(
                "n1_acceptance requires pinned reference_sha256 for every fixture: "
                + ", ".join(unpinned)
            )
        unique_contracts = (
            ("server filename", lambda fixture: fixture["filename"]),
            ("resolved reference path", lambda fixture: str(fixture["reference_path"])),
            ("pinned reference SHA-256", lambda fixture: fixture["reference_sha256"]),
        )
        for label, value_for in unique_contracts:
            owners = {}
            for fixture in normalized_fixtures:
                value = value_for(fixture)
                previous = owners.get(value)
                if previous is not None:
                    raise BenchError(
                        f"n1_acceptance requires a unique {label} per fixture: "
                        f"{previous!r} and {fixture['identity']!r} duplicate {value!r}"
                    )
                owners[value] = fixture["identity"]
        easy = sum(fixture["class"] == "easy" for fixture in normalized_fixtures)
        hard = sum(fixture["class"] == "hard" for fixture in normalized_fixtures)
        if easy < 1 or hard < 1 or easy != hard:
            raise BenchError(
                "n1_acceptance requires nonempty, equal easy and hard fixture halves"
            )
    return {
        "purpose": purpose,
        "manifest_sha256": hashlib.sha256(manifest_bytes).hexdigest(),
        "fixtures": normalized_fixtures,
    }


def load_server_sha256_manifest(path):
    """Parse an operator-captured server sha256sum file without server API changes."""
    manifest_path = Path(path)
    try:
        manifest_bytes = manifest_path.read_bytes()
        text = manifest_bytes.decode("utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise BenchError(f"cannot read server SHA-256 manifest {path}: {error}") from error
    by_filename = {}
    for line_number, raw in enumerate(text.splitlines(), 1):
        if not raw:
            continue
        match = SHA256SUM_LINE.fullmatch(raw)
        if match is None:
            raise BenchError(f"invalid sha256sum line {line_number} in {path}")
        digest, server_path = match.groups()
        filename = Path(server_path).name
        if not NAME.fullmatch(filename):
            raise BenchError(f"unsafe server filename on sha256sum line {line_number}")
        if filename in by_filename:
            raise BenchError(f"duplicate server SHA-256 entry for {filename}")
        by_filename[filename] = digest
    if not by_filename:
        raise BenchError("server SHA-256 manifest has no entries")
    return {
        "manifest": manifest_path.name,
        "manifest_sha256": hashlib.sha256(manifest_bytes).hexdigest(),
        "by_filename": by_filename,
    }


def probe_vmaf_scorer(ffmpeg, model):
    """Execute the scoring-only filter; filter-list and version checks lie."""
    graph = f"[0:v][1:v]libvmaf=model=version={model}:n_subsample=1"
    result = sh([
        ffmpeg,
        "-hide_banner",
        "-loglevel",
        "info",
        "-f",
        "lavfi",
        "-i",
        "color=black:size=640x360:rate=1:duration=1",
        "-f",
        "lavfi",
        "-i",
        "color=black:size=640x360:rate=1:duration=1",
        "-lavfi",
        graph,
        "-frames:v",
        "1",
        "-f",
        "null",
        "-",
    ])
    if result.returncode != 0:
        raise BenchError(
            f"VMAF scorer cannot execute libvmaf model {model!r}: {last_error(result)}"
        )
    matches = VMAF_SCORE.findall(result.stderr)
    if len(matches) != 1:
        raise BenchError(
            f"VMAF scorer behavior probe emitted {len(matches)} scores; expected exactly one"
        )
    try:
        score = float(matches[0])
    except ValueError as error:
        raise BenchError("VMAF scorer behavior probe emitted a nonnumeric score") from error
    if not math.isfinite(score):
        raise BenchError("VMAF scorer behavior probe emitted a non-finite score")
    fingerprint = []
    for line in result.stderr.splitlines():
        if "libvmaf" in line.lower() and "VMAF score:" not in line:
            normalized = line.strip()
            if normalized not in fingerprint:
                fingerprint.append(normalized)
    return {"score": score, "diagnostics": fingerprint[:8]}


def score_vmaf(ffmpeg, distorted, reference, reference_start, duration, model, n_subsample):
    """Decode captured production bytes and a trimmed reference; encode nothing."""
    graph = (
        f"[0:v]trim=duration={duration:.6f},setpts=PTS-STARTPTS,format=yuv420p[dist0];"
        f"[1:v]trim=start={reference_start:.6f}:duration={duration:.6f},"
        "setpts=PTS-STARTPTS[ref0];"
        "[ref0][dist0]scale2ref=flags=bicubic[ref1][dist1];"
        "[dist1]format=yuv420p[dist];[ref1]format=yuv420p[ref];"
        f"[dist][ref]libvmaf=model=version={model}:n_subsample={n_subsample}"
    )
    result = sh([
        ffmpeg,
        "-hide_banner",
        "-loglevel",
        "info",
        "-i",
        str(distorted),
        "-i",
        str(reference),
        "-lavfi",
        graph,
        "-an",
        "-f",
        "null",
        "-",
    ])
    if result.returncode != 0:
        raise BenchError(f"scoring-only VMAF failed for {distorted}: {last_error(result)}")
    matches = VMAF_SCORE.findall(result.stderr)
    if len(matches) != 1:
        raise BenchError(
            f"scoring-only libvmaf emitted {len(matches)} scores for {distorted}; "
            "expected exactly one"
        )
    try:
        score = float(matches[0])
    except ValueError as error:
        raise BenchError(
            f"scoring-only libvmaf emitted a nonnumeric score for {distorted}"
        ) from error
    if not math.isfinite(score):
        raise BenchError(f"scoring-only libvmaf emitted a non-finite score for {distorted}")
    return score


def rolling_segment_peak(segments, window_seconds):
    """Mirror scripts/perf-report: complete served segments, complete windows."""
    peak_kbps, peak_at = 0.0, None
    elapsed = 0.0
    starts = []
    for segment in segments:
        starts.append(elapsed)
        elapsed += segment["duration_seconds"]
    for left in range(len(segments)):
        bits, seconds = 0, 0.0
        for segment in segments[left:]:
            bits += segment["bytes"] * 8
            seconds += segment["duration_seconds"]
            if seconds >= window_seconds:
                break
        if seconds + 1e-6 < window_seconds:
            break
        rate = bits / seconds / 1000
        if rate > peak_kbps:
            peak_kbps, peak_at = rate, starts[left]
    if peak_at is None:
        raise BenchError(
            f"less than one complete {window_seconds:g}s served-segment window was captured"
        )
    return peak_kbps, peak_at


def rate_limits(rung, window_seconds):
    """Record the advertised peak gate and the nonbinding VBV diagnostics."""
    advertised_total = positive_number(rung.get("total_kbps"), "ladder.total_kbps")
    advertised_peak = positive_number(rung.get("peak_kbps"), "ladder.peak_kbps")
    # Current StartResponse rungs define total=video+audio and
    # peak=1.5*video+audio. Solving those equations avoids a second ladder
    # table in the harness. It is interpretation only and never creates flags.
    nominal = 2 * (advertised_peak - advertised_total)
    audio = advertised_total - nominal
    if nominal <= 0 or audio < 0:
        raise BenchError("server advertised an internally inconsistent ladder rung")
    video_maxrate = advertised_peak - audio
    video_bufsize = nominal * 2
    bufsize_window = video_bufsize / video_maxrate
    limits = {
        "advertised_total_kbps": advertised_total,
        "derived_nominal_video_kbps": nominal,
        "derived_audio_kbps": audio,
        "video_maxrate_kbps": video_maxrate,
        "video_bufsize_kbits": video_bufsize,
        "bufsize_window_seconds": bufsize_window,
        "bufsize_window_derivation": "derived video_bufsize_kbits / video_maxrate_kbps",
        "bufsize_assumption": (
            "scripts/perf-report diagnostic interpretation: 2x derived nominal video; "
            "not read from StartResponse and never used to encode"
        ),
        "window_seconds": window_seconds,
        "theoretical_vbv_allowance_kbps": video_maxrate + video_bufsize / window_seconds,
        "theoretical_vbv_window_seconds": window_seconds,
        "theoretical_vbv_role": "diagnostic_nonbinding",
        "advertised_peak_kbps": advertised_peak,
        "advertised_peak_role": (
            "binding_limit_for_10_second_complete_served_segment_peak"
            if window_seconds == RATE_CONTROL_ACCEPTANCE_RATE_WINDOW
            else "reference_only_for_nonacceptance_window"
        ),
        "peak_contract_status": RATE_CONTROL_PEAK_CONTRACT_STATUS,
    }
    if window_seconds == RATE_CONTROL_ACCEPTANCE_RATE_WINDOW:
        limits["binding_gate"] = {
            "measurement": "peak_window_kbps",
            "window_seconds": RATE_CONTROL_ACCEPTANCE_RATE_WINDOW,
            "comparison": "less_than_or_equal",
            "limit": "advertised_peak_kbps",
            "scope": "full_n1_vbr_qvbr_acceptance",
        }
    return limits


def safe_server_url(base):
    parsed = urllib.parse.urlsplit(base)
    host = parsed.hostname or "unknown"
    port = f":{parsed.port}" if parsed.port else ""
    return f"{parsed.scheme or 'http'}://{host}{port}"


def redacted_error_detail(error, args):
    detail = str(error)
    token = getattr(args, "token", None)
    if token:
        detail = detail.replace(token, "<redacted-token>")
    parsed_base = urllib.parse.urlsplit(getattr(args, "base", ""))
    for credential in (parsed_base.username, parsed_base.password):
        if credential:
            detail = detail.replace(credential, "<redacted-credential>")
    return detail


def resolve_fixture_file_ids(api, fixtures, library_id, server_hashes=None):
    if library_id is None:
        libraries = api.call("/libraries")
        if len(libraries) != 1:
            raise BenchError("more than one library — pass --library ID")
        library_id = libraries[0]["id"]
    items = api.call(f"/libraries/{library_id}/items")
    by_filename = {}
    duplicates = set()
    for item in items.get("items", []):
        detail = api.call(f"/items/{item['id']}")
        for media_file in detail.get("files", []):
            filename = media_file.get("filename")
            if filename in by_filename:
                duplicates.add(filename)
            else:
                by_filename[filename] = media_file
    for fixture in fixtures:
        filename = fixture["filename"]
        if filename in duplicates:
            raise BenchError(f"fixture filename is ambiguous in library {library_id}: {filename}")
        if filename not in by_filename:
            raise BenchError(f"fixture is not in library {library_id}: {filename}")
        server_file = by_filename[filename]
        if server_file.get("probed") is not True:
            raise BenchError(f"server fixture is not definitively probed: {filename}")
        if server_file.get("available") is not True:
            raise BenchError(f"server fixture is not definitively available: {filename}")
        if "hdr" not in server_file:
            raise BenchError(f"server dynamic-range fact is unknown for {filename}")
        server_hdr = server_file["hdr"]
        if server_hdr is not None and str(server_hdr).lower() != "sdr":
            raise BenchError(f"server fixture is not SDR: {filename} hdr={server_hdr!r}")
        size = server_file.get("size")
        if isinstance(size, bool) or not isinstance(size, int) or size <= 0:
            raise BenchError(f"server fixture has no usable size fact: {filename}")
        if size != fixture["reference_size"]:
            raise BenchError(
                f"fixture {filename} differs between controller and server: "
                f"local {fixture['reference_size']} bytes, server {server_file.get('size')} bytes"
            )
        video_codec = server_file.get("video_codec")
        if not isinstance(video_codec, str) or not video_codec.strip():
            raise BenchError(f"server fixture has no usable video_codec fact: {filename}")
        for field in ("width", "height", "bit_depth"):
            value = server_file.get(field)
            if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
                raise BenchError(f"server fixture has no usable {field} fact: {filename}")
        server_duration_ms = server_file.get("duration_ms")
        if (
            isinstance(server_duration_ms, bool)
            or not isinstance(server_duration_ms, int)
            or server_duration_ms <= 0
        ):
            raise BenchError(f"server fixture has no usable duration_ms fact: {filename}")
        required_end_ms = round(
            (fixture["start_seconds"] + fixture["duration_seconds"]) * 1000
        )
        if server_duration_ms < required_end_ms:
            raise BenchError(
                f"fixture trim ends at {required_end_ms}ms but server file {filename} "
                f"ends at {server_duration_ms}ms"
            )
        server_sha256 = None
        if server_hashes is not None:
            server_sha256 = server_hashes.get(filename)
            if server_sha256 is None:
                raise BenchError(f"server SHA-256 manifest is missing {filename}")
            if server_sha256 != fixture["reference_sha256"]:
                raise BenchError(
                    f"server SHA-256 differs from pinned controller reference for {filename}"
                )
        fixture["file_id"] = server_file["id"]
        # The browse API intentionally has no source digest. Size and media
        # facts are therefore the strongest cross-machine identity available;
        # the controller's full SHA-256 remains recorded separately.
        fixture["server_file_identity"] = {
            key: server_file.get(key)
            for key in (
                "id", "filename", "size", "probed", "available", "duration_ms", "container",
                "video_codec", "width", "height", "bit_depth", "hdr",
            )
        }
        fixture["server_sha256"] = server_sha256
    return library_id


def active_transcodes(api):
    value = api.call("/system").get("active_transcodes")
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise BenchError("server did not report a valid active_transcodes count")
    return value


def require_server_idle(api, action):
    count = active_transcodes(api)
    if count != 0:
        raise BenchError(
            f"server has {count} active transcode(s) before {action}; "
            "maintenance-node exclusivity was lost"
        )


def wait_for_server_idle(api, action, poll_seconds, timeout_seconds):
    deadline = time.monotonic() + timeout_seconds
    last_count = None
    while True:
        if last_count is not None and time.monotonic() >= deadline:
            raise BenchError(
                f"server still has {last_count} active transcode(s) after {action}; idle timeout"
            )
        count = active_transcodes(api)
        if count == 0:
            return
        last_count = count
        now = time.monotonic()
        if now >= deadline:
            raise BenchError(
                f"server still has {count} active transcode(s) after {action}; idle timeout"
            )
        sleep(min(poll_seconds, max(0, deadline - now)))


def capture_disk_preflight(path, fixture):
    """Refuse a capture that could consume the controller's last free space."""
    free = shutil.disk_usage(path).free
    # Preflight runs before StartResponse gives us an advertised rung. A
    # conservative 100 Mb/s estimate is intentionally not an encoder recipe.
    estimated = math.ceil(100_000_000 / 8 * fixture["duration_seconds"])
    required = MIN_CAPTURE_FREE_BYTES + estimated
    if free < required:
        raise BenchError(
            f"insufficient controller disk for {fixture['identity']}: "
            f"{free} bytes free, {required} required"
        )
    return {
        "free_bytes_before": free,
        "estimated_capture_bytes_with_overshoot": estimated,
        "reserved_free_bytes": MIN_CAPTURE_FREE_BYTES,
    }


def cleanup_capture(capture):
    """Remove only the generated files named in one controlled capture."""
    playlist = capture["playlist_path"]
    capture_dir = playlist.parent
    for segment in capture["segments"]:
        (capture_dir / segment["local_name"]).unlink(missing_ok=True)
    playlist.unlink(missing_ok=True)
    capture_dir.rmdir()


def local_capture_playlist(path, segments):
    target = max(1, math.ceil(max(segment["duration_seconds"] for segment in segments)))
    lines = [
        "#EXTM3U",
        "#EXT-X-VERSION:3",
        f"#EXT-X-TARGETDURATION:{target}",
        "#EXT-X-MEDIA-SEQUENCE:0",
        "#EXT-X-PLAYLIST-TYPE:VOD",
    ]
    for segment in segments:
        lines.extend([f"#EXTINF:{segment['duration_seconds']:.6f},", segment["local_name"]])
    lines.append("#EXT-X-ENDLIST")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def capture_live_session(
    api,
    fixture,
    mode,
    work_dir,
    poll_seconds,
    timeout_seconds,
    idle_timeout_seconds,
    expected_encoder,
):
    """Capture only bytes served by one uncached production HLS session."""
    require_server_idle(api, f"capturing {fixture['identity']}/{mode}")
    info = api.call(f"/files/{fixture['file_id']}/hls/sessions", "POST", {
        "playback_id": f"bench-rate-{os.getpid()}-{mode}-{fixture['identity']}",
        "request_id": f"bench-rate-{time.time_ns()}",
        "height": fixture["rung"],
        "start": fixture["start_seconds"],
    })
    session_id = info["session_id"]
    capture_dir = None
    capture_dir_created = False
    ordered = []
    try:
        encoder = info.get("encoder") or "unknown"
        if info.get("vod") or encoder == "cached":
            raise BenchError(
                f"{fixture['identity']}/{mode} was served from cached VOD; no production encode ran"
            )
        if encoder == "copy":
            raise BenchError(f"{fixture['identity']}/{mode} copied video instead of transcoding")
        if encoder != expected_encoder:
            raise BenchError(
                f"{fixture['identity']}/{mode} used encoder {encoder!r}; "
                f"/system selected {expected_encoder!r}"
            )
        delivered_dynamic_range = info.get("delivered_dynamic_range")
        if delivered_dynamic_range != "sdr":
            raise BenchError(
                f"{fixture['identity']}/{mode} did not prove SDR delivery: "
                f"{delivered_dynamic_range!r}"
            )

        requested_origin_ms = round(fixture["start_seconds"] * 1000)
        origin_ms = info.get("media_origin_ms")
        if origin_ms is None:
            # Safe only because this function explicitly requested a transcode
            # and rejected both copy and cached sessions above.
            origin_ms = requested_origin_ms
            origin_source = "manifest_start_legacy_transcode"
        else:
            origin_ms = int(origin_ms)
            origin_source = "start_response.media_origin_ms"
        if abs(origin_ms - requested_origin_ms) > ORIGIN_TOLERANCE_MS:
            raise BenchError(
                f"{fixture['identity']}/{mode} media_origin_ms {origin_ms} disagrees with "
                f"manifest start {requested_origin_ms} by more than {ORIGIN_TOLERANCE_MS}ms"
            )

        rung = next(
            (candidate for candidate in info.get("ladder", [])
             if candidate.get("height") == fixture["rung"]),
            None,
        )
        if rung is None:
            raise BenchError(
                f"server response did not advertise requested rung {fixture['rung']}"
            )

        capture_dir = work_dir / f"{fixture['identity']}-{mode}"
        if capture_dir.exists():
            raise BenchError(
                f"capture directory already exists; remove it or choose --work-dir: {capture_dir}"
            )
        capture_dir.mkdir(parents=True)
        capture_dir_created = True
        captured = {}
        speed_samples = []
        status_encoders = set()
        media_seconds = 0.0
        started = time.monotonic()
        deadline = started + timeout_seconds
        while media_seconds + 1e-6 < fixture["duration_seconds"]:
            if time.monotonic() >= deadline:
                raise BenchError(
                    f"{fixture['identity']}/{mode} captured {media_seconds:.3f}s before timeout"
                )
            playlist = api.fetch(f"/hls/{session_id}/index.m3u8").decode("utf-8", "replace")
            for source_uri, duration in parse_playlist(playlist):
                if source_uri in captured:
                    continue
                if not SAFE_SEGMENT.fullmatch(source_uri) or ".." in source_uri:
                    raise BenchError("server playlist contained an unsafe segment URI")
                blob = api.fetch(f"/hls/{session_id}/{source_uri}")
                if not blob:
                    raise BenchError(f"server returned an empty HLS segment: {source_uri}")
                suffix = Path(source_uri).suffix if Path(source_uri).suffix else ".bin"
                local_name = f"segment-{len(ordered):05d}{suffix}"
                (capture_dir / local_name).write_bytes(blob)
                segment = {
                    "local_name": local_name,
                    "duration_seconds": float(duration),
                    "bytes": len(blob),
                }
                captured[source_uri] = segment
                ordered.append(segment)
                media_seconds += float(duration)
                if media_seconds + 1e-6 >= fixture["duration_seconds"]:
                    break
            status = api.call(f"/hls/{session_id}/status")
            status_encoder = status.get("encoder")
            if not isinstance(status_encoder, str) or not status_encoder:
                raise BenchError(
                    f"{fixture['identity']}/{mode} status did not report encoder identity"
                )
            status_encoders.add(status_encoder)
            if status_encoder != encoder:
                raise BenchError(
                    f"{fixture['identity']}/{mode} encoder changed from StartResponse "
                    f"{encoder!r} to status {status_encoder!r}"
                )
            speed = status.get("recent_speed")
            if speed is not None:
                if (
                    isinstance(speed, bool)
                    or not isinstance(speed, (int, float))
                    or not math.isfinite(speed)
                    or speed <= 0
                ):
                    raise BenchError(
                        f"{fixture['identity']}/{mode} status reported invalid recent_speed"
                    )
                speed_samples.append(float(speed))
            if media_seconds + 1e-6 < fixture["duration_seconds"]:
                sleep(poll_seconds)

        if len(ordered) < 3:
            raise BenchError(f"{fixture['identity']}/{mode} produced fewer than three segments")
        if status_encoders != {encoder}:
            raise BenchError(f"{fixture['identity']}/{mode} has no stable status encoder identity")
        playlist_path = capture_dir / "capture.m3u8"
        local_capture_playlist(playlist_path, ordered)
        return {
            "encoder": encoder,
            "status_encoder": encoder,
            "delivered_dynamic_range": delivered_dynamic_range,
            "media_origin_ms": origin_ms,
            "media_origin_source": origin_source,
            "captured_media_seconds": media_seconds,
            "capture_wall_seconds": time.monotonic() - started,
            "bytes": sum(segment["bytes"] for segment in ordered),
            "segments": ordered,
            "speed_samples": speed_samples,
            "ladder_rung": rung,
            "playlist_path": playlist_path,
        }
    except Exception:
        if capture_dir_created and capture_dir is not None and capture_dir.is_dir():
            for segment in ordered:
                (capture_dir / segment["local_name"]).unlink(missing_ok=True)
            (capture_dir / "capture.m3u8").unlink(missing_ok=True)
            capture_dir.rmdir()
        raise
    finally:
        try:
            api.call(f"/hls/{session_id}", "DELETE")
            wait_for_server_idle(
                api,
                f"deleting {fixture['identity']}/{mode}",
                poll_seconds,
                idle_timeout_seconds,
            )
        except Exception:
            if capture_dir_created and capture_dir is not None and capture_dir.is_dir():
                for segment in ordered:
                    (capture_dir / segment["local_name"]).unlink(missing_ok=True)
                (capture_dir / "capture.m3u8").unlink(missing_ok=True)
                capture_dir.rmdir()
            raise


def percentile(values, percent):
    if not values:
        return None
    ordered = sorted(values)
    index = max(0, min(len(ordered) - 1, int(round(percent / 100 * (len(ordered) - 1)))))
    return ordered[index]


def setting_contract(settings):
    if RATE_MODE_FIELD not in settings or QUALITY_FIELD not in settings:
        raise BenchError(
            "server has no N1 rate-mode/quality settings contract; use --modes vbr on current main"
        )
    return {
        "rate_field": RATE_MODE_FIELD,
        "quality_field": QUALITY_FIELD,
        "original_rate": settings[RATE_MODE_FIELD],
        "original_quality": settings[QUALITY_FIELD],
    }


def update_rate_setting(api, contract, mode, quality=None):
    require_server_idle(api, f"setting rate-control mode to {mode}")
    expected_rate = "bitrate" if mode == "vbr" else "quality"
    body = {
        contract["rate_field"]: expected_rate,
        contract["quality_field"]: quality,
    }
    returned = api.call("/settings", "PUT", body)
    if returned.get(contract["rate_field"]) != expected_rate:
        raise BenchError(f"server did not apply requested {expected_rate} rate mode")
    if returned.get(contract["quality_field"]) != quality:
        raise BenchError("server did not apply requested quality override")
    return {
        "requested_mode": mode,
        "requested_settings": body,
        "verified_settings_response": {
            contract["rate_field"]: returned.get(contract["rate_field"]),
            contract["quality_field"]: returned.get(contract["quality_field"]),
        },
        "evidence_scope": (
            "settings_dto_acknowledgement_only; does not prove effective encoder flags or fallback"
        ),
    }


def restore_rate_settings(api, contract, poll_seconds, idle_timeout_seconds):
    wait_for_server_idle(
        api,
        "waiting to restore original rate-control settings",
        poll_seconds,
        idle_timeout_seconds,
    )
    body = {
        contract["rate_field"]: contract["original_rate"],
        contract["quality_field"]: contract["original_quality"],
    }
    returned = api.call("/settings", "PUT", body)
    if returned.get(contract["rate_field"]) != contract["original_rate"]:
        raise BenchError("server did not restore original rate mode")
    if returned.get(contract["quality_field"]) != contract["original_quality"]:
        raise BenchError("server did not restore original quality override")
    return body


def evaluate_rate_control(fixture_rows):
    """Apply the owner-ratified full N1 comparison gates."""
    failures = []
    for fixture in fixture_rows:
        name = fixture["identity"]
        if set(fixture["modes"]) == set(RATE_CONTROL_FULL_MODES):
            vbr, qvbr = fixture["modes"]["vbr"], fixture["modes"]["qvbr"]
            vbr_limits = vbr.get("limits")
            qvbr_limits = qvbr.get("limits")
            baseline_ladder = {
                field: vbr_limits.get(field) if isinstance(vbr_limits, dict) else None
                for field in LADDER_IDENTITY_FIELDS
            }
            candidate_ladder = {
                field: qvbr_limits.get(field) if isinstance(qvbr_limits, dict) else None
                for field in LADDER_IDENTITY_FIELDS
            }
            if (
                any(value is None for value in baseline_ladder.values())
                or any(value is None for value in candidate_ladder.values())
                or baseline_ladder != candidate_ladder
            ):
                failures.append({
                    "code": "ladder_identity_mismatch",
                    "fixture": name,
                    "baseline": baseline_ladder,
                    "candidate": candidate_ladder,
                })
        if set(fixture["modes"]) != set(RATE_CONTROL_FULL_MODES):
            continue
        vbr, qvbr = fixture["modes"]["vbr"], fixture["modes"]["qvbr"]
        if vbr["production_encoder"] != qvbr["production_encoder"]:
            failures.append({
                "code": "encoder_identity_mismatch",
                "fixture": name,
                "baseline": vbr["production_encoder"],
                "candidate": qvbr["production_encoder"],
            })
        if abs(qvbr["captured_media_seconds"] - vbr["captured_media_seconds"]) > 0.050:
            failures.append({
                "code": "duration_mismatch",
                "fixture": name,
                "baseline_seconds": round(vbr["captured_media_seconds"], 6),
                "candidate_seconds": round(qvbr["captured_media_seconds"], 6),
            })
        for mode, measured in (("vbr", vbr), ("qvbr", qvbr)):
            measured_limits = measured.get("limits")
            evidence = {
                "peak_window_kbps": measured.get("peak_window_kbps"),
                "peak_window_seconds": measured.get("peak_window_seconds"),
                "advertised_peak_kbps": (
                    measured_limits.get("advertised_peak_kbps")
                    if isinstance(measured_limits, dict)
                    else None
                ),
            }
            invalid = []
            for field, value in evidence.items():
                if (
                    isinstance(value, bool)
                    or not isinstance(value, (int, float))
                    or not math.isfinite(value)
                    or value <= 0
                ):
                    invalid.append(field)
            if (
                "peak_window_seconds" not in invalid
                and evidence["peak_window_seconds"]
                != RATE_CONTROL_ACCEPTANCE_RATE_WINDOW
            ):
                invalid.append("peak_window_seconds")
            if invalid:
                failures.append({
                    "code": "peak_evidence_invalid",
                    "fixture": name,
                    "mode": mode,
                    "invalid_fields": invalid,
                    "observed": {
                        field: repr(evidence[field])
                        for field in invalid
                    },
                    "required_window_seconds": RATE_CONTROL_ACCEPTANCE_RATE_WINDOW,
                })
            elif evidence["peak_window_kbps"] > evidence["advertised_peak_kbps"]:
                failures.append({
                    "code": "advertised_peak_exceeded",
                    "fixture": name,
                    "mode": mode,
                    "observed_kbps": round(evidence["peak_window_kbps"], 3),
                    "limit_kbps": round(evidence["advertised_peak_kbps"], 3),
                    "window_seconds": RATE_CONTROL_ACCEPTANCE_RATE_WINDOW,
                })
        if qvbr["vmaf"] + 1e-9 < vbr["vmaf"]:
            failures.append({
                "code": "vmaf_regression",
                "fixture": name,
                "baseline": round(vbr["vmaf"], 6),
                "candidate": round(qvbr["vmaf"], 6),
            })
        if fixture["class"] == "easy" and qvbr["bytes"] > vbr["bytes"]:
            failures.append({
                "code": "easy_bytes_regression",
                "fixture": name,
                "baseline": vbr["bytes"],
                "candidate": qvbr["bytes"],
            })
        speed_values = {
            "vbr": vbr.get("speed_p10"),
            "qvbr": qvbr.get("speed_p10"),
        }
        speed_unusable = False
        for mode, value in speed_values.items():
            if (
                isinstance(value, bool)
                or not isinstance(value, (int, float))
                or not math.isfinite(value)
            ):
                failures.append({
                    "code": "speed_invalid",
                    "fixture": name,
                    "mode": mode,
                    "observed": repr(value),
                })
                speed_unusable = True
            elif value <= 0:
                failures.append({
                    "code": "speed_nonpositive",
                    "fixture": name,
                    "mode": mode,
                    "observed": value,
                })
                speed_unusable = True
        if speed_unusable:
            continue
        if qvbr["speed_p10"] + 1e-9 < vbr["speed_p10"] * 0.90:
            failures.append({
                "code": "speed_regression",
                "fixture": name,
                "baseline": round(vbr["speed_p10"], 6),
                "candidate": round(qvbr["speed_p10"], 6),
                "minimum": round(vbr["speed_p10"] * 0.90, 6),
            })
    return failures


def measured_capture(capture, fixture, scorer, model, n_subsample, rate_window):
    limits = rate_limits(capture["ladder_rung"], rate_window)
    peak, peak_at = rolling_segment_peak(capture["segments"], rate_window)
    bufsize_peak, bufsize_peak_at = rolling_segment_peak(
        capture["segments"],
        limits["bufsize_window_seconds"],
    )
    limits["requested_height"] = fixture["rung"]
    limits["advertised_height"] = capture["ladder_rung"].get("height")
    vmaf = score_vmaf(
        scorer,
        capture["playlist_path"],
        fixture["reference_path"],
        capture["media_origin_ms"] / 1000,
        capture["captured_media_seconds"],
        model,
        n_subsample,
    )
    return {
        "production_encoder": capture["encoder"],
        "start_response_encoder": capture["encoder"],
        "status_encoder": capture["status_encoder"],
        "delivered_dynamic_range": capture["delivered_dynamic_range"],
        "media_origin_ms": capture["media_origin_ms"],
        "media_origin_source": capture["media_origin_source"],
        "captured_media_seconds": round(capture["captured_media_seconds"], 6),
        "capture_wall_seconds": round(capture["capture_wall_seconds"], 6),
        "segment_count": len(capture["segments"]),
        "bytes": capture["bytes"],
        "speed_p10": percentile(capture["speed_samples"], 10),
        "speed_p50": percentile(capture["speed_samples"], 50),
        "vmaf": round(vmaf, 6),
        "peak_window_kbps": round(peak, 3),
        "peak_window_start_seconds": round(peak_at, 6),
        "peak_window_seconds": rate_window,
        "peak_window_role": (
            "complete_served_segment_10_second_peak_measurement"
            if rate_window == RATE_CONTROL_ACCEPTANCE_RATE_WINDOW
            else "configured_complete_served_segment_window_nonacceptance"
        ),
        "bufsize_window_peak_kbps": round(bufsize_peak, 3),
        "bufsize_window_peak_start_seconds": round(bufsize_peak_at, 6),
        "bufsize_window_peak_role": "diagnostic_nonbinding_derived_bufsize_window",
        "limits": limits,
        "capture_playlist": capture["playlist_path"].name,
    }


def empty_rate_control_report(modes, model, n_subsample):
    return {
        "schema_version": RATE_CONTROL_SCHEMA_VERSION,
        "kind": "perf2-rate-control",
        "passed": False,
        "modes": list(modes),
        "corpus": None,
        "acceptance": None,
        "measurement_parameters": None,
        "mode_settings": {},
        "controller": {
            "host": socket.gethostname(),
            "role": "session_controller_and_offline_score_runner",
        },
        "production": None,
        "vmaf_scorer": {
            "role": "scoring_only_never_production_encoding",
            "host": socket.gethostname(),
            "path": None,
            "sha256": None,
            "build": None,
            "build_configuration": None,
            "libvmaf_fingerprint": None,
            "model": model,
            "n_subsample": n_subsample,
            "behavior_probe": {"status": "not_run", "score": None},
            "production_dependency": False,
        },
        "fixtures": [],
        "failures": [],
    }


def rate_control_report(args, api=None):
    selected_modes = tuple(part.strip() for part in args.modes.split(",") if part.strip())
    if selected_modes not in (RATE_CONTROL_SMOKE_MODES, RATE_CONTROL_FULL_MODES):
        selected_modes = tuple()
    report = empty_rate_control_report(selected_modes, args.vmaf_model, args.vmaf_subsample)
    if not selected_modes:
        report["failures"].append({
            "code": "harness_error",
            "detail": "--modes must be vbr (current-main smoke) or vbr,qvbr (full N1)",
        })
        return report
    if not NAME.fullmatch(args.vmaf_model):
        report["failures"].append({
            "code": "harness_error",
            "detail": "--vmaf-model must be a model version name, not a filter expression",
        })
        return report
    if args.vmaf_subsample < 1:
        report["failures"].append({"code": "harness_error", "detail": "--vmaf-subsample must be at least 1"})
        return report
    positive_cli = (
        ("--rate-window", args.rate_window),
        ("--poll", args.poll),
        ("--capture-timeout", args.capture_timeout),
        ("--idle-timeout", args.idle_timeout),
    )
    invalid_positive = next((
        name for name, value in positive_cli
        if isinstance(value, bool)
        or not isinstance(value, (int, float))
        or not math.isfinite(value)
        or value <= 0
    ), None)
    invalid_settle = (
        isinstance(args.settings_settle, bool)
        or not isinstance(args.settings_settle, (int, float))
        or not math.isfinite(args.settings_settle)
        or args.settings_settle < 0
    )
    if invalid_positive is not None or invalid_settle:
        report["failures"].append({
            "code": "harness_error",
            "detail": (
                f"{invalid_positive} must be a finite positive number"
                if invalid_positive is not None
                else "--settings-settle must be a finite nonnegative number"
            ),
        })
        return report
    report["measurement_parameters"] = {
        "vmaf_model": args.vmaf_model,
        "vmaf_subsample": args.vmaf_subsample,
        "rate_window_seconds": float(args.rate_window),
        "poll_seconds": float(args.poll),
        "capture_timeout_seconds": float(args.capture_timeout),
        "idle_timeout_seconds": float(args.idle_timeout),
        "settings_settle_seconds": float(args.settings_settle),
    }
    if selected_modes == RATE_CONTROL_FULL_MODES:
        # Poll cadence affects the speed-sample percentile, and settling delay can
        # change the state observed after a global settings update. Pin both for
        # comparable full runs. Capture/idle timeouts only reject incomplete or
        # unsafe fixed-trim runs, so they remain configurable and are recorded.
        if args.vmaf_model != RATE_CONTROL_ACCEPTANCE_MODEL:
            report["failures"].append({
                "code": "harness_error",
                "detail": (
                    "vbr,qvbr acceptance requires "
                    f"--vmaf-model {RATE_CONTROL_ACCEPTANCE_MODEL} exactly"
                ),
            })
            return report
        if args.vmaf_subsample != RATE_CONTROL_ACCEPTANCE_VMAF_SUBSAMPLE:
            report["failures"].append({
                "code": "harness_error",
                "detail": (
                    "vbr,qvbr acceptance requires "
                    f"--vmaf-subsample {RATE_CONTROL_ACCEPTANCE_VMAF_SUBSAMPLE} exactly"
                ),
            })
            return report
        if args.rate_window != RATE_CONTROL_ACCEPTANCE_RATE_WINDOW:
            report["failures"].append({
                "code": "harness_error",
                "detail": (
                    "vbr,qvbr acceptance requires "
                    f"--rate-window {RATE_CONTROL_ACCEPTANCE_RATE_WINDOW:.1f} exactly"
                ),
            })
            return report
        if args.poll != RATE_CONTROL_ACCEPTANCE_POLL:
            report["failures"].append({
                "code": "harness_error",
                "detail": (
                    "vbr,qvbr acceptance requires "
                    f"--poll {RATE_CONTROL_ACCEPTANCE_POLL:.2f} exactly"
                ),
            })
            return report
        if args.settings_settle != RATE_CONTROL_ACCEPTANCE_SETTINGS_SETTLE:
            report["failures"].append({
                "code": "harness_error",
                "detail": (
                    "vbr,qvbr acceptance requires "
                    f"--settings-settle {RATE_CONTROL_ACCEPTANCE_SETTINGS_SETTLE:.1f} exactly"
                ),
            })
            return report

    contract = None
    try:
        corpus = load_rate_control_corpus(args.corpus)
        fixtures = corpus["fixtures"]
        report["corpus"] = {
            "manifest": Path(args.corpus).name,
            "manifest_sha256": corpus["manifest_sha256"],
            "purpose": corpus["purpose"],
            "fixture_count": len(fixtures),
            "server_sha256_manifest": None,
        }
        if selected_modes == RATE_CONTROL_FULL_MODES and corpus["purpose"] != "n1_acceptance":
            raise BenchError(
                "vbr,qvbr requires an n1_acceptance corpus; the checked-in corpus is smoke-only"
            )
        server_manifest_path = getattr(args, "server_sha256_manifest", None)
        if selected_modes == RATE_CONTROL_FULL_MODES and not server_manifest_path:
            raise BenchError("vbr,qvbr requires --server-sha256-manifest")
        server_manifest = (
            load_server_sha256_manifest(server_manifest_path)
            if server_manifest_path
            else None
        )
        if server_manifest is not None:
            report["corpus"]["server_sha256_manifest"] = {
                "manifest": server_manifest["manifest"],
                "manifest_sha256": server_manifest["manifest_sha256"],
            }
            for fixture in fixtures:
                server_digest = server_manifest["by_filename"].get(fixture["filename"])
                if server_digest is None:
                    raise BenchError(
                        f"server SHA-256 manifest is missing {fixture['filename']}"
                    )
                if server_digest != fixture["reference_sha256"]:
                    raise BenchError(
                        "server SHA-256 differs from pinned controller reference for "
                        + fixture["filename"]
                    )
        subset = bool(args.only)
        report["acceptance"] = {
            "eligible": selected_modes == RATE_CONTROL_FULL_MODES and not subset,
            "scope": (
                "diagnostic_subset_non_acceptance"
                if subset
                else (
                    "full_n1_quantitative_acceptance"
                    if selected_modes == RATE_CONTROL_FULL_MODES
                    else "vbr_smoke_non_acceptance"
                )
            ),
            "peak_contract_status": RATE_CONTROL_PEAK_CONTRACT_STATUS,
            "peak_evidence_scope": (
                "each mode's observed complete-served-segment rolling peak over exactly "
                "10 seconds is binding at or below advertised_peak_kbps; the observed "
                "derived-bufsize-window peak and theoretical 10-second VBV allowance "
                "are diagnostic and nonbinding"
            ),
            "effective_mode_evidence": (
                "settings DTO acknowledgement plus stable encoder identity only; "
                "N1 boot/production flag validation and forced-fallback evidence are separate"
            ),
            "required_vmaf_model": RATE_CONTROL_ACCEPTANCE_MODEL,
            "required_vmaf_subsample": RATE_CONTROL_ACCEPTANCE_VMAF_SUBSAMPLE,
            "required_rate_window_seconds": RATE_CONTROL_ACCEPTANCE_RATE_WINDOW,
            "required_poll_seconds": RATE_CONTROL_ACCEPTANCE_POLL,
            "required_settings_settle_seconds": RATE_CONTROL_ACCEPTANCE_SETTINGS_SETTLE,
        }
        if args.only:
            fixtures = [fixture for fixture in fixtures if fixture["identity"] == args.only]
            if not fixtures:
                raise BenchError(f"fixture {args.only!r} is not in the corpus")
            report["failures"].append({
                "code": "diagnostic_subset_not_acceptance",
                "detail": "--only is diagnostic; it cannot produce an N1 acceptance pass",
            })
        scorer = scoring_executable(args.vmaf_ffmpeg)
        probe = probe_vmaf_scorer(scorer, args.vmaf_model)
        report["vmaf_scorer"].update({
            "path": scorer,
            "sha256": sha256_file(scorer),
            "build": tool_build(scorer),
            "build_configuration": scorer_build_configuration(scorer),
            "libvmaf_fingerprint": libvmaf_fingerprint(scorer, probe["diagnostics"]),
            "behavior_probe": {"status": "passed", "score": probe["score"]},
        })
        api = api or Api(args.base, args.token)
        system = api.call("/system")
        target_encoder = system.get("encoder_selected")
        if not isinstance(target_encoder, str) or not target_encoder:
            raise BenchError("server did not report a selected production encoder")
        report["production"] = {
            "role": "production_hls_encoding_by_plurxd_only",
            "encoder_execution_host": system.get("name"),
            "server_url": safe_server_url(args.base),
            "server_name": system.get("name"),
            "server_instance_id": system.get("instance_id"),
            "plurx_version": system.get("version"),
            "plurx_build": system.get("build"),
            "plurx_built_at": system.get("built_at"),
            "production_ffmpeg_path": system.get("ffmpeg"),
            "production_ffmpeg_build": system.get("ffmpeg_version"),
            "selected_encoder": target_encoder,
            "vmaf_scorer_used_for_encoding": False,
        }
        system_active = system.get("active_transcodes")
        if (
            isinstance(system_active, bool)
            or not isinstance(system_active, int)
            or system_active < 0
        ):
            raise BenchError("server did not report a valid active_transcodes count")
        if system_active != 0:
            raise BenchError(
                "server has active transcodes; stop all playback before rate-control capture"
            )
        resolve_fixture_file_ids(
            api,
            fixtures,
            args.library,
            server_manifest["by_filename"] if server_manifest is not None else None,
        )
        work_dir = Path(args.work_dir) if args.work_dir else Path(args.json).with_suffix("").with_name(
            Path(args.json).stem + "-work"
        )
        work_dir.mkdir(parents=True, exist_ok=True)
        if selected_modes == RATE_CONTROL_FULL_MODES:
            contract = setting_contract(api.call("/settings"))
        else:
            report["mode_settings"]["vbr"] = {
                "requested_mode": "vbr",
                "requested_settings": None,
                "verified_settings_response": None,
                "evidence_scope": (
                    "current-main smoke only; no N1 settings DTO and no effective-mode claim"
                ),
            }

        for fixture in fixtures:
            report_fixture = {
                "identity": fixture["identity"],
                "class": fixture["class"],
                "declared_dynamic_range": fixture["dynamic_range"],
                "filename": fixture["filename"],
                "reference": fixture["reference"],
                "reference_size": fixture["reference_size"],
                "reference_sha256": fixture["reference_sha256"],
                "reference_sha256_pinned": fixture["reference_sha256_pinned"],
                "server_file_identity": fixture["server_file_identity"],
                "server_sha256": fixture["server_sha256"],
                "trim": {
                    "start_seconds": fixture["start_seconds"],
                    "duration_seconds": fixture["duration_seconds"],
                },
                "rung": fixture["rung"],
                "modes": {},
            }
            report["fixtures"].append(report_fixture)

        for mode in selected_modes:
            if contract is not None:
                report["mode_settings"][mode] = update_rate_setting(
                    api,
                    contract,
                    mode,
                    quality=args.quality,
                )
                sleep(args.settings_settle)
            for fixture, report_fixture in zip(fixtures, report["fixtures"]):
                print(f"rate-control {fixture['identity']} / {mode}…", flush=True)
                disk_preflight = capture_disk_preflight(work_dir, fixture)
                capture = capture_live_session(
                    api,
                    fixture,
                    mode,
                    work_dir,
                    args.poll,
                    args.capture_timeout,
                    args.idle_timeout,
                    target_encoder,
                )
                try:
                    measured = measured_capture(
                        capture,
                        fixture,
                        scorer,
                        args.vmaf_model,
                        args.vmaf_subsample,
                        args.rate_window,
                    )
                    measured["disk_preflight"] = disk_preflight
                    measured["artifacts_retained"] = args.keep_artifacts
                    measured["requested_mode"] = mode
                    measured["mode_settings_evidence"] = report["mode_settings"][mode]
                    report_fixture["modes"][mode] = measured
                finally:
                    if not args.keep_artifacts:
                        cleanup_capture(capture)
    except Exception as error:
        detail = redacted_error_detail(error, args)
        report["failures"].append({"code": "harness_error", "detail": detail})
    finally:
        if contract is not None and api is not None:
            try:
                restore_rate_settings(api, contract, args.poll, args.idle_timeout)
            except Exception as error:
                detail = redacted_error_detail(error, args)
                report["failures"].append({
                    "code": "setting_restore_failed",
                    "detail": detail,
                    "required_manual_restore": {
                        contract["rate_field"]: contract["original_rate"],
                        contract["quality_field"]: contract["original_quality"],
                    },
                })
    if report["fixtures"] and not any(failure["code"] == "harness_error" for failure in report["failures"]):
        report["failures"].extend(evaluate_rate_control(report["fixtures"]))
    report["passed"] = not report["failures"]
    return report


def write_json(path, document):
    output = Path(path)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(
        json.dumps(document, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="utf-8",
    )


def print_rate_control(report):
    binding_peak = bool((report.get("acceptance") or {}).get("eligible"))
    for fixture in report.get("fixtures", []):
        for mode, measured in fixture.get("modes", {}).items():
            limits = measured["limits"]
            peak_label = (
                f"{measured['peak_window_seconds']:g}s "
                f"{'binding' if binding_peak else 'nonacceptance'} peak"
            )
            advertised_label = (
                "advertised limit" if binding_peak else "advertised reference"
            )
            print(
                f"{fixture['identity']}/{mode}: bytes {measured['bytes']}; "
                f"VMAF {measured['vmaf']:.3f}; speed p10 {measured['speed_p10']}; "
                f"{peak_label} {measured['peak_window_kbps']:.0f} kb/s · "
                f"bufsize-window diagnostic {measured['bufsize_window_peak_kbps']:.0f} kb/s · "
                f"VBV diagnostic {limits['theoretical_vbv_allowance_kbps']:.0f} · "
                f"{advertised_label} {limits['advertised_peak_kbps']:.0f}"
            )
    if report.get("passed"):
        print("PASS: captured production HLS satisfies the selected harness gates")
    else:
        for failure in report.get("failures", []):
            print(f"FAIL: {failure}", file=sys.stderr)


def build_fixture(out_dir, name, spec):
    path = os.path.join(out_dir, f"{name}.mkv")
    if os.path.exists(path):
        print(f"  {name:14s} exists")
        return path
    src = f"testsrc2=size={spec['size']}:rate=24:duration={DURATION}"
    if spec.get("grain"):
        # Real grain, not a synthetic pattern: noise is what makes an encoder
        # spend its bit budget unevenly.
        src += ",noise=alls=40:allf=t+u"
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error",
           "-f", "lavfi", "-i", src,
           "-f", "lavfi", "-i", f"sine=frequency=440:duration={DURATION}",
           "-c:v", spec["codec"], "-preset", "ultrafast", *spec["extra"]]
    if spec["hdr"]:
        cmd += ["-color_primaries", "bt2020",
                "-color_trc", "smpte2084" if spec["hdr"] == "pq" else "arib-std-b67",
                "-colorspace", "bt2020nc"]
    else:
        cmd += ["-pix_fmt", "yuv420p"] if "-pix_fmt" not in spec["extra"] else []
    cmd += ["-c:a", "aac", "-shortest", "-y", path]
    print(f"  {name:14s} building… ({spec['why']})", flush=True)
    r = sh(cmd)
    if r.returncode != 0:
        print(f"  {name:14s} FAILED: {r.stderr.strip().splitlines()[-1:]}")
        return None
    return path


class Api:
    def __init__(self, base, token):
        self.base, self.token = base.rstrip("/"), token

    def call(self, path, method="GET", body=None):
        url = f"{self.base}/api/v1{path}"
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(url, data=data, method=method)
        req.add_header("authorization", f"Bearer {self.token}")
        if data:
            req.add_header("content-type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                raw = r.read()
                return json.loads(raw) if raw else None
        except urllib.error.HTTPError as e:
            e.read(200)
            raise RuntimeError(f"{method} {path} -> {e.code}") from e

    def fetch(self, path):
        """Raw GET against a capability URL (playlist/segment: no auth header)."""
        with urllib.request.urlopen(f"{self.base}/api/v1{path}", timeout=30) as r:
            return r.read()


def play_once(api, file_id, height, seconds, poll=0.5):
    """Open a session, consume it like a player would, and record what happened.

    Consuming matters: the ahead-window suspends a session that runs too far
    past the client, so a benchmark that never fetches a segment measures a
    parked encoder rather than a working one.
    """
    started = time.monotonic()
    info = api.call(f"/files/{file_id}/hls/sessions", "POST", {
        "playback_id": f"bench-{os.getpid()}",
        "request_id": f"bench-{time.time()}",
        "height": height, "start": 0,
    })
    sid = info["session_id"]
    result = dict(session=sid, encoder=info.get("encoder"), height=height,
                  ttfs=None, speeds=[], recent=[], ahead=[], seg_bytes=[], seg_secs=[])

    try:
        # Time to first playable segment: the server-side half of TTFF, and the
        # part the plan's start-latency claims are about.
        api.fetch(f"/hls/{sid}/index.m3u8")
        deadline = started + 90
        next_seg = 0
        while time.monotonic() < deadline:
            playlist = api.fetch(f"/hls/{sid}/index.m3u8").decode("utf8", "replace")
            entries = parse_playlist(playlist)
            while next_seg < len(entries):
                name, dur = entries[next_seg]
                try:
                    body = api.fetch(f"/hls/{sid}/{name}")
                except Exception:
                    break
                if result["ttfs"] is None:
                    result["ttfs"] = time.monotonic() - started
                result["seg_bytes"].append(len(body))
                result["seg_secs"].append(dur)
                next_seg += 1
            st = api.call(f"/hls/{sid}/status")
            if st.get("speed") is not None:
                result["speeds"].append(st["speed"])
            if st.get("recent_speed") is not None:
                result["recent"].append(st["recent_speed"])
            if st.get("ahead_seconds") is not None:
                result["ahead"].append(st["ahead_seconds"])
            if sum(result["seg_secs"]) >= seconds:
                break
            time.sleep(poll)
    finally:
        try:
            urllib.request.urlopen(urllib.request.Request(
                f"{api.base}/api/v1/hls/{sid}", method="DELETE"), timeout=10)
        except Exception:
            pass
    return result


def parse_playlist(text):
    """(name, duration) for every completed segment, from EXTINF."""
    out, pending = [], None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("#EXTINF:"):
            try:
                pending = float(line[8:].split(",")[0])
            except ValueError as error:
                raise BenchError("server playlist contained a nonnumeric EXTINF duration") from error
            if not math.isfinite(pending) or pending <= 0:
                raise BenchError("server playlist contained a non-finite or nonpositive duration")
        elif line and not line.startswith("#") and pending is not None:
            out.append((line, pending))
            pending = None
    return out


def pct(values, p):
    if not values:
        return None
    ordered = sorted(values)
    k = max(0, min(len(ordered) - 1, int(round((p / 100) * (len(ordered) - 1)))))
    return ordered[k]


def report(rows):
    print()
    print(f"{'fixture':16s} {'rung':>5s} {'encoder':22s} {'TTFS':>6s} "
          f"{'speed p10':>9s} {'p50':>6s} {'Mb/s p50':>8s} {'peak':>6s} {'ahead max':>9s}")
    print("-" * 104)
    for name, r in rows:
        if r is None:
            print(f"{name:16s} {'':>5s} {'FAILED':22s}")
            continue
        rates = [b * 8 / d / 1e6 for b, d in zip(r["seg_bytes"], r["seg_secs"]) if d > 0]
        speeds = r["recent"] or r["speeds"]
        print(f"{name:16s} {r['height']:>5d} {(r['encoder'] or '?')[:22]:22s} "
              f"{fmt(r['ttfs'], '{:.1f}s'):>6s} "
              f"{fmt(pct(speeds, 10), '{:.2f}x'):>9s} {fmt(pct(speeds, 50), '{:.2f}x'):>6s} "
              f"{fmt(pct(rates, 50), '{:.1f}'):>8s} {fmt(max(rates) if rates else None, '{:.1f}'):>6s} "
              f"{fmt(max(r['ahead']) if r['ahead'] else None, '{:d}s'):>9s}")
    print()
    print("How to read it. `speed p10` is the number that matters: it is the")
    print("worst sustained rate over the run, and anything under 1.00x means the")
    print("encoder is losing to the clock and the viewer's reserve is draining.")
    print("A healthy p50 with a poor p10 is a session that stutters periodically")
    print("rather than one that never worked. TTFS is the server's half of time")
    print("to first frame; the client adds its own buffering threshold on top.")
    print("`peak` vs `p50` Mb/s is rate-control honesty — a peak far above the")
    print("median is a rung whose advertised bandwidth is a fiction.")


def fmt(v, spec):
    if v is None:
        return "—"
    return spec.format(int(v) if spec.endswith("d}s") else v)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    f = sub.add_parser("fixtures", help="build the corpus")
    f.add_argument("--dir", default="./bench-media")

    r = sub.add_parser("run", help="play the corpus against a server")
    r.add_argument("--base", default="http://127.0.0.1:32400")
    r.add_argument("--token", required=True, help="an API token (Settings -> API keys, or a login token)")
    r.add_argument("--library", type=int, default=None, help="library id holding the fixtures")
    r.add_argument("--height", type=int, default=1080, help="transcode rung to measure")
    r.add_argument("--seconds", type=int, default=60, help="seconds of content to consume per fixture")
    r.add_argument("--only", default=None, help="one fixture name")

    rc = sub.add_parser(
        "rate-control",
        help="capture production HLS, then score it offline for N1",
    )
    rc.add_argument("--base", default="http://127.0.0.1:32400", help="production plurxd base URL")
    rc.add_argument("--token", required=True, help="admin token; never written to the result")
    rc.add_argument("--library", type=int, default=None, help="library id holding the fixtures")
    rc.add_argument("--corpus", required=True, help="versioned rate-control corpus JSON")
    rc.add_argument(
        "--server-sha256-manifest",
        default=None,
        help="sha256sum output captured on the production server (required for vbr,qvbr)",
    )
    rc.add_argument(
        "--modes",
        default="vbr",
        help=(
            "vbr for the current-main smoke; vbr,qvbr only after N1 settings exist "
            "and remains non-acceptance until the peak contract is ratified"
        ),
    )
    rc.add_argument(
        "--vmaf-ffmpeg",
        default="ffmpeg",
        help=(
            "scoring-only FFmpeg with libvmaf (default: %(default)s after a behavior probe); "
            "never used for production playback encoding"
        ),
    )
    rc.add_argument(
        "--vmaf-model",
        default="vmaf_v0.6.1",
        help="scoring model; full vbr,qvbr requires vmaf_v0.6.1 exactly",
    )
    rc.add_argument(
        "--vmaf-subsample",
        type=int,
        default=1,
        help="score every Nth frame (1 scores every frame)",
    )
    rc.add_argument("--json", required=True, help="stable JSON result artifact")
    rc.add_argument("--work-dir", default=None, help="controller-side capture scratch directory")
    rc.add_argument("--keep-artifacts", action="store_true", help="retain captured HLS after scoring")
    rc.add_argument("--quality", type=int, default=None, help="full-mode QVBR quality override")
    rc.add_argument(
        "--rate-window",
        type=float,
        default=10.0,
        help="served-segment peak window; full vbr,qvbr requires 10.0 seconds exactly",
    )
    rc.add_argument(
        "--poll",
        type=float,
        default=0.25,
        help="playlist/status polling interval; full vbr,qvbr requires 0.25 exactly",
    )
    rc.add_argument("--capture-timeout", type=float, default=180.0, help="per-session wall timeout")
    rc.add_argument(
        "--idle-timeout",
        type=float,
        default=30.0,
        help=(
            "local deadline between completed idle responses after DELETE or before a settings "
            "update; one in-flight API request may add its timeout"
        ),
    )
    rc.add_argument(
        "--settings-settle",
        type=float,
        default=3.0,
        help=(
            "seconds between a settings update and capture; full vbr,qvbr requires 3.0 exactly"
        ),
    )
    rc.add_argument("--only", default=None, help="one fixture name")

    args = ap.parse_args()

    if args.cmd == "rate-control":
        result = rate_control_report(args)
        write_json(args.json, result)
        print_rate_control(result)
        print(f"JSON: {args.json}")
        return 0 if result["passed"] else 1

    if args.cmd == "fixtures":
        if not shutil.which("ffmpeg"):
            sys.exit("ffmpeg not on PATH")
        os.makedirs(args.dir, exist_ok=True)
        print(f"building corpus in {args.dir} ({DURATION}s each)")
        for name, spec in FIXTURES.items():
            build_fixture(args.dir, name, spec)
        print("\nPoint a plurx library at that directory and scan it, then:")
        print(f"  scripts/bench run --token TOKEN --height 1080")
        return 0

    api = Api(args.base, args.token)
    items = api.call(f"/libraries/{args.library}/items") if args.library else None
    if items is None:
        libs = api.call("/libraries")
        if len(libs) != 1:
            sys.exit("more than one library — pass --library ID")
        items = api.call(f"/libraries/{libs[0]['id']}/items")

    by_name = {}
    for item in items.get("items", []):
        detail = api.call(f"/items/{item['id']}")
        for mf in detail.get("files", []):
            # The API exposes `filename`, not the server-side path — the
            # browser has no business knowing where media lives on disk.
            stem = os.path.splitext(mf.get("filename") or "")[0]
            by_name[stem] = mf["id"]

    wanted = [args.only] if args.only else list(FIXTURES)
    rows = []
    for name in wanted:
        file_id = by_name.get(name)
        if file_id is None:
            print(f"{name}: not in the library (scan it?)")
            rows.append((name, None))
            continue
        print(f"playing {name}…", flush=True)
        try:
            rows.append((name, play_once(api, file_id, args.height, args.seconds)))
        except Exception as e:  # a fixture that fails is a result, not a crash
            print(f"  {name}: {e}")
            rows.append((name, None))
    report(rows)
    return 0


if __name__ == "__main__":
    sys.exit(main())
