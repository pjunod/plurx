#!/usr/bin/env python3
"""Collect what PERF-PLAN's open acceptance runs need, from a live server.

Everything still open in docs/PERF-PLAN.md is a claim about *numbers on real
hardware*: which tone-map graph this box can actually run (§5 / M2), whether
bounded rate control holds on a grain-heavy source (§4.6), and what a start
and a seek really cost (§4.4, §6.3). CI cannot answer any of them — with no
GPU there, a candidate can only fail its probe, never pass.

So this runs where the hardware is. It reads the server's own measurements
rather than re-deriving anything: the boot probe's verdicts, the exact ffmpeg
command production used, the browser beacons. The one thing it produces
itself is the rate-control measurement, and it does that by starting a real
session and measuring the segments that session wrote — not by reconstructing
the arguments, which would only prove that two copies of the flag list agree.

    scripts/perf-report --sustained
    scripts/perf-report --url http://nynuc:32400 --ratecontrol 42

Prompts for the admin username and password if you don't pass them.

Writes perf-report-<host>-<date>.txt. Send that file back.
"""

import argparse
import getpass
import json
import re
import socket
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

ANSI = re.compile(r"\x1b\[[0-9;]*m")


class Server:
    def __init__(self, url, token=None):
        self.base = url.rstrip("/") + "/api/v1"
        self.token = token

    def call(self, path, method="GET", body=None, raw=False, timeout=60):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.base + path, data=data, method=method)
        if data:
            req.add_header("content-type", "application/json")
        if self.token:
            req.add_header("authorization", "Bearer " + self.token)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                payload = r.read()
                return r.status, (payload if raw else json.loads(payload or b"null"))
        except urllib.error.HTTPError as e:
            return e.code, e.read().decode(errors="replace")
        except urllib.error.URLError as e:
            sys.exit(f"cannot reach {self.base}: {e.reason}")

    def login(self, user, password):
        st, r = self.call("/auth/login", "POST",
                          {"username": user, "password": password, "device": "perf-report"})
        if st != 200:
            sys.exit(f"login failed ({st}): {r}")
        self.token = r["token"]


def clean(s):
    return ANSI.sub("", s)


# `/settings` returns API keys in the clear, because an admin editing them has
# to see what is there. A diagnostic report does not: it gets pasted into a
# chat, attached to an issue, and kept in a downloads folder. The first version
# of this dumped them verbatim — TMDB, OMDb, Trakt and monarr, all of them, in
# a file whose entire purpose is to be sent to somebody else.
SECRET = re.compile(r"(key|secret|token|password)", re.I)


def redact(obj):
    """Every value whose *name* says it is a credential, replaced by its shape.

    Matching on the name rather than the value, because a key is only
    recognisable by what it is called — and a report that leaks one because the
    pattern did not match is worse than one that redacts a field it needn't.
    The length is kept: "did the key get truncated" is a real diagnostic
    question, and it does not need the key to answer it.
    """
    if isinstance(obj, dict):
        return {k: (f"<redacted, {len(v)} chars>"
                    if SECRET.search(k) and isinstance(v, str) and v
                    else redact(v))
                for k, v in obj.items()}
    if isinstance(obj, list):
        return [redact(v) for v in obj]
    return obj


# ---- sections -------------------------------------------------------------

def node_section(out, sys_info):
    """M2's acceptance answer, and the context needed to read it."""
    out(f"server         {sys_info.get('name')} · plurx {sys_info.get('version')} "
        f"({sys_info.get('build')}) · up {sys_info.get('uptime_seconds', 0)//3600}h")
    out(f"ffmpeg         {sys_info.get('ffmpeg_version') or 'NOT FOUND'}")
    enc = sys_info.get("encoders") or {}
    validated = [k for k in ("nvenc", "qsv", "vaapi", "videotoolbox") if enc.get(k)]
    out(f"encoders       validated: {', '.join(validated) or 'none — software only'}")
    # QSV and NVENC need a flag before their forced key frames are splittable,
    # and without it the muxer cuts at the encoder's GOP instead — segments five
    # times longer than asked for, and a viewer waiting for every one of them.
    idr = (enc.get("forced_idr") or {}) if isinstance(enc, dict) else {}
    for fam in ("qsv", "nvenc"):
        if enc.get(fam):
            state = ("accepted" if idr.get(fam) else
                     "NOT ACCEPTED — segments will follow the encoder's GOP, "
                     "not the requested length")
            out(f"forced IDR     {fam}: {state}")
    out(f"transcoder     {sys_info.get('encoder_selected')} "
        f"(preference: {sys_info.get('hwaccel_pref')})")
    out(f"hw slots       {sys_info.get('hw_slots_in_use')} of {sys_info.get('hw_slots_max')}")

    tm = sys_info.get("tone_map") or {}
    out("")
    out(f"tone-map       selected: {tm.get('selected_label')} [{tm.get('selected')}]")
    if not tm.get("ran"):
        why = (tm.get("verdicts") or [{}])[0].get("rejected")
        out(f"               probe did not run: {why}")
    for v in tm.get("verdicts") or []:
        mark = "PASS" if v.get("passed") else "FAIL"
        speed = f" {v['speedup']:.2f}x vs CPU" if v.get("speedup") else ""
        why = f" — {v['rejected']}" if v.get("rejected") else ""
        out(f"               [{mark}] {v.get('label')}{speed}{why}")
    out("")
    # This is the whole M2 question, stated so the answer is unambiguous.
    if tm.get("selected") and tm["selected"] != "cpu":
        out(f"  M2: a GPU tone-map graph PASSED here ({tm.get('selected_label')}).")
    elif tm.get("ran"):
        out("  M2: every GPU candidate was rejected on this box; 4K HDR tone-maps on the CPU.")
    else:
        out("  M2: the probe never ran, so nothing is known about GPU tone-mapping here.")


def log_section(out, logs, cache_settings, srv=None, playback_events=None):
    """What actually ran, and what the browsers measured."""
    lines = [clean(e.get("message", "")) for e in logs]

    def field(line, name):
        """A tracing field: quoted values keep their spaces, bare ones don't."""
        m = re.search(rf'\b{name}="([^"]*)"', line) or re.search(rf"\b{name}=(\S*)", line)
        return m.group(1) if m else "?"

    # TWO kinds of session write an ffmpeg command line, and this used to look
    # for one of them. A copy-video HLS session — which is what a big remux
    # takes since §4.3bis — logs "copy-video HLS ffmpeg args:", so a report
    # taken while one was running said "transcode sessions in the log ring: 0"
    # and printed no command at all. The exact thing the report exists to
    # surface was the one thing it could not see.
    ran = [l for l in lines if "transcode ffmpeg args:" in l]
    copies = [l for l in lines if "copy-video HLS ffmpeg args:" in l]
    out(f"encode sessions in the log ring: {len(ran)} transcode · {len(copies)} copy-video")
    seen = {}
    for l in ran:
        key = (field(l, "encoder"), field(l, "pipeline"), field(l, "proven"))
        seen[key] = seen.get(key, 0) + 1
    for (encoder, pipeline, proven), n in sorted(seen.items(), key=lambda kv: -kv[1]):
        note = "" if pipeline == proven or proven == "?" else f" (node proved {proven})"
        out(f"  {n:4d} × encoder={encoder} · pipeline={pipeline}{note}")
    if copies:
        out(f"  {len(copies):4d} × copy-video (source video untouched; audio re-encoded "
            "only if the browser can't take it)")
        modes = {}
        for l in copies:
            modes[field(l, "mode")] = modes.get(field(l, "mode"), 0) + 1
        for mode, n in sorted(modes.items(), key=lambda kv: -kv[1]):
            label = {
                "segmenter": "plurx cuts the segments (GOP-aware)",
                "legacy": "ffmpeg's HLS muxer cuts the segments",
                "?": "mode not recorded — server predates the segmenter",
            }.get(mode, mode)
            out(f"       {n:4d} × {label}")

    # Why a session did not get the graph this node proved. Usually a correct
    # answer — Dolby Vision cannot go through a vendor tone-map — and without
    # it `pipeline=cpu` on a 4K HDR title is indistinguishable from the GPU
    # path being broken.
    declined = {}
    for l in ran:
        why = field(l, "declined")
        if why not in ("", "?"):
            declined[(field(l, "hdr"), why)] = declined.get((field(l, "hdr"), why), 0) + 1
    if declined:
        out("")
        out("  sessions that did NOT get this node's proven graph:")
        for (hdr, why), n in sorted(declined.items(), key=lambda kv: -kv[1]):
            out(f"    {n:4d} × [{hdr}] {why}")

    if ran:
        out("")
        out("  most recent transcode command (this is what production ran):")
        out("    " + ran[-1][:2000])
    if copies:
        out("")
        out("  most recent copy-video command (this is what production ran):")
        out("    " + copies[-1][:2000])
        # `-hls_time` is a REQUEST on this path, not a setting. `-c copy` can
        # only cut where the source already has a key frame, so a disc remux
        # keyed every 5-10s produces 5-10s segments however small a number is
        # asked for — and nothing plays until a whole segment exists. Measured
        # from the session's own playlist rather than assumed, when it is still
        # alive to ask.
        sid = field(copies[-1], "session_id")
        if sid != "?":
            st, body = srv.call(f"/hls/{sid}/index.m3u8", raw=True)
            if st == 200 and isinstance(body, (bytes, bytearray)):
                durs = [d for _, d in parse_playlist(body.decode(errors="replace"))]
                if durs:
                    want = 6.0
                    sd = sorted(durs)
                    out("")
                    out(f"  segments it actually produced: {len(durs)} · "
                        f"median {sd[len(sd)//2]:.2f}s · min {sd[0]:.2f}s · max {sd[-1]:.2f}s")
                    if sd[len(sd) // 2] > want * 1.5:
                        out(f"    ⚠ asked for {want:.0f}s. A copy can only cut on the source's own")
                        out("      key frames, so this is the source's key-frame interval, not a")
                        out("      setting. Nothing plays until a whole segment exists, and every")
                        out("      seek lands at one of these boundaries.")
                # What the init segment SIGNALS, which is not always what the
                # stream carries. A Dolby Vision configuration box (dvcC/dvvC)
                # naming Profile 7 — the dual-layer disc profile nothing
                # browser-shaped supports — makes VideoToolbox refuse the
                # hardware path: Safari software-decoded 4K10 HEVC on an M3
                # Max over exactly this. The dovi_rpu strip removes the side
                # data this box is written from; this check is how a report
                # proves the wire is actually clean.
                st2, init = srv.call(f"/hls/{sid}/init.mp4", raw=True)
                if st2 == 200 and isinstance(init, (bytes, bytearray)):
                    boxes = [b for b in (b"dvcC", b"dvvC", b"dvwC") if b in init]
                    if boxes:
                        names = ", ".join(b.decode() for b in boxes)
                        out(f"    ⚠ init segment still signals Dolby Vision ({names}) — with the")
                        out("      RPUs stripped that is a promise the stream no longer keeps, and")
                        out("      VideoToolbox (both Mac browsers) refuses the hardware path over")
                        out("      it. The dovi_rpu strip needs ffmpeg ≥ 7.1 on the server.")
                    else:
                        out("    init segment signals no Dolby Vision — the wire is plain HDR10")
            else:
                out(f"  (session {sid[:8]} has already gone, so no segment lengths)")

    # What the GOP-aware segmenter did with the cuts it was given.
    #
    # A clean cut is one taken in front of a keyframe a player will not discard
    # a leading picture at, which is the whole reason plurx took the cutting
    # away from ffmpeg (docs/SEGMENTER-PLAN.md, docs/STUTTER-4K.md §5.6). A
    # ceiling cut is one taken anyway because no clean point appeared before
    # the byte or duration limit — it still costs the frame, and printing the
    # number is the difference between a bounded residual and a hidden one.
    segruns = [l for l in lines if "copy segmenter: segments" in l]
    if segruns:
        out("")
        out(f"  GOP-aware segmenter: {len(segruns)} finished session(s)")
        totals = {}
        for l in segruns:
            for name in ("segments", "clean cuts", "ceiling cuts", "fragments", "unparseable"):
                m = re.search(rf"{name} (\d+)", l)
                if m:
                    totals[name] = totals.get(name, 0) + int(m.group(1))
        cuts = totals.get("clean cuts", 0) + totals.get("ceiling cuts", 0)
        out(f"    segments {totals.get('segments', 0)} · "
            f"clean cuts {totals.get('clean cuts', 0)} · "
            f"ceiling cuts {totals.get('ceiling cuts', 0)}"
            + (f" ({100.0 * totals.get('clean cuts', 0) / cuts:.0f}% clean)" if cuts else ""))
        if totals.get("ceiling cuts", 0):
            out("      a ceiling cut is a boundary taken with no clean keyframe in reach")
            out("      before the 48MB/15s limit — it still costs one dropped frame, which")
            out("      is the residual `scripts/gop-census <file>` measures per source.")
        if totals.get("unparseable", 0):
            out(f"      ⚠ {totals['unparseable']} fragment(s) the classifier could not read;")
            out("        a cut is never taken in front of one, so these only cost cut sites")
    fellback = [l for l in lines if "copy segmenter cannot read this stream" in l]
    if fellback:
        out(f"    ⚠ {len(fellback)} session(s) fell back to ffmpeg's HLS muxer:")
        for l in fellback[-3:]:
            out("      " + l[:200])

    downgrades = [l for l in lines if "downgrad" in l.lower() or "falling back" in l.lower()]
    if downgrades:
        out("")
        out(f"runtime downgrades: {len(downgrades)}")
        for l in downgrades[-5:]:
            out("  " + l[:200])

    # The M0 beacons: the only numbers that say what a start actually cost.
    #
    # `ttff_ms=` only, never a bare `ms=`. A stall carries a duration in the
    # same field, and mixing the two gives a distribution that is part start
    # times and part stall lengths — with the stalls, being longer, owning the
    # whole tail. Older servers printed both as `ttff_ms`; there is nothing to
    # be done about those logs except know it.
    ttff = []
    if playback_events is not None:
        for event in playback_events:
            if event.get("event") == "ttff" and event.get("ms") is not None:
                ttff.append((int(event["ms"]), event.get("method") or "?",
                             event.get("reason") or "?"))
        out("")
        out("playback measurement source: durable playback_events table (last 7 days)")
    else:
        for l in lines:
            m = re.search(r"\bttff_ms=(\d+)", l)
            if m:
                method = (re.search(r"method=(\w+)", l) or [None, "?"])[1]
                reason = (re.search(r"attempt=[^/]*/(\S+)", l) or [None, "?"])[1]
                ttff.append((int(m.group(1)), method, reason))
        out("")
        out("playback measurement source: log ring fallback (server has no table endpoint)")
    out(f"playback starts measured: {len(ttff)}")
    if ttff:
        vals = sorted(v[0] for v in ttff)
        out(f"  time-to-first-frame  min {vals[0]}ms · median {vals[len(vals)//2]}ms "
            f"· p90 {vals[min(len(vals)-1, int(len(vals)*0.9))]}ms · max {vals[-1]}ms")
        for ms, method, reason in ttff[-12:]:
            out(f"    {ms:6d}ms  {method:12s} {reason}")
    else:
        out("  none — play a few things in a browser and run this again.")
        out("  (cold starts, a seek, and one 4K HDR title is enough.)")

    # Stalls are a separate series, and the distinction in `detail` is the
    # whole point: `supply` ran out of buffered video and is a server or link
    # problem; `decode` had video in hand and could not play it, which is the
    # browser and which no amount of pacing will improve.
    # Frame-level hitches: the artifact that is smaller than every aggregate.
    # A count alone says little; the SPACING says which subsystem it tracks —
    # segment cadence, a timer, or the decoder.
    hitch = [l for l in lines if " hitch " in l or "event=hitch" in l or "[back=" in l]
    if hitch:
        out("")
        out(f"  ⚠ {len(hitch)} hitch beacon(s) — frames stepping backwards, being held on")
        out("    screen, or being skipped: below the 350ms a stall needs and invisible to")
        out("    every other counter here.")
        out("      back = the media clock moved backwards (a resync)")
        out("      held = the same frame presented twice (the picture stopped for a beat)")
        out("      late = the next frame reached the screen ≥3/4 of a frame behind the")
        out("             compositor's own schedule — the hold itself, which fires no")
        out("             callback and is invisible to every other counter")
        out("      drop = exactly one frame skipped — the single-frame drop a viewer")
        out("             sees as a tick, below the skip threshold by design until now")
        out("      skip = media time moved past frames that never reached the screen")
        out("      slow = one frame took over 3x this session's own typical decode")
        out("    Each event carries the decode cost AT the hitch against the session's")
        out("    typical — a spike there says the decoder stumbled on that access unit")
        out("    (the giant IRAP theory); a flat one says look at delivery instead.")
        out("    A rate= figure in the beacon is the REALIZED playback speed from")
        out("    presented frames; more than ~2% off the requested rate on a native")
        out("    HLS session is the browser chasing the live edge of the growing")
        out("    EVENT playlist — judders exactly like a decode problem, and is")
        out("    neither.")
        out("    A hitch also carries what the player was doing within 150ms of it —")
        out("    a buffer flush, a segment boundary, an append — and the skew between")
        out("    the frame on screen and the element's own clock, which is the audio")
        out("    clock whenever there is audio.")
        for l in hitch[-3:]:
            out("    " + l[:240])

    # The decode-margin verdicts. A rescue is the client measuring its own
    # decoder out of headroom on a copied stream and switching itself to a
    # transcode; a clear is an explicit-Original session finding the margin
    # healthy again (a GPU upgrade, a driver fix) and unremembering the limit.
    resc = [l for l in lines if "decode_rescue" in l or "decode_limit_cleared" in l]
    if resc:
        out("")
        out(f"  {len(resc)} decode-margin event(s): the client's own measured decode")
        out("    cost against its frame budget, and what it did about it.")
        for l in resc[-3:]:
            out("    " + l[:240])

    # Buffer-quota beacons. hls.js asks for a target in seconds; the browser
    # enforces a limit in BYTES that no setting can raise. When the two
    # disagree the result is an append/evict cycle that hitches near the
    # playhead every few seconds and never lasts the 350ms a stall needs — so
    # it shows up nowhere else in this report, and reads as a healthy session.
    quota = [l for l in lines if "buffer_limit" in l]
    if quota:
        out("")
        out(f"  ⚠ {len(quota)} buffer-limit beacon(s): the browser refused the buffer size")
        out("    the player asked for. Repeated eviction near the playhead is a hitch")
        out("    every few seconds that never registers as a stall.")
        for l in quota[-3:]:
            out("    " + l[:220])

    # The browser's own verdict on hardware decode, hoisted out of the beacons
    # because it changes how every line below is read. A machine
    # software-decoding 4K shows a full buffer, few dropped frames and constant
    # judder — which the rest of this report renders as perfect health.
    soft = [l for l in lines if "decode=SOFTWARE" in l]
    if soft:
        out("")
        out(f"  ⚠ {len(soft)} beacon(s) report SOFTWARE decoding. The browser says this")
        out("    machine has no GPU path for that stream, so late frames and judder are")
        out("    the decoder, not the link — no amount of buffering or pacing helps.")
        out("    " + soft[-1][:220])
    elif any("decode=hw" in l for l in lines):
        out("")
        out("  decode: hardware, per the browser's own mediaCapabilities verdict.")

    stalls = ([event for event in playback_events if event.get("event") == "stall"]
              if playback_events is not None else
              [l for l in lines if re.search(r"client\S* stall\b", l)])
    if stalls:
        kinds = {}
        for stall in stalls:
            detail = ((stall.get("detail") or "") if isinstance(stall, dict) else stall)
            k = "supply" if "supply" in detail else "decode" if "decode" in detail else "?"
            kinds[k] = kinds.get(k, 0) + 1
        out("")
        out(f"stalls reported by clients: {len(stalls)} "
            f"({' · '.join(f'{n} {k}' for k, n in sorted(kinds.items()))})")
        if kinds.get("supply"):
            out("  supply = the client ran dry. Server or link, not the browser.")
        for stall in stalls[-8:]:
            if isinstance(stall, dict):
                out("  " + json.dumps({k: stall.get(k) for k in
                                        ("at_unix_ms", "method", "ms", "runway_ds",
                                         "speed_recent", "ahead_seconds", "delivered_bps",
                                         "readrate", "detail")}, separators=(",", ":")))
            else:
                out("  " + stall[:220])

    if playback_events is not None:
        resumes = [event for event in playback_events
                   if event.get("event") == "resume" and event.get("ms")]
        if resumes:
            out("")
            out(f"encoder holds: {len(resumes)} completed · "
                f"{sum(int(event['ms']) for event in resumes)/1000:.1f}s suspended")

    produced = [l for l in lines if "pre-transcode published" in l]
    out("")
    out(f"cache: produce every {cache_settings.get('cache_produce_mins')} min · "
        f"budget {cache_settings.get('cache_max_gb')} GB · "
        f"holding {(cache_settings.get('cache_used_bytes') or 0) / 2**30:.2f} GB")
    out(f"       entries published while this log ring has been alive: {len(produced)}")
    for l in produced[-5:]:
        out("  " + l[:220])


# ---- storage: can the source even be read fast enough? --------------------

def storage_section(out, sys_info, settings):
    """What the libraries' storage reads at, against what playback needs.

    The report's other sections all describe what the server *did* with a file
    once it had it. This one asks whether it could get it. A remux copies the
    video untouched, so the source read has to sustain the file's own bitrate
    for the whole film — and when it cannot, every symptom lands somewhere
    else: the client reports a supply stall, the encoder shows under 1x, and
    both are true and neither is the cause.
    """
    st = sys_info.get("storage") or {}
    if not st.get("ran"):
        out("  not measured yet — the probe runs a few seconds after boot, and")
        out("  POST /api/v1/system/storage re-runs it on demand.")
        return
    readrate = float(settings.get("stream_readrate") or 4)
    for m in st.get("mounts") or []:
        roots = ", ".join(m.get("roots") or []) or "?"
        read = m.get("read_bps")
        if read is None:
            out(f"  {roots}: no measurement — {m.get('note') or 'unknown'}")
            continue
        seek = m.get("seek_ms")
        out(f"  {roots}: {read/1e6:.0f} Mb/s ({read/8e6:.0f} MB/s)"
            + (f" · cold seek {seek:.1f} ms" if seek is not None else ""))
        if m.get("cache_suspect"):
            out(f"    ⚠ {m.get('note')}")
        # The number that matters, stated in the unit people have in hand: the
        # biggest source this mount can feed, at realtime and at the pace the
        # server is configured to want.
        out(f"    feeds a source of up to {read/1e6:.0f} Mb/s at realtime"
            + (f", {read/readrate/1e6:.0f} Mb/s at the configured {readrate:g}x pace"
               if readrate > 0 else ""))
        out(f"    sampled {m.get('sampled_bytes', 0)/1e6:.0f} MB of "
            f"{m.get('sampled') or '?'}")
        sustained_lines(out, m)
    out("")
    out("  A remux or a direct play needs the source bitrate sustained off this")
    out("  storage for the whole film. Under the realtime figure above it cannot")
    out("  work, whatever the encoder or the client does; under the paced figure")
    out("  it plays but never builds a reserve, so any hiccup is a stall.")


def sustained_lines(out, mount):
    """The trace, and what it would do to a real stream.

    The average is the wrong question once it clears the bitrate — what stalls
    a viewer is a *gap*, a stretch where supply fell under demand for longer
    than the client's buffer covers, and an average cannot show one. The
    verdicts replay the measured trace against a client at each buffer depth,
    so "a deeper buffer would fix this" stops being an argument and becomes a
    number measured on this hardware.
    """
    s = mount.get("sustained")
    if not s:
        return
    wrapped = (" · re-read the file from the top partway through, so the later "
               "windows are optimistic" if s.get("wrapped") else "")
    out(f"    sustained {s['seconds']:.0f}s, sampled every "
        f"{s['window_secs']*1000:.0f}ms{wrapped}:")
    out(f"      min {s['min_bps']/1e6:.0f} · p10 {s['p10_bps']/1e6:.0f} · "
        f"median {s['median_bps']/1e6:.0f} · max {s['max_bps']/1e6:.0f} Mb/s"
        f" ({len(s['windows_bps'])} windows)")
    if s.get("cached_windows"):
        out(f"      ⚠ {s['cached_windows']} window(s) discarded as page cache, not storage — "
            "this mount's biggest file is small enough to sit in RAM")
    verdicts = mount.get("verdicts") or []
    if not verdicts:
        return
    # Grouped by bitrate so the two buffer depths sit side by side — the
    # comparison is the finding, and putting them in separate blocks would
    # make the reader do the join.
    depths = sorted({v["buffer_secs"] for v in verdicts})
    out("      replayed against a real client:")
    out("        source      " + "".join(f"{d:>6.1f}s buffer   " for d in depths))
    for br in sorted({v["bitrate_bps"] for v in verdicts}):
        cells = []
        for d in depths:
            v = next((x for x in verdicts
                      if x["bitrate_bps"] == br and x["buffer_secs"] == d), None)
            if v is None:
                cells.append(f"{'—':>17}")
            elif v["stalls"]:
                cells.append(f"{v['stalls']} stalls/{v['dry_seconds']:.0f}s dry".rjust(17))
            else:
                # No stalls is not the same as comfortable. The low-water mark
                # separates "held up fine" from "came within a hair of it".
                cells.append(f"ok (low {v['min_buffer_secs']:.1f}s)".rjust(17))
        out(f"        {br/1e6:>4.0f} Mb/s " + "".join(cells))
    out("      (left column is the progressive /stream.mp4 ceiling measured in")
    out("       §4.3bis; right is what an MSE path holds. Same trace, same file.)")


# ---- §5: does the GPU tone-map reach a real library? ----------------------

def shape_section(out, shape):
    """What is actually on disk, in the terms the transcoder cares about.

    M2 accepted the GPU tone-map on a probe: a generated HDR10 fixture, ~5x the
    CPU chain. What the probe cannot say is how much of a real library that
    reaches, because the same graph is declined outright for Dolby Vision — the
    vendor filter cannot read its dynamic metadata, so those titles take the
    CPU path no matter how fast the GPU one measured.
    """
    if not shape:
        out("  could not read the library census.")
        return
    probed, unprobed = shape.get("probed", 0), shape.get("unprobed", 0)
    out(f"  {probed} probed file(s)" + (f" · {unprobed} never probed" if unprobed else ""))
    if unprobed:
        out("    (an unprobed file has no codec or HDR flavour, so it is left out of")
        out("     the counts below rather than counted as SDR.)")
    if not probed:
        return

    def bar(pairs, total, indent="    "):
        for name, n in pairs:
            out(f"{indent}{name:<14} {n:>6}  {100.0*n/total:5.1f}%")

    out("")
    out("  every probed file, by HDR flavour:")
    bar(shape.get("hdr") or [], probed)

    four_k = shape.get("hdr_4k") or []
    total_4k = sum(n for _, n in four_k)
    out("")
    if not total_4k:
        out("  no 4K files — M2's tone-map has nothing to do here either way.")
    else:
        out(f"  4K only ({total_4k} file(s)) — the set M2 exists for:")
        bar(four_k, total_4k)
        # The whole point of the section, stated so it cannot be misread.
        by = dict(four_k)
        fast = by.get("hdr10", 0) + by.get("hlg", 0)
        dv = by.get("dolby_vision", 0)
        hdr_total = fast + dv
        out("")
        if not hdr_total:
            out("  §5: no 4K HDR at all, so the GPU tone-map never runs on this library.")
        else:
            out(f"  §5: of {hdr_total} 4K HDR file(s), the GPU tone-map can take "
                f"{fast} ({100.0*fast/hdr_total:.0f}%).")
            if dv:
                out(f"      The other {dv} are Dolby Vision and go to the CPU chain — "
                    "not a")
                out("      fallback, the correct answer, and unaffected by M2's speedup.")

    codecs = shape.get("codecs") or []
    if codecs:
        out("")
        out("  video codecs:")
        bar(codecs[:6], probed)

    over = shape.get("over_segmented_floor", 0)
    mx = shape.get("max_bitrate")
    out("")
    out(f"  {over} file(s) at or above the historic 40 Mb/s remux floor — "
        "high-bitrate stress population (§4.3bis)")
    if mx:
        out(f"  biggest file on disk: {mx/1e6:.0f} Mb/s")


# ---- §4.6: does bounded rate control actually hold? -----------------------

def parse_playlist(text):
    """(name, seconds) per segment, in order."""
    out, pending = [], None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("#EXTINF:"):
            try:
                pending = float(line.split(":")[1].split(",")[0])
            except ValueError:
                pending = None
        elif line and not line.startswith("#") and pending is not None:
            out.append((line, pending))
            pending = None
    return out


def ratecontrol_section(out, srv, file_id, height, seconds, window):
    """Measure what a real session writes, over a sliding window.

    §4.6's acceptance is a *window*, not a per-segment cap: `maxrate` and
    `bufsize` describe a buffering model, so a segment may exceed the nominal
    rate as long as the buffer it drains from does not. Measuring per-segment
    peaks alone would fail a correctly-bounded encoder on any hard cut.
    """
    st, sess = srv.call(f"/files/{file_id}/hls/sessions", "POST",
                        {"playback_id": "perf-report", "height": height, "start": 0})
    if st != 200:
        out(f"  could not start a session: {st} {sess}")
        return
    sid = sess["session_id"]
    out(f"  session {sid} · encoder {sess.get('encoder')} · height {height}")
    if sess.get("vod"):
        out("  this file is already in the pre-transcode cache, so no encoder ran.")
        out("  pick a file that is not cached, or turn the cache budget to 0 first.")
        srv.call(f"/hls/{sid}", "DELETE")
        return

    # Fetch the playlist as a player would, so the session stays alive and the
    # server keeps producing.
    deadline = time.time() + seconds
    segments = []
    while time.time() < deadline:
        time.sleep(2)
        st, body = srv.call(f"/hls/{sid}/index.m3u8", raw=True)
        if st != 200:
            break
        segments = parse_playlist(body.decode(errors="replace"))

    sizes = []
    for name, dur in segments:
        st, blob = srv.call(f"/hls/{sid}/{name}", raw=True)
        if st == 200 and isinstance(blob, (bytes, bytearray)):
            sizes.append((name, dur, len(blob)))
    srv.call(f"/hls/{sid}", "DELETE")

    if len(sizes) < 3:
        out(f"  only {len(sizes)} segments in {seconds}s — the encoder is far below "
            "realtime, which is itself the finding. Nothing to bound.")
        return

    total_s = sum(d for _, d, _ in sizes)
    total_b = sum(n for _, _, n in sizes) * 8
    out(f"  {len(sizes)} segments · {total_s:.1f}s of media · "
        f"mean {total_b / total_s / 1e6:.2f} Mb/s")

    # Segment length, which is a different question from bitrate and the one
    # that decides how long a viewer stares at a spinner: nothing plays until a
    # whole segment exists. The server asks for SEGMENT_SECONDS, but the HLS
    # muxer can only cut at a key frame the encoder actually flagged — so this
    # reports what was delivered, not what was requested. Ten-second segments
    # from a two-second request is the shape of a hardware encoder whose forced
    # key frames are not IDR.
    durs = sorted(d for _, d, _ in sizes)
    med = durs[len(durs) // 2]
    out(f"  segment length: median {med:.2f}s · min {durs[0]:.2f}s · max {durs[-1]:.2f}s")
    if med > 3.0:
        out(f"  ⚠ segments are {med:.1f}s, not ~2s. Nothing plays until one exists, so "
            "this is start-up latency directly.")
        out("    On QSV/NVENC the usual cause is forced key frames that are not IDR; "
            "look for a boot warning about the forced-IDR flag.")
    else:
        out("    (~2s as requested — the muxer is cutting where it was asked to.)")

    # Peak over a sliding window of `window` seconds.
    peak, peak_at = 0.0, 0.0
    elapsed = 0.0
    starts = []
    for name, dur, nbytes in sizes:
        starts.append(elapsed)
        elapsed += dur
    for i in range(len(sizes)):
        w_bits, w_secs = 0.0, 0.0
        for j in range(i, len(sizes)):
            w_bits += sizes[j][2] * 8
            w_secs += sizes[j][1]
            if w_secs >= window:
                break
        # Only windows that actually reached `window` seconds. The tail of the
        # recording cannot fill one, and a two-second "ten-second window" is
        # just that segment's own rate — which is exactly the per-segment peak
        # this measurement exists to look past. Counting them would report a
        # correctly-bounded encoder as over bound, on every run.
        if w_secs + 1e-6 < window:
            break
        rate = w_bits / w_secs
        if rate > peak:
            peak, peak_at = rate, starts[i]
    if peak == 0.0:
        out(f"  less than one full {window:.0f}s window was produced — run with "
            f"--seconds larger than {int(window * 3)}.")
        return
    worst = max(sizes, key=lambda s: s[2] * 8 / s[1])
    out(f"  peak over a {window:.0f}s window: {peak / 1e6:.2f} Mb/s "
        f"(starting at {peak_at:.0f}s)")
    out(f"  worst single segment:  {worst[2] * 8 / worst[1] / 1e6:.2f} Mb/s ({worst[0]})")

    # The bound the flags describe. bitrate_for_height in transcode.rs:
    nominal_kbps = {2160: 20000, 1080: 8000, 720: 4000, 480: 2000}.get(height, 1200)
    maxrate = nominal_kbps * 1500          # 1.5x, in bits/s
    bufsize = nominal_kbps * 2000          # 2x, in bits
    allowed = maxrate + bufsize / window   # VBV: maxrate*W + bufsize bits over W
    out(f"  nominal {nominal_kbps/1000:.0f} Mb/s · maxrate {maxrate/1e6:.1f} Mb/s "
        f"· bufsize {bufsize/1e6:.1f} Mb")
    out(f"  permitted over a {window:.0f}s window: {allowed / 1e6:.2f} Mb/s")
    verdict = "WITHIN BOUND" if peak <= allowed else "OVER BOUND"
    out(f"  §4.6: {verdict} — measured {peak/1e6:.2f} vs permitted {allowed/1e6:.2f} Mb/s")
    if peak > allowed:
        out("  (this is the finding §4.6 asked for. Send the numbers; do not "
            "change flags to make it pass.)")


# ---- main -----------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--url", default="http://127.0.0.1:32400",
                    help="server base URL (default: %(default)s)")
    ap.add_argument("--user", help="an ADMIN username; prompted for if omitted")
    ap.add_argument("--password", help="prompted for if omitted")
    ap.add_argument("--ratecontrol", type=int, metavar="FILE_ID",
                    help="also measure §4.6 against this file id — pick the "
                         "grainiest 4K HDR thing you own")
    ap.add_argument("--height", type=int, default=1080,
                    help="rung to measure rate control at (default: %(default)s)")
    ap.add_argument("--seconds", type=int, default=90,
                    help="how long to let that session run (default: %(default)s)")
    ap.add_argument("--window", type=float, default=10.0,
                    help="sliding window for the bitrate bound, seconds "
                         "(default: %(default)s)")
    ap.add_argument("--sustained", type=float, nargs="?", const=30.0, metavar="SECS",
                    help="also read continuously for SECS per mount (default 30) "
                         "and report the distribution plus what it would do to a "
                         "real stream. Costs real I/O: SECS x the read rate x the "
                         "number of mounts")
    ap.add_argument("--out", help="output file (default: perf-report-<host>-<date>.txt)")
    args = ap.parse_args()

    # Asked for rather than defaulted. The admin's name is not something this
    # script can know, and a placeholder baked into the docs gets copied,
    # fails, and reads as the tool being broken.
    user = args.user or input("admin username: ").strip()
    if not user:
        sys.exit("an admin username is required")
    password = args.password or getpass.getpass(f"password for {user}: ")
    srv = Server(args.url)
    srv.login(user, password)

    st, sys_info = srv.call("/system")
    if st != 200:
        sys.exit(f"/system says {st}: {sys_info} — is {user} an admin?")

    # Before /settings, and before the log fetch: the sustained probe takes
    # minutes and its result has to be the one /system reports below.
    if args.sustained:
        mounts = len((sys_info.get("storage") or {}).get("mounts") or []) or 1
        print(f"reading for {args.sustained:.0f}s on each of {mounts} mount(s) — "
              f"about {args.sustained * mounts / 60:.0f} min…", file=sys.stderr)
        # The server reads for `sustained` seconds *per mount*, in series, and
        # the request does not answer until it has finished them all. The
        # default 60 s timeout would abandon a probe that is working fine.
        st, storage = srv.call(f"/system/storage?sustained={args.sustained}", "POST",
                               timeout=args.sustained * mounts + 120)
        if st == 200:
            sys_info["storage"] = storage
        else:
            print(f"  sustained probe failed ({st}) — reporting the quick numbers",
                  file=sys.stderr)

    st, shape = srv.call("/system/library-shape")
    if st != 200:
        shape = None

    st, settings = srv.call("/settings")

    host = re.sub(r"[^a-zA-Z0-9]+", "-", args.url.split("//")[-1]).strip("-")
    path = args.out or f"perf-report-{host}-{datetime.now().strftime('%Y%m%d-%H%M')}.txt"
    buf = []

    def out(line=""):
        buf.append(line)
        print(line)

    # The rate-control run happens FIRST and is held back for printing, so the
    # log fetch below sees the session it started. Read in the obvious order,
    # this fetched the logs and then started a session — and so could never
    # report the one ffmpeg command most worth reading.
    rc_lines = []
    if args.ratecontrol:
        rc = rc_lines.append
        print("running the rate-control measurement…", file=sys.stderr)
        ratecontrol_section(rc, srv, args.ratecontrol, args.height,
                            args.seconds, args.window)

    st, logs = srv.call("/system/logs?level=debug&limit=2000")
    if not isinstance(logs, list):
        logs = []
    since_ms = int((time.time() - 7 * 24 * 60 * 60) * 1000)
    st, playback_events = srv.call(
        f"/system/playback-events?since={since_ms}&limit=2000")
    if st != 200 or not isinstance(playback_events, list):
        playback_events = None

    out("=" * 72)
    out(f"plurx perf report · {datetime.now(timezone.utc).isoformat(timespec='seconds')}")
    out(f"collected from {args.url} by {socket.gethostname()}")
    out("=" * 72)
    out("")
    out("-- node ------------------------------------------------------------")
    node_section(out, sys_info)
    out("")
    out("-- library shape (§5) ------------------------------------------------")
    shape_section(out, shape if isinstance(shape, dict) else None)
    out("")
    out("-- storage -----------------------------------------------------------")
    storage_section(out, sys_info, settings if isinstance(settings, dict) else {})
    out("")
    out("-- what ran, and what it cost --------------------------------------")
    log_section(out, logs, settings if isinstance(settings, dict) else {}, srv,
                playback_events)

    if rc_lines:
        out("")
        out("-- §4.6 bounded rate control ---------------------------------------")
        for line in rc_lines:
            out(line)

    out("")
    out("-- raw ---------------------------------------------------------------")
    out(json.dumps({"system": sys_info,
                    "settings": redact(settings if isinstance(settings, dict) else None)},
                   indent=2, sort_keys=True))

    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(buf) + "\n")
    print(f"\nwrote {path} — send that file back", file=sys.stderr)


if __name__ == "__main__":
    main()
