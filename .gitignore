/target
/fuzz/artifacts
/fuzz/target
/spikes/hiqlite-m0/target
/data
*.db
*.db-shm
*.db-wal
_to_delete/
.DS_Store
# Git bundles are a delivery/transfer artifact, not source — never commit them.
*.bundle
deploy/docker-compose.override.yml
deploy/.env

# The Apple project and Info.plists are generated from clients/apple/project.yml.
clients/apple/plurx.xcodeproj/
clients/apple/Support/
clients/apple/build/

# perf-report writes its output into the working directory, and the server
# checkouts are reset to the remote — an untracked report is the one thing in
# them worth keeping, so name it here rather than sweeping it by hand.
perf-report-*.txt
# Merge residue. A .orig sitting in a checkout means someone resolved a
# conflict there; git leaves them behind and nothing cleans them up.
*.orig
*.rej
# Python bytecode from the scripts/ tools. `scripts/gop-census` imports
# `scripts/perf-report` for its shared helpers, so running either one leaves a
# __pycache__ beside them — machine-specific, interpreter-version-specific, and
# regenerated on demand. Two of these were committed by a `git add -A` and rode
# along in bundles for a week before anyone looked.
__pycache__/
*.py[cod]
