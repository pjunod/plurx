/target
/data
*.db
*.db-shm
*.db-wal
_to_delete/
.DS_Store
# Git bundles are a delivery/transfer artifact, not source — never commit them.
*.bundle
deploy/docker-compose.override.yml
deploy/.env

# perf-report writes its output into the working directory, and the server
# checkouts are reset to the remote — an untracked report is the one thing in
# them worth keeping, so name it here rather than sweeping it by hand.
perf-report-*.txt
# Merge residue. A .orig sitting in a checkout means someone resolved a
# conflict there; git leaves them behind and nothing cleans them up.
*.orig
*.rej
